# Copy to /etc/relaycove/relaycove.env, replace the placeholder, then set mode 0600.
# This file is read by systemd; do not commit or place a real value in appsettings.
Authentication__SigningKey=REPLACE_WITH_BASE64_OF_AT_LEAST_32_RANDOM_BYTES

# First deployment only: uncomment all four lines, create the account, then remove
# the three credential lines and set Enabled=false before every later start.
# BootstrapAdmin__Enabled=true
# BootstrapAdmin__UserName=REPLACE_WITH_INITIAL_ADMIN_USERNAME
# BootstrapAdmin__DisplayName=REPLACE_WITH_INITIAL_ADMIN_DISPLAY_NAME
# BootstrapAdmin__Password=REPLACE_WITH_INITIAL_ADMIN_PASSWORD
