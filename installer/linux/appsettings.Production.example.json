{
  "ConnectionStrings": {
    "Default": "Data Source=/var/lib/relaycove/relaycove.db;Foreign Keys=True;Default Timeout=5"
  },
  "Storage": {
    "UploadsPath": "/var/lib/relaycove/uploads"
  },
  "RelayCove": {
    "PathBase": "",
    "WebAdmin": {
      "DataProtectionKeysPath": "/var/lib/relaycove/data-protection-keys"
    }
  },
  "Uploads": {
    "MaximumFileBytes": 104857600,
    "PermitLimit": 10,
    "RateLimitWindowSeconds": 60,
    "UnboundRetentionHours": 24
  },
  "Update": {
    "ManifestPath": "/var/lib/relaycove/updates/manifest.json"
  },
  "Authentication": {
    "Issuer": "RelayCove.Server",
    "Audience": "RelayCove.Client",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30,
    "ClockSkewSeconds": 30,
    "ServerVersion": "REPLACE_WITH_PACKAGE_VERSION",
    "MinimumSupportedClientVersion": "1.0.0",
    "LoginPermitLimit": 10,
    "RefreshPermitLimit": 60,
    "RateLimitWindowSeconds": 60
  },
  "BootstrapAdmin": {
    "Enabled": false
  },
  "AllowedHosts": "chat.example.com",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
