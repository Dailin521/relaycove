[Unit]
Description=RelayCove Server
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
User=relaycove
Group=relaycove
WorkingDirectory=/opt/relaycove/current/app
ExecStart=/opt/relaycove/current/app/RelayCove.Server
Environment=DOTNET_ENVIRONMENT=Production
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://127.0.0.1:5080
EnvironmentFile=/etc/relaycove/relaycove.env
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGTERM
UMask=0077
StateDirectory=relaycove
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
ReadWritePaths=/var/lib/relaycove
ReadOnlyPaths=/var/lib/relaycove/updates

[Install]
WantedBy=multi-user.target
