<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <AssemblyName>RelayCove.Preview.NativeTests</AssemblyName>
    <RootNamespace>RelayCove.Preview.NativeTests</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <MauiVersion>10.0.20</MauiVersion>
    <ApplicationTitle>Isolated preview regression</ApplicationTitle>
    <ApplicationId>com.relaycove.preview.nativetests</ApplicationId>
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <WindowsPackageType>None</WindowsPackageType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <AppBinaryDirectory Condition="'$(AppBinaryDirectory)' == ''">$(MSBuildThisFileDirectory)../../.verify/image-preview/Debug/net10.0-windows10.0.19041.0/win-x64</AppBinaryDirectory>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
    <Reference Include="RichChat"><HintPath>$(AppBinaryDirectory)/RichChat.dll</HintPath></Reference>
    <Reference Include="RelayCove.Core"><HintPath>$(AppBinaryDirectory)/RelayCove.Core.dll</HintPath></Reference>
  </ItemGroup>
</Project>
