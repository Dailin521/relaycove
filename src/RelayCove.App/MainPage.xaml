                                                   InputTransparent="True" />
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Grid IsVisible="{Binding IsReactionPickerOpen}">
