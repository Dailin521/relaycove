<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:RelayCove.App"
             xmlns:controls="clr-namespace:RelayCove.App.Controls"
             xmlns:windowsBehaviors="clr-namespace:RelayCove.App.Platforms.Windows.Behaviors"
             xmlns:viewModels="clr-namespace:RelayCove.App.ViewModels"
             x:Class="RelayCove.App.MainPage"
             x:Name="RootPage"
             x:DataType="viewModels:ShellViewModel"
             Style="{StaticResource RelayCovePageStyle}"
             Title="RelayCove"
             Shell.NavBarIsVisible="False">
    <Grid Background="{StaticResource GroundBrush}">
        <Grid
              IsVisible="{Binding LoginVisible}"
              Padding="24">
            <Border Padding="28"
                    MaximumWidthRequest="480"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Background="{StaticResource SurfaceBrush}"
                    Stroke="{StaticResource BorderBrush}"
                    StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="14">
                    <Label Text="登录 RelayCove"
                           Style="{StaticResource BaseLabelStyle}"
                           FontSize="24"
                           FontAttributes="Bold" />
                    <Label Text="使用 Zulip Realm 的邮箱和密码；密码仅用于交换 API Key。"
                           Style="{StaticResource MutedLabelStyle}"
                           LineBreakMode="WordWrap" />
                    <Entry Placeholder="Realm HTTPS origin"
                           Style="{StaticResource BaseEntryStyle}"
                           Text="{Binding Realm}"
                           Keyboard="Url"
                           SemanticProperties.Description="Zulip Realm HTTPS origin" />
                    <Entry Placeholder="邮箱"
                           Style="{StaticResource BaseEntryStyle}"
                           Text="{Binding Email}"
                           Keyboard="Email"
                           SemanticProperties.Description="Zulip 登录邮箱" />
                    <Entry Placeholder="密码"
                           Style="{StaticResource BaseEntryStyle}"
                           Text="{Binding Password}"
                           IsPassword="True"
                           ReturnType="Go"
                           ReturnCommand="{Binding LoginCommand}"
                           SemanticProperties.Description="Zulip 登录密码" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Button Text="登录"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding LoginCommand}" />
                        <Button Grid.Column="1"
                                Text="取消"
                                Style="{StaticResource BaseButtonStyle}"
                                Command="{Binding LoginCancelCommand}" />
                    </Grid>
                    <Label Text="{Binding LoginError}"
                           Style="{StaticResource DangerLabelStyle}"
                           LineBreakMode="WordWrap" />
                    <Label Text="Stage 21 的人工密码登录与干净 VM 门禁仍未验证。"
                           Style="{StaticResource MutedLabelStyle}"
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <Grid IsVisible="{Binding MainVisible}">
            <Grid>
                <Grid IsVisible="{Binding IsMessagesSection}">
                    <Grid IsEnabled="{Binding IsPrimaryShellEnabled}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding ConversationPaneWidth}" />
                            <ColumnDefinition Width="{Binding ChatPaneWidth}" />
                            <ColumnDefinition Width="{Binding InlineDetailsWidth}" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Padding="0"
                                IsVisible="{Binding IsConversationPaneVisible}"
                                Background="{StaticResource GroundBrush}"
                                Stroke="{StaticResource BorderBrush}"
                                StrokeThickness="1">
                            <controls:ConversationPaneView x:Name="ConversationPane" />
                        </Border>

                        <Grid Grid.Column="1"
                              IsVisible="{Binding IsChatPaneVisible}"
                              Background="{StaticResource SurfaceBrush}"
                              RowDefinitions="Auto,*,Auto">
                            <controls:ChatHeaderView x:Name="ChatHeader" Grid.Row="0" />
                            <controls:MessageListView Grid.Row="1" />
                            <controls:ComposerView Grid.Row="2" />
                        </Grid>

                        <Border Grid.Column="2"
                                IsVisible="{Binding IsInlineDetailsVisible}"
                                Background="{StaticResource SurfaceSoftBrush}"
                                Stroke="{StaticResource BorderBrush}"
                                StrokeThickness="1">
                            <controls:DetailsPaneView x:Name="InlineDetails" />
                        </Border>
                    </Grid>

                    <Grid IsVisible="{Binding IsOverlayDetailsVisible}">
                        <BoxView Background="{StaticResource OverlayBrush}">
                            <BoxView.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleDetailsCommand}" />
                            </BoxView.GestureRecognizers>
                        </BoxView>
                        <Border WidthRequest="284"
                                HorizontalOptions="End"
                                Background="{StaticResource SurfaceSoftBrush}"
                                Stroke="{StaticResource StrongBorderBrush}"
                                StrokeThickness="1">
                            <controls:DetailsPaneView x:Name="OverlayDetails"
                                                     IsModal="True" />
                        </Border>
                    </Grid>
                </Grid>

                <controls:SettingsPageView IsVisible="{Binding IsSettingsSection}" />

                <Grid IsVisible="{Binding IsAccountMenuOpen}">
                    <BoxView Background="Transparent">
                        <BoxView.GestureRecognizers><TapGestureRecognizer Command="{Binding CloseAccountMenuCommand}" /></BoxView.GestureRecognizers>
                    </BoxView>
                    <Border WidthRequest="220"
                            Margin="8,8,0,0"
                            Style="{StaticResource PopoverBorderStyle}"
                            HorizontalOptions="Start"
                            VerticalOptions="Start">
                        <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                        <VerticalStackLayout Spacing="4">
                            <Grid Margin="6,6,6,8" ColumnDefinitions="40,*" ColumnSpacing="10">
                                <Border WidthRequest="40" HeightRequest="40" Padding="0"
                                        Background="{StaticResource AccentBrush}" StrokeThickness="0">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                                    <Grid>
                                        <Label Text="{Binding CurrentUserInitial}" TextColor="White" FontAttributes="Bold"
                                               HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                        <controls:RealmMediaImageView SourceUrl="{Binding CurrentUserAvatarUrl}"
                                                                      MediaKind="Avatar" Aspect="AspectFill" ShowFailureText="False" />
                                    </Grid>
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                    <Label Text="{Binding CurrentUserDisplayName}" Style="{StaticResource BaseLabelStyle}" FontAttributes="Bold" />
                                    <Label Text="{Binding WorkspaceDisplayName}" Style="{StaticResource MutedLabelStyle}" />
                                </VerticalStackLayout>
                            </Grid>
                            <BoxView HeightRequest="1" Background="{StaticResource BorderBrush}" />
                            <Button x:Name="FirstAccountMenuButton" Text="账户设置" ImageSource="icon_settings.png" Style="{StaticResource PopoverMenuButtonStyle}" Command="{Binding ShowSettingsCommand}">
                                <Button.Behaviors><windowsBehaviors:LeftAlignedButtonContentBehavior /></Button.Behaviors>
                            </Button>
                            <Button x:Name="LastAccountMenuButton" Text="注销" ImageSource="icon_close.png" Style="{StaticResource PopoverMenuButtonStyle}" Command="{Binding RequestLogoutCommand}">
                                <Button.Behaviors><windowsBehaviors:LeftAlignedButtonContentBehavior /></Button.Behaviors>
                            </Button>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Grid IsVisible="{Binding IsSearchOpen}">
                    <BoxView Background="{StaticResource OverlayBrush}">
                        <BoxView.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CloseSearchCommand}" />
                        </BoxView.GestureRecognizers>
                    </BoxView>
                    <Border Style="{StaticResource DialogBorderStyle}"
                            VerticalOptions="Start"
                            Margin="24,54,24,24">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10" MaximumHeightRequest="620">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout>
                                    <Label Text="搜索" Style="{StaticResource BaseLabelStyle}" FontSize="18" FontAttributes="Bold" />
                                    <Label Text="当前会话、联系人和已加载消息" Style="{StaticResource MutedLabelStyle}" />
                                </VerticalStackLayout>
                                <Button Grid.Column="1" Text="×" Style="{StaticResource IconButtonStyle}" Command="{Binding CloseSearchCommand}" />
                            </Grid>
                            <Entry Grid.Row="1"
                                   x:Name="SearchEntry"
                                   Style="{StaticResource BaseEntryStyle}"
                                   Text="{Binding SearchQuery, Mode=TwoWay}"
                                   Completed="OnSearchCompleted"
                                   Placeholder="键入以搜索"
                                   SemanticProperties.Description="搜索当前会话、联系人和已加载消息" />
                            <Grid Grid.Row="2">
                                <CollectionView ItemsSource="{Binding SearchResults}"
                                                SelectedItem="{Binding SelectedSearchResult, Mode=TwoWay}"
                                                SelectionMode="Single"
                                                ItemsUpdatingScrollMode="KeepItemsInView">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="viewModels:SearchResultItem">
                                            <Border Padding="10,8" StrokeThickness="0">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding ViewModel.SelectSearchResultCommand, Source={x:Reference RootPage}, x:DataType=local:MainPage}" CommandParameter="{Binding .}" />
                                                </Border.GestureRecognizers>
                                                <Grid ColumnDefinitions="90,*" RowDefinitions="Auto,Auto">
                                                    <Label Text="{Binding Kind}" Style="{StaticResource MutedLabelStyle}" />
                                                    <Label Grid.Column="1" Text="{Binding Title}" Style="{StaticResource BaseLabelStyle}" FontAttributes="Bold" />
                                                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding Subtitle}" Style="{StaticResource MutedLabelStyle}" LineBreakMode="TailTruncation" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                    <CollectionView.Footer>
                                        <Button Text="加载更多服务器结果"
                                                IsVisible="{Binding ViewModel.HasMoreSearchResults, Source={x:Reference RootPage}, x:DataType=local:MainPage}"
                                                Command="{Binding ViewModel.LoadOlderSearchCommand, Source={x:Reference RootPage}, x:DataType=local:MainPage}"
                                                Style="{StaticResource BaseButtonStyle}" />
                                    </CollectionView.Footer>
                                </CollectionView>
                                <Label Text="没有匹配结果。"
                                       IsVisible="{Binding IsSearchEmpty}"
                                       Style="{StaticResource MutedLabelStyle}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="End" Spacing="4">
                                    <Label Text="正在搜索服务器…" IsVisible="{Binding IsSearchBusy}" Style="{StaticResource MutedLabelStyle}" />
                                    <Label Text="{Binding SearchError}" IsVisible="{Binding HasSearchError}" Style="{StaticResource MutedLabelStyle}" />
                                </VerticalStackLayout>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <Grid IsVisible="{Binding IsNewConversationOpen}">
                    <BoxView Background="{StaticResource OverlayBrush}">
                        <BoxView.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CloseNewConversationCommand}" />
                        </BoxView.GestureRecognizers>
                    </BoxView>
                    <Border Style="{StaticResource DialogBorderStyle}" MaximumWidthRequest="560">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                        <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                <VerticalStackLayout>
                                    <Label Text="发起私聊" IsVisible="{Binding IsNewDirectConversationMode}" Style="{StaticResource BaseLabelStyle}" FontSize="18" FontAttributes="Bold" />
                                    <Label Text="新建群聊" IsVisible="{Binding IsNewChannelConversationMode}" Style="{StaticResource BaseLabelStyle}" FontSize="18" FontAttributes="Bold" />
                                    <Label Text="仅列出 IClientSession 当前可靠获知的活跃用户；不代表完整成员目录或 presence。"
                                           IsVisible="{Binding IsNewDirectConversationMode}"
                                           Style="{StaticResource MutedLabelStyle}"
                                           LineBreakMode="WordWrap" />
                                    <Label Text="填写群名并至少选择两名其他成员。群聊始终是私有且不显示话题。"
                                           IsVisible="{Binding IsNewChannelConversationMode}"
                                           Style="{StaticResource MutedLabelStyle}" />
                                    <HorizontalStackLayout Spacing="7" Margin="0,7,0,0" IsVisible="{Binding IsNewConversationModeSwitcherVisible}">
                                        <Button Text="发起私聊" Style="{StaticResource BaseButtonStyle}" Command="{Binding ShowNewDirectConversationCommand}" />
                                        <Button Text="新建群聊" Style="{StaticResource BaseButtonStyle}" Command="{Binding ShowNewChannelConversationCommand}" IsEnabled="{Binding CanCreatePrivateGroup}" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                                <Button Grid.Column="1"
                                        Text="×"
                                        Style="{StaticResource IconButtonStyle}"
                                        Command="{Binding CloseNewConversationCommand}" />
                            </Grid>
                            <Grid Grid.Row="1"
                                  RowDefinitions="Auto,Auto"
                                  RowSpacing="8">
                                <Entry x:Name="NewConversationSearchEntry"
                                       Grid.Row="0"
                                       Text="{Binding NewConversationQuery, Mode=TwoWay}"
                                       Placeholder="筛选已知联系人"
                                       Style="{StaticResource BaseEntryStyle}" />
                                <Entry x:Name="NewPrivateGroupNameEntry"
                                       Grid.Row="1"
                                       IsVisible="{Binding IsNewChannelConversationMode}"
                                       Text="{Binding NewPrivateGroupName, Mode=TwoWay}"
                                       Placeholder="群聊名称"
                                       Style="{StaticResource BaseEntryStyle}" />
                            </Grid>
                            <Grid Grid.Row="2"
                                  IsVisible="{Binding IsNewConversationModeSwitcherVisible}"
                                  MinimumHeightRequest="180"
                                  MaximumHeightRequest="330">
                                <CollectionView ItemsSource="{Binding NewConversationChoices}"
                                                SelectionMode="None"
                                                IsVisible="{Binding IsNewConversationChoicesVisible}">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="viewModels:ConversationContactChoice">
                                            <Border Margin="0,0,0,6" Padding="9,6" StrokeThickness="0">
                                                <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="9">
                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                              SemanticProperties.Description="{Binding Name, StringFormat='选择 {0}'}" />
                                                    <Border Grid.Column="1"
                                                            WidthRequest="32"
                                                            HeightRequest="32"
                                                            Padding="0"
                                                            Background="{StaticResource SurfaceSelectedBrush}"
                                                            StrokeThickness="0">
                                                        <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                                                        <Grid>
                                                            <Label Text="{Binding Initial}"
                                                                   Style="{StaticResource MutedLabelStyle}"
                                                                   FontSize="9"
                                                                   FontAttributes="Bold"
                                                                   HorizontalTextAlignment="Center"
                                                                   VerticalTextAlignment="Center" />
                                                            <controls:RealmMediaImageView SourceUrl="{Binding AvatarUrl}"
                                                                                          MediaKind="Avatar"
                                                                                          Aspect="AspectFill"
                                                                                          ShowFailureText="False" />
                                                        </Grid>
                                                    </Border>
                                                    <VerticalStackLayout Grid.Column="2" VerticalOptions="Center">
                                                        <Label Text="{Binding Name}" Style="{StaticResource BaseLabelStyle}" FontAttributes="Bold" />
                                                        <Label Text="{Binding KindLabel}" Style="{StaticResource MutedLabelStyle}" />
                                                    </VerticalStackLayout>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                                <Label Text="没有匹配的已知联系人。"
                                       IsVisible="{Binding IsNewConversationChoiceEmptyVisible}"
                                       Style="{StaticResource MutedLabelStyle}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                                <Label Text="{Binding PrivateGroupCreateDisabledReason}"
                                       IsVisible="{Binding ShowPrivateGroupCreateDisabledReason}"
                                       Style="{StaticResource MutedLabelStyle}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="End" />
                                <Label Text="{Binding NewConversationError}"
                                       IsVisible="{Binding HasNewConversationError}"
                                       Style="{StaticResource DangerLabelStyle}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Start"
                                       LineBreakMode="WordWrap" />
                            </Grid>
                            <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                                <Button Text="给自己发私信"
                                        IsVisible="{Binding IsNewDirectConversationMode}"
                                        Style="{StaticResource BaseButtonStyle}"
                                        Command="{Binding StartSelfConversationCommand}" />
                                <Button Grid.Column="2"
                                        Text="取消"
                                        Style="{StaticResource BaseButtonStyle}"
                                        Command="{Binding CloseNewConversationCommand}" />
                                <Button Grid.Column="3"
                                        Text="开始私聊"
                                        IsVisible="{Binding IsNewDirectConversationMode}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        IsEnabled="{Binding CanStartNewConversation}"
                                        Command="{Binding StartNewConversationCommand}" />
                                <Button Grid.Column="3"
                                        Text="创建群聊"
                                        IsVisible="{Binding IsNewChannelConversationMode}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        IsEnabled="{Binding CanStartNewChannelConversation}"
                                        Command="{Binding StartNewChannelConversationCommand}" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <controls:ChannelSettingsOverlayView x:Name="ChannelSettingsOverlay"
                                                     BindingContext="{Binding ChannelSettings}" />

                <Grid IsVisible="{Binding IsComposerEmojiPickerOpen}">
                    <BoxView BackgroundColor="Transparent">
                        <BoxView.GestureRecognizers><TapGestureRecognizer Command="{Binding ToggleComposerEmojiPickerCommand}" /></BoxView.GestureRecognizers>
                    </BoxView>
                    <Border Style="{StaticResource PopoverBorderStyle}"
                            Padding="8"
                            WidthRequest="310"
                            MinimumWidthRequest="310"
                            MaximumWidthRequest="310"
                            HorizontalOptions="Start"
                            VerticalOptions="Start">
                        <Border.StrokeShape><RoundRectangle CornerRadius="11" /></Border.StrokeShape>
                        <Border.Behaviors>
                            <windowsBehaviors:PopoverAnchorBehavior
                                AnchorX="{Binding ViewModel.ComposerEmojiAnchorX, Source={x:Reference RootPage}, x:DataType=local:MainPage}"
                                AnchorY="{Binding ViewModel.ComposerEmojiAnchorY, Source={x:Reference RootPage}, x:DataType=local:MainPage}" />
                        </Border.Behaviors>
                        <VerticalStackLayout Spacing="0">
                            <Grid Padding="3,2,3,8" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Label Text="表情" Style="{StaticResource BaseLabelStyle}" FontSize="13" FontAttributes="Bold" />
                                <Label Grid.Column="1" Text="选择后插入光标位置" Style="{StaticResource MutedLabelStyle}" FontSize="10" HorizontalTextAlignment="End" VerticalTextAlignment="Center" />
                            </Grid>
                            <CollectionView x:Name="ComposerEmojiCollection"
                                            ItemsSource="{Binding EmojiChoices}"
                                            SelectionMode="None"
                                            WidthRequest="284"
                                            HeightRequest="205"
                                            HorizontalOptions="Start">
                                <CollectionView.ItemsLayout>
                                    <GridItemsLayout Orientation="Vertical" Span="6" HorizontalItemSpacing="3" VerticalItemSpacing="3" />
                                </CollectionView.ItemsLayout>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:EmojiChoice">
                                        <Grid Margin="1"
                                              BackgroundColor="Transparent"
                                              SemanticProperties.Description="{Binding AccessibleLabel}">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding ViewModel.InsertComposerEmojiCommand, Source={x:Reference RootPage}, x:DataType=local:MainPage}"
                                                    CommandParameter="{Binding .}" />
                                                <PointerGestureRecognizer
                                                    PointerEntered="OnEmojiPointerEntered"
                                                    PointerExited="OnEmojiPointerExited" />
                                            </Grid.GestureRecognizers>
                                            <Border InputTransparent="True"
                                                    WidthRequest="40"
                                                    HeightRequest="38"
                                                    HorizontalOptions="Center"
                                                    VerticalOptions="Center"
                                                    Stroke="Transparent"
                                                    StrokeThickness="2">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="7" />
                                                </Border.StrokeShape>
                                                <Border.Triggers>
                                                    <DataTrigger TargetType="Border" Binding="{Binding IsPointerOver}" Value="True">
                                                        <Setter Property="Stroke" Value="{StaticResource AccentBrush}" />
                                                        <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Border" Binding="{Binding IsComposerSelected}" Value="True">
                                                        <Setter Property="Stroke" Value="{StaticResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Border.Triggers>
                                            </Border>
                                            <Label Text="{Binding Emoji}"
                                                   FontSize="20"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"
                                                   HorizontalTextAlignment="Center"
                                                   VerticalTextAlignment="Center"
                                                   InputTransparent="True" />
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Grid IsVisible="{Binding IsReactionPickerOpen}">
                    <BoxView BackgroundColor="Transparent">
                        <BoxView.GestureRecognizers><TapGestureRecognizer Command="{Binding CloseReactionPickerCommand}" /></BoxView.GestureRecognizers>
                    </BoxView>
                    <Border Style="{StaticResource PopoverBorderStyle}"
                            Padding="8"
                            WidthRequest="310"
                            MinimumWidthRequest="310"
                            MaximumWidthRequest="310"
                            HorizontalOptions="Start"
                            VerticalOptions="Start">
                        <Border.StrokeShape><RoundRectangle CornerRadius="11" /></Border.StrokeShape>
                        <Border.Behaviors>
                            <windowsBehaviors:PopoverAnchorBehavior
                                AnchorX="{Binding ViewModel.MessageMenuAnchorX, Source={x:Reference RootPage}, x:DataType=local:MainPage}"
                                AnchorY="{Binding ViewModel.MessageMenuAnchorY, Source={x:Reference RootPage}, x:DataType=local:MainPage}" />
                        </Border.Behaviors>
                        <VerticalStackLayout Spacing="0">
                            <Grid Padding="3,2,3,8" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Label Text="添加反应" Style="{StaticResource BaseLabelStyle}" FontSize="13" FontAttributes="Bold" />
                                <Label Grid.Column="1" Text="再次选择可移除" Style="{StaticResource MutedLabelStyle}" FontSize="10" HorizontalTextAlignment="End" VerticalTextAlignment="Center" />
                            </Grid>
                            <CollectionView x:Name="ReactionEmojiCollection"
                                            ItemsSource="{Binding EmojiChoices}"
                                            SelectionMode="None"
                                            WidthRequest="284"
                                            HeightRequest="205"
                                            HorizontalOptions="Start">
                                <CollectionView.ItemsLayout>
                                    <GridItemsLayout Orientation="Vertical" Span="6" HorizontalItemSpacing="3" VerticalItemSpacing="3" />
                                </CollectionView.ItemsLayout>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:EmojiChoice">
                                        <Grid Margin="1"
                                              BackgroundColor="Transparent"
                                              SemanticProperties.Description="{Binding AccessibleLabel}">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding ViewModel.SelectReactionEmojiCommand, Source={x:Reference RootPage}, x:DataType=local:MainPage}"
                                                    CommandParameter="{Binding .}" />
                                                <PointerGestureRecognizer
                                                    PointerEntered="OnEmojiPointerEntered"
                                                    PointerExited="OnEmojiPointerExited" />
                                            </Grid.GestureRecognizers>
                                            <Border InputTransparent="True"
                                                    WidthRequest="40"
                                                    HeightRequest="38"
                                                    HorizontalOptions="Center"
                                                    VerticalOptions="Center"
                                                    Stroke="Transparent"
                                                    StrokeThickness="2">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="7" />
                                                </Border.StrokeShape>
                                                <Border.Triggers>
                                                    <DataTrigger TargetType="Border" Binding="{Binding IsPointerOver}" Value="True">
                                                        <Setter Property="Stroke" Value="{StaticResource AccentBrush}" />
                                                        <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Border" Binding="{Binding IsReactionSelected}" Value="True">
                                                        <Setter Property="Stroke" Value="{StaticResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Border.Triggers>
                                            </Border>
                                            <Label Text="{Binding Emoji}"
                                                   FontSize="20"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"
                                                   HorizontalTextAlignment="Center"
                                                   VerticalTextAlignment="Center"
                                                   InputTransparent="True" />
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Grid IsVisible="{Binding IsImageViewerOpen}">
                    <BoxView Background="{StaticResource OverlayBrush}">
                        <BoxView.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CloseImageViewerCommand}" />
                        </BoxView.GestureRecognizers>
                    </BoxView>
                    <Border Margin="28"
                            Padding="14"
                            MaximumWidthRequest="1120"
                            MaximumHeightRequest="760"
                            HorizontalOptions="Fill"
                            VerticalOptions="Fill"
                            Background="{StaticResource SurfaceRaisedBrush}"
                            Stroke="{StaticResource StrongBorderBrush}"
                            StrokeThickness="1">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <VerticalStackLayout>
                                    <Label Text="图片预览" Style="{StaticResource BaseLabelStyle}" FontSize="18" FontAttributes="Bold" />
                                    <Label Text="{Binding ActiveImageAttachment.Name}" Style="{StaticResource MutedLabelStyle}" />
                                </VerticalStackLayout>
                                <Button x:Name="ImageViewerCloseButton"
                                        Grid.Column="1"
                                        Text="×"
                                        Style="{StaticResource IconButtonStyle}"
                                        Command="{Binding CloseImageViewerCommand}"
                                        SemanticProperties.Description="关闭图片预览" />
                            </Grid>
                            <Border Grid.Row="1"
                                    Padding="0"
                                    Background="{StaticResource GroundBrush}"
                                    Stroke="{StaticResource BorderBrush}"
                                    StrokeThickness="1">
                                <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                <controls:RealmMediaImageView SourceUrl="{Binding ActiveImageAttachment.SourceUrl}"
                                                              Aspect="AspectFit" />
                            </Border>
                            <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <Label Text="{Binding MediaActionStatus}"
                                       IsVisible="{Binding HasMediaActionStatus}"
                                       Style="{StaticResource MutedLabelStyle}"
                                       VerticalTextAlignment="Center" />
                                <ActivityIndicator Grid.Column="1"
                                                   IsVisible="{Binding IsMediaActionBusy}"
                                                   IsRunning="{Binding IsMediaActionBusy}"
                                                   WidthRequest="24" />
                                <Button Grid.Column="2"
                                        Text="下载原文件"
                                        Style="{StaticResource BaseButtonStyle}"
                                        Command="{Binding DownloadAttachmentCommand}"
                                        CommandParameter="{Binding ActiveImageAttachment}" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <Grid IsVisible="{Binding IsMessageMenuOpen}">
                    <BoxView BackgroundColor="Transparent">
                        <BoxView.GestureRecognizers><TapGestureRecognizer Command="{Binding CloseMessageMenuCommand}" /></BoxView.GestureRecognizers>
                    </BoxView>
                    <Border Style="{StaticResource PopoverBorderStyle}"
                            MinimumWidthRequest="0"
                            WidthRequest="214"
                            MaximumWidthRequest="214"
                            HorizontalOptions="Start"
                            VerticalOptions="Start"
                            Margin="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                        <Border.Behaviors>
                            <windowsBehaviors:PopoverAnchorBehavior
                                AnchorX="{Binding ViewModel.MessageMenuAnchorX, Source={x:Reference RootPage}, x:DataType=local:MainPage}"
                                AnchorY="{Binding ViewModel.MessageMenuAnchorY, Source={x:Reference RootPage}, x:DataType=local:MainPage}" />
                        </Border.Behaviors>
                        <VerticalStackLayout Spacing="4">
                            <Button x:Name="FirstMessageMenuButton" Text="添加表情反应" ImageSource="icon_smile.png" Style="{StaticResource PopoverMenuButtonStyle}" Command="{Binding OpenReactionPickerCommand}">
                                <Button.Behaviors><windowsBehaviors:LeftAlignedButtonContentBehavior /></Button.Behaviors>
                            </Button>
                            <Button Text="{Binding ActiveMessageStarActionLabel}" ImageSource="icon_star.png" Style="{StaticResource PopoverMenuButtonStyle}" Command="{Binding ToggleMessageStarCommand}" IsEnabled="{Binding CanStarActiveMessage}">
                                <Button.Behaviors><windowsBehaviors:LeftAlignedButtonContentBehavior /></Button.Behaviors>
                            </Button>
                            <Button Text="引用回复" ImageSource="icon_quote.png" Style="{StaticResource PopoverMenuButtonStyle}" Command="{Binding QuoteMessageCommand}">
                                <Button.Behaviors><windowsBehaviors:LeftAlignedButtonContentBehavior /></Button.Behaviors>
                            </Button>
                            <Button Text="编辑消息" ImageSource="icon_edit.png" Style="{StaticResource PopoverMenuButtonStyle}" Command="{Binding OpenEditDialogCommand}" IsVisible="{Binding CanEditActiveMessage}">
                                <Button.Behaviors><windowsBehaviors:LeftAlignedButtonContentBehavior /></Button.Behaviors>
                            </Button>
                            <Button Text="删除消息" ImageSource="icon_close.png" Style="{StaticResource PopoverMenuButtonStyle}" Command="{Binding RequestDeleteMessageCommand}" IsVisible="{Binding CanDeleteActiveMessage}" TextColor="{StaticResource DangerColor}">
                                <Button.Behaviors><windowsBehaviors:LeftAlignedButtonContentBehavior /></Button.Behaviors>
                            </Button>
                            <Button Text="复制消息正文" ImageSource="icon_copy.png" Style="{StaticResource PopoverMenuButtonStyle}" Command="{Binding CopyMessageRawCommand}">
                                <Button.Behaviors><windowsBehaviors:LeftAlignedButtonContentBehavior /></Button.Behaviors>
                            </Button>
                            <Button Text="复制消息链接" ImageSource="icon_copy.png" Style="{StaticResource PopoverMenuButtonStyle}" Command="{Binding CopyMessageLinkCommand}">
                                <Button.Behaviors><windowsBehaviors:LeftAlignedButtonContentBehavior /></Button.Behaviors>
                            </Button>
                            <Button Text="复制消息 ID" ImageSource="icon_info.png" Style="{StaticResource PopoverMenuButtonStyle}" Command="{Binding CopyMessageIdCommand}">
                                <Button.Behaviors><windowsBehaviors:LeftAlignedButtonContentBehavior /></Button.Behaviors>
                            </Button>
                            <Button x:Name="LastMessageMenuButton" Text="在 Zulip 中打开" ImageSource="icon_messages.png" Style="{StaticResource PopoverMenuButtonStyle}" Command="{Binding OpenMessageInZulipCommand}">
                                <Button.Behaviors><windowsBehaviors:LeftAlignedButtonContentBehavior /></Button.Behaviors>
                            </Button>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Grid IsVisible="{Binding IsChannelMenuOpen}">
                    <BoxView BackgroundColor="Transparent">
                        <BoxView.GestureRecognizers><TapGestureRecognizer Command="{Binding CloseChannelMenuCommand}" /></BoxView.GestureRecognizers>
                    </BoxView>
                    <Border Style="{StaticResource PopoverBorderStyle}"
                            MinimumWidthRequest="0"
                            WidthRequest="246"
                            MaximumWidthRequest="246"
                            HorizontalOptions="Start"
                            VerticalOptions="Start"
                            Margin="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                        <Border.Behaviors>
                            <windowsBehaviors:PopoverAnchorBehavior
                                AnchorX="{Binding ViewModel.ChannelMenuAnchorX, Source={x:Reference RootPage}, x:DataType=local:MainPage}"
                                AnchorY="{Binding ViewModel.ChannelMenuAnchorY, Source={x:Reference RootPage}, x:DataType=local:MainPage}" />
                        </Border.Behaviors>
                        <VerticalStackLayout Spacing="4">
                            <Grid ColumnDefinitions="24,*" Margin="9,4,9,5">
                                <Label Text="#" TextColor="{Binding ActiveChannelAction.ToneColor}" FontSize="21" FontAttributes="Bold"
                                       VerticalTextAlignment="Center" HorizontalTextAlignment="Center" />
                                <Label Grid.Column="1" Text="{Binding ActiveChannelAction.Name}"
                                       Style="{StaticResource BaseLabelStyle}"
                                       FontAttributes="Bold"
                                       VerticalTextAlignment="Center"
                                       LineBreakMode="TailTruncation" />
                            </Grid>
                            <BoxView HeightRequest="1" Background="{StaticResource BorderBrush}" />
                            <Button x:Name="FirstChannelMenuButton" Text="{Binding ActiveChannelMarkReadLabel}" ImageSource="icon_bookmark.png" Style="{StaticResource PopoverMenuButtonStyle}"
                                    Command="{Binding ExplainActiveChannelFeatureCommand}" CommandParameter="频道级标记已读/未读">
                                <Button.Behaviors><windowsBehaviors:LeftAlignedButtonContentBehavior /></Button.Behaviors>
                            </Button>
                            <Button Text="前往频道订阅" ImageSource="icon_messages.png" Style="{StaticResource PopoverMenuButtonStyle}"
                                    Command="{Binding ExplainActiveChannelFeatureCommand}" CommandParameter="频道订阅页面">
                                <Button.Behaviors><windowsBehaviors:LeftAlignedButtonContentBehavior /></Button.Behaviors>
                            </Button>
                            <Button Text="前往话题列表" ImageSource="icon_messages.png" Style="{StaticResource PopoverMenuButtonStyle}"
                                    Command="{Binding OpenActiveChannelTopicListCommand}">
                                <Button.Behaviors><windowsBehaviors:LeftAlignedButtonContentBehavior /></Button.Behaviors>
                            </Button>
                            <Button Text="将链接复制到频道" ImageSource="icon_copy.png" Style="{StaticResource PopoverMenuButtonStyle}"
                                    Command="{Binding CopyActiveChannelLinkCommand}">
                                <Button.Behaviors><windowsBehaviors:LeftAlignedButtonContentBehavior /></Button.Behaviors>
                            </Button>
                            <BoxView HeightRequest="1" Background="{StaticResource BorderBrush}" />
                            <Button Text="频道设置" ImageSource="icon_settings.png" Style="{StaticResource PopoverMenuButtonStyle}"
                                    Command="{Binding OpenActiveChannelSettingsCommand}">
                                <Button.Behaviors><windowsBehaviors:LeftAlignedButtonContentBehavior /></Button.Behaviors>
                            </Button>
                            <Button Text="{Binding ActiveChannelPinLabel}" ImageSource="icon_pin.png" Style="{StaticResource PopoverMenuButtonStyle}"
                                    Command="{Binding ToggleActiveChannelPinnedCommand}" IsEnabled="{Binding CanManageActiveChannel}">
                                <Button.Behaviors><windowsBehaviors:LeftAlignedButtonContentBehavior /></Button.Behaviors>
                            </Button>
                            <Button Text="{Binding ActiveChannelMuteLabel}" ImageSource="icon_moon.png" Style="{StaticResource PopoverMenuButtonStyle}"
                                    Command="{Binding ToggleActiveChannelMutedCommand}" IsEnabled="{Binding CanManageActiveChannel}">
                                <Button.Behaviors><windowsBehaviors:LeftAlignedButtonContentBehavior /></Button.Behaviors>
                            </Button>
                            <Button Text="退出频道" ImageSource="icon_close.png" Style="{StaticResource PopoverMenuButtonStyle}"
                                    Command="{Binding RequestActiveChannelUnsubscribeCommand}" IsEnabled="{Binding CanManageActiveChannel}" TextColor="{StaticResource DangerColor}">
                                <Button.Behaviors><windowsBehaviors:LeftAlignedButtonContentBehavior /></Button.Behaviors>
                            </Button>
                            <BoxView HeightRequest="1" Background="{StaticResource BorderBrush}" />
                            <Button x:Name="LastChannelMenuButton" Text="修改颜色" ImageSource="icon_star.png" Style="{StaticResource PopoverMenuButtonStyle}"
                                    Command="{Binding ExplainActiveChannelFeatureCommand}" CommandParameter="频道颜色修改">
                                <Button.Behaviors><windowsBehaviors:LeftAlignedButtonContentBehavior /></Button.Behaviors>
                            </Button>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Grid IsVisible="{Binding IsTopicMenuOpen}">
                    <BoxView BackgroundColor="Transparent"><BoxView.GestureRecognizers><TapGestureRecognizer Command="{Binding CloseTopicMenuCommand}" /></BoxView.GestureRecognizers></BoxView>
                    <Border Style="{StaticResource PopoverBorderStyle}" WidthRequest="238" HorizontalOptions="Start" VerticalOptions="Start">
                        <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                        <Border.Behaviors><windowsBehaviors:PopoverAnchorBehavior AnchorX="{Binding ViewModel.TopicMenuAnchorX, Source={x:Reference RootPage}, x:DataType=local:MainPage}" AnchorY="{Binding ViewModel.TopicMenuAnchorY, Source={x:Reference RootPage}, x:DataType=local:MainPage}" /></Border.Behaviors>
                        <VerticalStackLayout Spacing="4">
                            <Grid ColumnDefinitions="24,*" Margin="9,4,9,5"><Label Text="{Binding ActiveTopicAction.VisibilityGlyph}" FontSize="17" VerticalTextAlignment="Center" HorizontalTextAlignment="Center" /><Label Grid.Column="1" Text="{Binding ActiveTopicAction.DisplayName}" Style="{StaticResource BaseLabelStyle}" FontAttributes="Bold" VerticalTextAlignment="Center" LineBreakMode="TailTruncation" /></Grid>
                            <VerticalStackLayout Spacing="4" IsVisible="{Binding CanSetActiveTopicVisibility}">
                                <BoxView HeightRequest="1" Background="{StaticResource BorderBrush}" />
                                <FlexLayout Margin="8,0" Direction="Row" AlignItems="Stretch" JustifyContent="SpaceBetween">
                                    <Button x:Name="FirstTopicMenuButton" Text="🔕" FlexLayout.Grow="1" Margin="0,0,2,0" Style="{StaticResource BaseButtonStyle}" Command="{Binding SetActiveTopicVisibilityPolicyCommand}" CommandParameter="Muted" SemanticProperties.Description="静音话题"><Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding IsActiveTopicMutedPolicy}" Value="True"><Setter Property="Background" Value="{StaticResource SurfaceSelectedBrush}" /></DataTrigger></Button.Triggers></Button>
                                    <Button Text="○" FlexLayout.Grow="1" Margin="2,0" Style="{StaticResource BaseButtonStyle}" Command="{Binding SetActiveTopicVisibilityPolicyCommand}" CommandParameter="None" SemanticProperties.Description="继承频道设置"><Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding IsActiveTopicInheritPolicy}" Value="True"><Setter Property="Background" Value="{StaticResource SurfaceSelectedBrush}" /></DataTrigger></Button.Triggers></Button>
                                    <Button Text="🔔" IsVisible="{Binding ShowActiveTopicUnmutedPolicy}" FlexLayout.Grow="1" Margin="2,0" Style="{StaticResource BaseButtonStyle}" Command="{Binding SetActiveTopicVisibilityPolicyCommand}" CommandParameter="Unmuted" SemanticProperties.Description="取消静音话题"><Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding IsActiveTopicUnmutedPolicy}" Value="True"><Setter Property="Background" Value="{StaticResource SurfaceSelectedBrush}" /></DataTrigger></Button.Triggers></Button>
                                    <Button Text="★" FlexLayout.Grow="1" Margin="2,0,0,0" Style="{StaticResource BaseButtonStyle}" Command="{Binding SetActiveTopicVisibilityPolicyCommand}" CommandParameter="Followed" SemanticProperties.Description="关注话题"><Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding IsActiveTopicFollowedPolicy}" Value="True"><Setter Property="Background" Value="{StaticResource SurfaceSelectedBrush}" /></DataTrigger></Button.Triggers></Button>
                                </FlexLayout>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="4" IsVisible="{Binding ActiveTopicHasMessages}">
                                <BoxView HeightRequest="1" Background="{StaticResource BorderBrush}" />
                                <Button Text="标记整话题为已读" Style="{StaticResource PopoverMenuButtonStyle}" Command="{Binding MarkActiveTopicReadCommand}" IsEnabled="{Binding CanMarkActiveTopicRead}" />
                                <Button Text="复制话题链接" Style="{StaticResource PopoverMenuButtonStyle}" Command="{Binding CopyActiveTopicLinkCommand}" />
                            </VerticalStackLayout>
                            <Label Text="此话题中还没有消息。" IsVisible="{Binding ActiveTopicIsEmpty}" Style="{StaticResource MutedLabelStyle}" FontAttributes="Italic" Margin="9,5" />
                            <VerticalStackLayout Spacing="4" IsVisible="{Binding CanAdministerActiveTopicOperations}">
                                <BoxView HeightRequest="1" Background="{StaticResource BorderBrush}" />
                                <Button Text="移动话题" Style="{StaticResource PopoverMenuButtonStyle}" Command="{Binding OpenTopicMoveDialogCommand}" IsEnabled="{Binding CanMoveActiveTopic}" />
                                <Button Text="{Binding ActiveTopicAction.ResolutionLabel}" IsVisible="{Binding CanResolveActiveTopic}" Style="{StaticResource PopoverMenuButtonStyle}" Command="{Binding RequestActiveTopicResolutionCommand}" />
                                <Button Text="删除话题" Style="{StaticResource PopoverMenuButtonStyle}" TextColor="{StaticResource DangerColor}" Command="{Binding RequestTopicDeleteCommand}" IsEnabled="{Binding CanDeleteActiveTopic}" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Grid IsVisible="{Binding IsEditDialogOpen}">
                    <BoxView Background="{StaticResource OverlayBrush}" />
                    <Border Style="{StaticResource DialogBorderStyle}">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                        <VerticalStackLayout Spacing="12">
                            <Label Text="编辑消息" Style="{StaticResource BaseLabelStyle}" FontSize="18" FontAttributes="Bold" />
                            <Label Text="使用原始 Markdown；提交时会携带当前正文 SHA-256 防止覆盖并发编辑。" Style="{StaticResource MutedLabelStyle}" LineBreakMode="WordWrap" />
                            <Editor x:Name="EditMessageEditor" Text="{Binding EditMessageText, Mode=TwoWay}" Style="{StaticResource ComposerEditorStyle}" HeightRequest="180" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Button Text="取消" Style="{StaticResource BaseButtonStyle}" Command="{Binding CancelEditDialogCommand}" />
                                <Button Grid.Column="1" Text="保存更改" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ConfirmEditMessageCommand}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Grid IsVisible="{Binding IsDeleteConfirmationOpen}">
                    <BoxView Background="{StaticResource OverlayBrush}" />
                    <Border Style="{StaticResource DialogBorderStyle}" Stroke="{StaticResource DangerColor}">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                        <VerticalStackLayout Spacing="12">
                            <Label Text="永久删除消息？" Style="{StaticResource DangerLabelStyle}" FontSize="18" FontAttributes="Bold" />
                            <Label Text="此操作不可撤销。若网络结果未知，RelayCove 不会自动重试删除。" Style="{StaticResource BaseLabelStyle}" LineBreakMode="WordWrap" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Button x:Name="DeleteCancelButton" Text="取消" Style="{StaticResource BaseButtonStyle}" Command="{Binding CancelDeleteMessageCommand}" />
                                <Button Grid.Column="1" Text="永久删除" Style="{StaticResource PrimaryButtonStyle}" BackgroundColor="{StaticResource DangerColor}" Command="{Binding ConfirmDeleteMessageCommand}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Grid IsVisible="{Binding IsTopicMoveDialogOpen}">
                    <BoxView Background="{StaticResource OverlayBrush}"><BoxView.GestureRecognizers><TapGestureRecognizer Command="{Binding CancelTopicMoveDialogCommand}" /></BoxView.GestureRecognizers></BoxView>
                    <Border Style="{StaticResource DialogBorderStyle}" MaximumWidthRequest="500">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                        <VerticalStackLayout Spacing="12">
                            <Label Text="移动话题" Style="{StaticResource BaseLabelStyle}" FontSize="18" FontAttributes="Bold" />
                            <Label Text="选择目标频道并输入目标话题名称。提交后由服务器检查首条消息和权限。" Style="{StaticResource MutedLabelStyle}" LineBreakMode="WordWrap" />
                            <Picker ItemsSource="{Binding Channels}" ItemDisplayBinding="{Binding Name}" SelectedItem="{Binding TopicMoveDestinationChannel}" Title="目标频道" />
                            <Entry Text="{Binding TopicMoveDestinationName}" Placeholder="目标话题" Style="{StaticResource BaseEntryStyle}" />
                            <Label Text="{Binding TopicActionStatus}" IsVisible="{Binding HasTopicActionStatus}" Style="{StaticResource DangerLabelStyle}" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><Button Text="取消" Command="{Binding CancelTopicMoveDialogCommand}" Style="{StaticResource BaseButtonStyle}" /><Button Grid.Column="1" Text="移动" Command="{Binding ConfirmTopicMoveCommand}" IsEnabled="{Binding CanConfirmTopicMove}" Style="{StaticResource PrimaryButtonStyle}" /></Grid>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Grid IsVisible="{Binding IsTopicResolutionConfirmationOpen}">
                    <BoxView Background="{StaticResource OverlayBrush}"><BoxView.GestureRecognizers><TapGestureRecognizer Command="{Binding CancelTopicResolutionCommand}" /></BoxView.GestureRecognizers></BoxView>
                    <Border Style="{StaticResource DialogBorderStyle}" MaximumWidthRequest="460">
                        <VerticalStackLayout Spacing="12"><Label Text="更改话题解决状态？" Style="{StaticResource BaseLabelStyle}" FontSize="18" FontAttributes="Bold" /><Label Text="此操作会重命名整话题；服务器会检查权限和时间限制。" Style="{StaticResource MutedLabelStyle}" LineBreakMode="WordWrap" /><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><Button Text="取消" Command="{Binding CancelTopicResolutionCommand}" Style="{StaticResource BaseButtonStyle}" /><Button Grid.Column="1" Text="确认" Command="{Binding ConfirmTopicResolutionCommand}" Style="{StaticResource PrimaryButtonStyle}" /></Grid></VerticalStackLayout>
                    </Border>
                </Grid>

                <Grid IsVisible="{Binding IsTopicDeleteConfirmationOpen}">
                    <BoxView Background="{StaticResource OverlayBrush}"><BoxView.GestureRecognizers><TapGestureRecognizer Command="{Binding CancelTopicDeleteCommand}" /></BoxView.GestureRecognizers></BoxView>
                    <Border Style="{StaticResource DialogBorderStyle}" Stroke="{StaticResource DangerColor}">
                        <VerticalStackLayout Spacing="12"><Label Text="永久删除话题？" Style="{StaticResource DangerLabelStyle}" FontSize="18" FontAttributes="Bold" /><Label Text="此操作不可撤销。若服务器只完成部分删除或网络结果未知，RelayCove 不会自动重试。" Style="{StaticResource BaseLabelStyle}" LineBreakMode="WordWrap" /><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><Button Text="取消" Command="{Binding CancelTopicDeleteCommand}" Style="{StaticResource BaseButtonStyle}" /><Button Grid.Column="1" Text="永久删除" Command="{Binding ConfirmTopicDeleteCommand}" Style="{StaticResource PrimaryButtonStyle}" BackgroundColor="{StaticResource DangerColor}" /></Grid></VerticalStackLayout>
                    </Border>
                </Grid>

                <Grid IsVisible="{Binding IsChannelUnsubscribeConfirmationOpen}">
                    <BoxView Background="{StaticResource OverlayBrush}" />
                    <Border Style="{StaticResource DialogBorderStyle}" Stroke="{StaticResource DangerColor}">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                        <VerticalStackLayout Spacing="12">
                            <Label Text="退出频道？" Style="{StaticResource DangerLabelStyle}" FontSize="18" FontAttributes="Bold" />
                            <Label Text="{Binding ChannelUnsubscribeTargetName, StringFormat='将退出群聊“{0}”。之后需要再次获邀才能加入。'}"
                                   Style="{StaticResource BaseLabelStyle}"
                                   LineBreakMode="WordWrap" />
                            <Label Text="网络结果未知时不会自动重试，也不会提前从本地移除频道。"
                                   Style="{StaticResource MutedLabelStyle}"
                                   LineBreakMode="WordWrap" />
                            <Label Text="{Binding ChannelUnsubscribeError}"
                                   IsVisible="{Binding HasChannelUnsubscribeError}"
                                   Style="{StaticResource DangerLabelStyle}"
                                   LineBreakMode="WordWrap" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Button x:Name="ChannelUnsubscribeCancelButton"
                                        Text="取消"
                                        Style="{StaticResource BaseButtonStyle}"
                                        Command="{Binding CancelChannelUnsubscribeCommand}"
                                        IsEnabled="{Binding CanCloseChannelUnsubscribe}" />
                                <Button Grid.Column="1"
                                        Text="确认退出"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        BackgroundColor="{StaticResource DangerColor}"
                                        Command="{Binding ConfirmChannelUnsubscribeCommand}"
                                        IsEnabled="{Binding CanCloseChannelUnsubscribe}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Grid IsVisible="{Binding LogoutConfirmationVisible}">
                    <BoxView Background="{StaticResource OverlayBrush}" />
                    <Border Style="{StaticResource DialogBorderStyle}" Stroke="{StaticResource DangerColor}">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                        <VerticalStackLayout Spacing="12">
                            <Label Text="注销当前账户？" Style="{StaticResource DangerLabelStyle}" FontSize="18" FontAttributes="Bold" />
                            <Label Text="将删除安全凭据并锁定当前账号缓存；不会删除 Zulip 服务端消息。" Style="{StaticResource BaseLabelStyle}" LineBreakMode="WordWrap" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Button x:Name="LogoutCancelButton" Text="取消" Style="{StaticResource BaseButtonStyle}" Command="{Binding CancelLogoutCommand}" />
                                <Button Grid.Column="1" Text="确认注销" Style="{StaticResource PrimaryButtonStyle}" BackgroundColor="{StaticResource DangerColor}" Command="{Binding ConfirmLogoutCommand}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Border Margin="16"
                        Padding="12,8"
                        HorizontalOptions="Center"
                        VerticalOptions="Start"
                        IsVisible="{Binding HasUnavailableFeatureMessage}"
                        Background="{StaticResource SurfaceRaisedBrush}"
                        Stroke="{StaticResource WarningBrush}"
                        StrokeThickness="1">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Label Text="{Binding UnavailableFeatureMessage}"
                               Style="{StaticResource BaseLabelStyle}"
                               LineBreakMode="WordWrap"
                               VerticalTextAlignment="Center" />
                        <Button Grid.Column="1"
                                Text="×"
                                Style="{StaticResource IconButtonStyle}"
                                Command="{Binding DismissUnavailableFeatureCommand}"
                                SemanticProperties.Description="关闭能力说明" />
                    </Grid>
                </Border>

                <Border Margin="16,54,16,0"
                        Padding="12,8"
                        HorizontalOptions="Center"
                        VerticalOptions="Start"
                        IsVisible="{Binding HasLoginError}"
                        Background="{StaticResource SurfaceRaisedBrush}"
                        Stroke="{StaticResource DangerBrush}"
                        StrokeThickness="1">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <Label Text="{Binding LoginError}"
                           Style="{StaticResource DangerLabelStyle}"
                           LineBreakMode="WordWrap" />
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
