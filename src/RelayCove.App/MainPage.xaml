                                </VerticalStackLayout>
                            </Grid>

                            <Grid Grid.Row="3" RowDefinitions="Auto,Auto" Margin="4,2,4,4" RowSpacing="5">
                                <Label Text="{Binding DownloadCenterStatus}"
                                       IsVisible="{Binding HasDownloadCenterStatus}"
                                       Style="{StaticResource DangerLabelStyle}"
                                       FontSize="11" />
                                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Button Text="打开下载文件夹"
                                            Style="{StaticResource BaseButtonStyle}"
                                            Command="{Binding OpenDownloadFolderCommand}" />
