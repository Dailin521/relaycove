<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:RelayCove.App"
             xmlns:controls="clr-namespace:RelayCove.App.Controls"
             xmlns:windowsBehaviors="clr-namespace:RelayCove.App.Platforms.Windows.Behaviors"
             xmlns:viewModels="clr-namespace:RelayCove.App.ViewModels"
             x:Class="RelayCove.App.MainPage"
             x:Name="RootPage"
             x:DataType="viewModels:ShellViewModel"
             Style="{StaticResource RelayCovePageStyle}"
             Title="RelayCove"
             Shell.NavBarIsVisible="False">
    <Grid Background="{StaticResource GroundBrush}">
        <Grid
              IsVisible="{Binding LoginVisible}"
              Padding="24">
            <Border Padding="28"
                    MaximumWidthRequest="480"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Background="{StaticResource SurfaceBrush}"
                    Stroke="{StaticResource BorderBrush}"
                    StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="14">
                    <Label Text="登录 RelayCove"
                           Style="{StaticResource BaseLabelStyle}"
                           FontSize="24"
                           FontAttributes="Bold" />
                    <Label Text="使用 Zulip Realm 的邮箱和密码；密码仅用于交换 API Key。"
                           Style="{StaticResource MutedLabelStyle}"
                           LineBreakMode="WordWrap" />
                    <Entry Placeholder="Realm HTTPS origin"
                           Style="{StaticResource BaseEntryStyle}"
                           Text="{Binding Realm}"
                           Keyboard="Url"
                           SemanticProperties.Description="Zulip Realm HTTPS origin" />
                    <Entry Placeholder="邮箱"
                           Style="{StaticResource BaseEntryStyle}"
                           Text="{Binding Email}"
                           Keyboard="Email"
                           SemanticProperties.Description="Zulip 登录邮箱" />
                    <Entry Placeholder="密码"
                           Style="{StaticResource BaseEntryStyle}"
                           Text="{Binding Password}"
                           IsPassword="True"
                           ReturnType="Go"
                           ReturnCommand="{Binding LoginCommand}"
                           SemanticProperties.Description="Zulip 登录密码" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Button Text="登录"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding LoginCommand}" />
                        <Button Grid.Column="1"
                                Text="取消"
                                Style="{StaticResource BaseButtonStyle}"
                                Command="{Binding LoginCancelCommand}" />
                    </Grid>
                    <Label Text="{Binding LoginError}"
                           Style="{StaticResource DangerLabelStyle}"
                           LineBreakMode="WordWrap" />
                    <Label Text="Stage 21 的人工密码登录与干净 VM 门禁仍未验证。"
                           Style="{StaticResource MutedLabelStyle}"
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <Grid IsVisible="{Binding MainVisible}">
            <Grid>
                <Grid IsVisible="{Binding IsConversationWorkspaceSection}">
                    <Grid IsEnabled="{Binding IsPrimaryShellEnabled}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding ConversationPaneWidth}" />
                            <ColumnDefinition Width="{Binding ChatPaneWidth}" />
                            <ColumnDefinition Width="{Binding InlineDetailsWidth}" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Padding="0"
                                IsVisible="{Binding IsConversationPaneVisible}"
                                Background="{StaticResource GroundBrush}"
                                Stroke="{StaticResource BorderBrush}"
                                StrokeThickness="1">
                            <controls:ConversationPaneView x:Name="ConversationPane" />
                        </Border>

                        <Grid Grid.Column="1"
                              IsVisible="{Binding IsWorkspaceContentPaneVisible}"
                              Background="{StaticResource SurfaceBrush}">
                            <Grid IsVisible="{Binding IsMessagesSection}"
                                  RowDefinitions="Auto,*,Auto,Auto">
                                <controls:ChatHeaderView x:Name="ChatHeader" Grid.Row="0" />
                                <controls:ConversationMessageHost Grid.Row="1"
                                                                  Presentations="{Binding MessagePresentations}" />
                                <Border Grid.Row="2"
                                        Margin="14,4,14,0"
                                        Padding="12,9"
                                        IsVisible="{Binding IsMediaDownloadStatusVisible}"
                                        Background="{StaticResource SurfaceSoftBrush}"
                                        Stroke="{StaticResource BorderBrush}"
                                        StrokeThickness="1">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="9" /></Border.StrokeShape>
                                    <Grid RowDefinitions="Auto,Auto" RowSpacing="7">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
                                            <Image Source="icon_attachment.png" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                                            <VerticalStackLayout Grid.Column="1" Spacing="1">
                                                <Label Text="{Binding MediaDownloadFileName}"
                                                       Style="{StaticResource BaseLabelStyle}"
                                                       FontAttributes="Bold"
                                                       LineBreakMode="MiddleTruncation" />
                                                <Label Text="{Binding MediaActionStatus}"
                                                       Style="{StaticResource MutedLabelStyle}" />
                                            </VerticalStackLayout>
                                            <HorizontalStackLayout Grid.Column="2" Spacing="6">
                                                <Button Text="重试"
                                                        IsVisible="{Binding CanRetryMediaDownload}"
                                                        Style="{StaticResource BaseButtonStyle}"
                                                        Command="{Binding RetryMediaDownloadCommand}" />
                                                <Button Text="取消"
                                                        IsVisible="{Binding IsMediaActionBusy}"
                                                        Style="{StaticResource BaseButtonStyle}"
                                                        Command="{Binding DownloadAttachmentCancelCommand}" />
                                            </HorizontalStackLayout>
                                        </Grid>
                                        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                            <ActivityIndicator IsVisible="{Binding IsMediaDownloadIndeterminate}"
                                                               IsRunning="{Binding IsMediaDownloadIndeterminate}"
                                                               WidthRequest="16"
                                                               HeightRequest="16" />
                                            <ProgressBar Grid.Column="1"
                                                         IsVisible="{Binding HasKnownMediaDownloadLength}"
                                                         Progress="{Binding MediaDownloadProgress}"
                                                         ProgressColor="{StaticResource AccentColor}"
                                                         VerticalOptions="Center" />
                                            <Label Grid.Column="2"
                                                   Text="{Binding MediaDownloadProgressText}"
                                                   Style="{StaticResource MutedLabelStyle}"
                                                   FontSize="11"
                                                   VerticalTextAlignment="Center" />
                                        </Grid>
                                    </Grid>
                                </Border>
                                <controls:ComposerView Grid.Row="3" />
                            </Grid>

                            <Grid IsVisible="{Binding IsSavedSection}"
                                  Padding="28"
                                  RowDefinitions="Auto,Auto,*"
                                  RowSpacing="14">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Button x:Name="SavedBackButton"
                                            Text="← 返回聊天"
                                            Style="{StaticResource BaseButtonStyle}"
                                            Command="{Binding ShowMessagesCommand}" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                        <Label Text="收藏的消息"
                                               Style="{StaticResource BaseLabelStyle}"
                                               FontSize="22"
                                               FontAttributes="Bold" />
                                        <Label Text="当前账号在服务器上收藏的消息"
                                               Style="{StaticResource MutedLabelStyle}" />
                                    </VerticalStackLayout>
                                    <Button Grid.Column="2"
                                            Text="刷新"
                                            Style="{StaticResource BaseButtonStyle}"
                                            Command="{Binding RefreshSavedCommand}" />
                                </Grid>
                                <VerticalStackLayout Grid.Row="1" Spacing="3">
                                    <Label Text="其他设备新增了收藏，可刷新查看。"
                                           IsVisible="{Binding SavedRefreshSuggested}"
                                           Style="{StaticResource MutedLabelStyle}" />
                                    <Label Text="正在读取收藏的消息…"
                                           IsVisible="{Binding IsSavedLoading}"
                                           Style="{StaticResource MutedLabelStyle}" />
                                    <Label Text="{Binding SavedError}"
                                           IsVisible="{Binding HasSavedError}"
                                           Style="{StaticResource MutedLabelStyle}" />
                                </VerticalStackLayout>
                                <Grid Grid.Row="2">
                                    <CollectionView ItemsSource="{Binding SavedMessages}"
                                                    SelectionMode="None">
                                        <CollectionView.ItemTemplate>
                                            <DataTemplate x:DataType="viewModels:SavedMessageItem">
                                                <Border Padding="12"
                                                        Margin="0,0,0,8"
                                                        Style="{StaticResource CardBorderStyle}">
                                                    <Grid ColumnDefinitions="*,Auto"
                                                          RowDefinitions="Auto,Auto,Auto"
                                                          ColumnSpacing="10">
                                                        <Label Text="{Binding Sender}"
                                                               Style="{StaticResource BaseLabelStyle}"
                                                               FontAttributes="Bold" />
                                                        <Label Grid.Column="1"
                                                               Text="{Binding Timestamp}"
                                                               Style="{StaticResource MutedLabelStyle}" />
                                                        <Label Grid.Row="1"
                                                               Grid.ColumnSpan="2"
                                                               Text="{Binding Content}"
                                                               Style="{StaticResource BaseLabelStyle}"
                                                               LineBreakMode="TailTruncation"
                                                               MaxLines="2" />
                                                        <HorizontalStackLayout Grid.Row="2"
                                                                               Grid.ColumnSpan="2"
                                                                               Spacing="8"
                                                                               Margin="0,8,0,0">
                                                            <Button Text="跳转到消息"
                                                                    Style="{StaticResource BaseButtonStyle}"
                                                                    Command="{Binding ViewModel.OpenSavedMessageCommand, Source={x:Reference RootPage}, x:DataType=local:MainPage}"
                                                                    CommandParameter="{Binding .}" />
                                                            <Button Text="取消收藏"
                                                                    Style="{StaticResource BaseButtonStyle}"
                                                                    Command="{Binding ViewModel.UnstarSavedMessageCommand, Source={x:Reference RootPage}, x:DataType=local:MainPage}"
                                                                    CommandParameter="{Binding .}" />
                                                        </HorizontalStackLayout>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </CollectionView.ItemTemplate>
                                        <CollectionView.Footer>
                                            <Button Text="加载更早消息"
                                                    IsVisible="{Binding ViewModel.HasMoreSavedMessages, Source={x:Reference RootPage}, x:DataType=local:MainPage}"
                                                    Command="{Binding ViewModel.LoadOlderSavedCommand, Source={x:Reference RootPage}, x:DataType=local:MainPage}"
                                                    Style="{StaticResource BaseButtonStyle}" />
                                        </CollectionView.Footer>
                                    </CollectionView>
                                    <Label Text="还没有收藏消息。"
                                           IsVisible="{Binding IsSavedEmpty}"
                                           Style="{StaticResource MutedLabelStyle}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Grid>
                            </Grid>
                        </Grid>

                        <Border Grid.Column="2"
                                IsVisible="{Binding IsInlineDetailsVisible}"
                                Background="{StaticResource SurfaceSoftBrush}"
                                Stroke="{StaticResource BorderBrush}"
                                StrokeThickness="1">
                            <controls:DetailsPaneView x:Name="InlineDetails" />
                        </Border>
                    </Grid>

                    <Grid IsVisible="{Binding IsOverlayDetailsVisible}">
                        <BoxView Background="{StaticResource OverlayBrush}">
                            <BoxView.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleDetailsCommand}" />
                            </BoxView.GestureRecognizers>
                        </BoxView>
                        <Border WidthRequest="284"
                                HorizontalOptions="End"
                                Background="{StaticResource SurfaceSoftBrush}"
                                Stroke="{StaticResource StrongBorderBrush}"
                                StrokeThickness="1">
                            <controls:DetailsPaneView x:Name="OverlayDetails"
                                                     IsModal="True" />
                        </Border>
                    </Grid>
                </Grid>

                <controls:SettingsPageView IsVisible="{Binding IsSettingsSection}" />

                <Grid IsVisible="{Binding IsAccountMenuOpen}">
                    <BoxView Background="Transparent">
                        <BoxView.GestureRecognizers><TapGestureRecognizer Command="{Binding CloseAccountMenuCommand}" /></BoxView.GestureRecognizers>
                    </BoxView>
                    <Border WidthRequest="320"
                            Margin="8,8,0,0"
                            Style="{StaticResource PopoverBorderStyle}"
                            HorizontalOptions="Start"
                            VerticalOptions="Start">
                        <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                        <VerticalStackLayout Spacing="4">
                            <Grid Margin="6,6,6,8" ColumnDefinitions="40,*" ColumnSpacing="10">
                                <Border WidthRequest="40" HeightRequest="40" Padding="0"
                                        Background="{StaticResource AccentBrush}" StrokeThickness="0">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                                    <Grid>
                                        <Label Text="{Binding CurrentUserInitial}" TextColor="White" FontAttributes="Bold"
                                               HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                        <controls:RealmMediaImageView SourceUrl="{Binding CurrentUserAvatarUrl}"
                                                                      MediaKind="Avatar" Aspect="AspectFill" ShowFailureText="False" />
                                        <Border x:Name="AccountMenuOwnPresenceDot"
                                                WidthRequest="11"
                                                HeightRequest="11"
                                                Padding="0"
                                                Margin="0,0,1,1"
                                                HorizontalOptions="End"
                                                VerticalOptions="End"
                                                InputTransparent="True"
                                                IsVisible="{Binding HasOwnPresenceStatus}"
                                                Background="{Binding OwnPresenceBrush}"
                                                Stroke="{StaticResource SurfaceBrush}"
                                                StrokeThickness="2"
                                                SemanticProperties.Description="{Binding OwnPresenceLabel, StringFormat='我的状态 {0}'}">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="6" /></Border.StrokeShape>
                                        </Border>
                                    </Grid>
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                    <Label Text="{Binding CurrentUserDisplayName}" Style="{StaticResource BaseLabelStyle}" FontAttributes="Bold" />
                                    <Label Text="{Binding WorkspaceDisplayName}" Style="{StaticResource MutedLabelStyle}" />
                                </VerticalStackLayout>
                            </Grid>
                            <BoxView HeightRequest="1" Background="{StaticResource BorderBrush}" />
                            <VerticalStackLayout Padding="6,4" Spacing="6"
                                                 IsVisible="{Binding ShowOwnPresenceControls}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Label Text="{Binding OwnPresenceStatusText}"
                                           Style="{StaticResource MutedLabelStyle}"
                                           VerticalTextAlignment="Center"
                                           SemanticProperties.HeadingLevel="Level3" />
                                    <ActivityIndicator Grid.Column="1"
                                                       WidthRequest="16"
                                                       HeightRequest="16"
                                                       IsRunning="{Binding IsOwnPresenceBusy}"
                                                       Color="{StaticResource AccentColor}"
                                                       SemanticProperties.Description="正在更新我的状态" />
                                </Grid>
                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                                    <Button Grid.Column="0" Text="在线" FontSize="12" Padding="6,5"
                                            Style="{StaticResource BaseButtonStyle}"
                                            IsEnabled="{Binding CanSetOwnPresenceOnline}"
                                            Command="{Binding SetOwnPresenceOnlineCommand}"
                                            SemanticProperties.Description="设置我的状态为在线">
                                        <Button.Triggers>
                                            <DataTrigger TargetType="Button" Binding="{Binding IsOwnPresenceOnline}" Value="True">
                                                <Setter Property="BackgroundColor" Value="#DCFCE7" />
                                                <Setter Property="BorderColor" Value="#22C55E" />
                                            </DataTrigger>
                                        </Button.Triggers>
                                    </Button>
                                    <Button Grid.Column="1" Text="忙碌" FontSize="12" Padding="6,5"
                                            Style="{StaticResource BaseButtonStyle}"
                                            IsEnabled="{Binding CanSetOwnPresenceIdle}"
                                            Command="{Binding SetOwnPresenceIdleCommand}"
                                            SemanticProperties.Description="设置我的状态为忙碌">
                                        <Button.Triggers>
                                            <DataTrigger TargetType="Button" Binding="{Binding IsOwnPresenceIdle}" Value="True">
                                                <Setter Property="BackgroundColor" Value="#FEF3C7" />
                                                <Setter Property="BorderColor" Value="#F59E0B" />
                                            </DataTrigger>
                                        </Button.Triggers>
                                    </Button>
                                    <Button Grid.Column="2" Text="离线" FontSize="12" Padding="6,5"
                                            Style="{StaticResource BaseButtonStyle}"
                                            IsEnabled="{Binding CanSetOwnPresenceOffline}"
                                            Command="{Binding SetOwnPresenceOfflineCommand}"
                                            SemanticProperties.Description="开启隐身模式，对其他用户显示离线">
                                        <Button.Triggers>
                                            <DataTrigger TargetType="Button" Binding="{Binding IsOwnPresenceOffline}" Value="True">
                                                <Setter Property="BackgroundColor" Value="#F3F4F6" />
                                                <Setter Property="BorderColor" Value="#9CA3AF" />
                                            </DataTrigger>
                                        </Button.Triggers>
                                    </Button>
                                </Grid>
                                <Label Text="{Binding OwnPresenceError}"
                                       IsVisible="{Binding HasOwnPresenceError}"
                                       Style="{StaticResource DangerLabelStyle}"
                                       FontSize="11" />
                            </VerticalStackLayout>
                            <BoxView HeightRequest="1" Background="{StaticResource BorderBrush}"
                                     IsVisible="{Binding ShowOwnPresenceControls}" />
                            <VerticalStackLayout Padding="6,4" Spacing="6"
                                                 IsVisible="{Binding ShowOwnUserStatusControls}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Label Text="{Binding OwnUserStatusStatusText}"
                                           Style="{StaticResource MutedLabelStyle}"
                                           VerticalTextAlignment="Center"
                                           LineBreakMode="TailTruncation"
                                           SemanticProperties.HeadingLevel="Level3" />
                                    <ActivityIndicator Grid.Column="1"
                                                       WidthRequest="16"
                                                       HeightRequest="16"
                                                       IsRunning="{Binding IsOwnUserStatusBusy}"
                                                       Color="{StaticResource AccentColor}"
                                                       SemanticProperties.Description="正在更新个人状态" />
                                </Grid>
                                <Grid ColumnDefinitions="*,*"
                                      RowDefinitions="Auto,Auto,Auto,Auto"
                                      ColumnSpacing="6"
                                      RowSpacing="6">
                                    <Button Grid.Row="0" Grid.Column="0" Text="🛠️ 忙碌" FontSize="12" Padding="6,5"
                                            Style="{StaticResource BaseButtonStyle}"
                                            IsEnabled="{Binding CanSetOwnUserStatus}"
                                            Command="{Binding SetOwnUserStatusBusyCommand}" />
                                    <Button Grid.Row="0" Grid.Column="1" Text="📅 会议中" FontSize="12" Padding="6,5"
                                            Style="{StaticResource BaseButtonStyle}"
                                            IsEnabled="{Binding CanSetOwnUserStatus}"
                                            Command="{Binding SetOwnUserStatusMeetingCommand}" />
                                    <Button Grid.Row="1" Grid.Column="0" Text="🚌 通勤中" FontSize="12" Padding="6,5"
                                            Style="{StaticResource BaseButtonStyle}"
                                            IsEnabled="{Binding CanSetOwnUserStatus}"
                                            Command="{Binding SetOwnUserStatusCommutingCommand}" />
                                    <Button Grid.Row="1" Grid.Column="1" Text="🤕 病假" FontSize="12" Padding="6,5"
                                            Style="{StaticResource BaseButtonStyle}"
                                            IsEnabled="{Binding CanSetOwnUserStatus}"
                                            Command="{Binding SetOwnUserStatusSickCommand}" />
                                    <Button Grid.Row="2" Grid.Column="0" Text="🌴 休假" FontSize="12" Padding="6,5"
                                            Style="{StaticResource BaseButtonStyle}"
                                            IsEnabled="{Binding CanSetOwnUserStatus}"
                                            Command="{Binding SetOwnUserStatusVacationCommand}" />
                                    <Button Grid.Row="2" Grid.Column="1" Text="🏠 远程办公" FontSize="12" Padding="6,5"
                                            Style="{StaticResource BaseButtonStyle}"
                                            IsEnabled="{Binding CanSetOwnUserStatus}"
                                            Command="{Binding SetOwnUserStatusRemoteCommand}" />
                                    <Button Grid.Row="3" Grid.Column="0" Text="🏢 在办公室" FontSize="12" Padding="6,5"
                                            Style="{StaticResource BaseButtonStyle}"
                                            IsEnabled="{Binding CanSetOwnUserStatus}"
                                            Command="{Binding SetOwnUserStatusOfficeCommand}" />
                                    <Button Grid.Row="3" Grid.Column="1" Text="清除状态" FontSize="12" Padding="6,5"
                                            Style="{StaticResource BaseButtonStyle}"
                                            IsEnabled="{Binding CanClearOwnUserStatus}"
                                            Command="{Binding ClearOwnUserStatusCommand}" />
                                </Grid>
                                <Label Text="{Binding OwnUserStatusError}"
                                       IsVisible="{Binding HasOwnUserStatusError}"
                                       Style="{StaticResource DangerLabelStyle}"
                                       FontSize="11"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                            <BoxView HeightRequest="1" Background="{StaticResource BorderBrush}"
                                     IsVisible="{Binding ShowOwnUserStatusControls}" />
                            <Button x:Name="FirstAccountMenuButton" Text="收藏的消息" ImageSource="icon_star.png" Style="{StaticResource PopoverMenuButtonStyle}" Command="{Binding ShowSavedCommand}">
                                <Button.Behaviors><windowsBehaviors:LeftAlignedButtonContentBehavior /></Button.Behaviors>
                            </Button>
                            <Button Text="账户设置" ImageSource="icon_settings.png" Style="{StaticResource PopoverMenuButtonStyle}" Command="{Binding ShowSettingsCommand}">
                                <Button.Behaviors><windowsBehaviors:LeftAlignedButtonContentBehavior /></Button.Behaviors>
                            </Button>
                            <Button x:Name="LastAccountMenuButton" Text="注销" ImageSource="icon_close.png" Style="{StaticResource PopoverMenuButtonStyle}" Command="{Binding RequestLogoutCommand}">
                                <Button.Behaviors><windowsBehaviors:LeftAlignedButtonContentBehavior /></Button.Behaviors>
                            </Button>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Grid IsVisible="{Binding IsDownloadCenterOpen}">
                    <BoxView Background="Transparent">
                        <BoxView.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CloseDownloadCenterCommand}" />
                        </BoxView.GestureRecognizers>
                    </BoxView>
                    <Border WidthRequest="380"
                            MaximumHeightRequest="540"
                            Margin="0,8,8,0"
                            Style="{StaticResource PopoverBorderStyle}"
                            HorizontalOptions="End"
                            VerticalOptions="Start">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                        <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="6">
                            <Grid Margin="8,5,5,5" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                                    <Label Text="下载内容"
                                           Style="{StaticResource BaseLabelStyle}"
                                           FontSize="17"
                                           FontAttributes="Bold" />
                                    <Label Text="最近下载的文件"
                                           Style="{StaticResource MutedLabelStyle}"
                                           FontSize="11" />
                                </VerticalStackLayout>
                                <Button x:Name="DownloadCenterCloseButton"
                                        Grid.Column="1"
                                        Text="×"
                                        Style="{StaticResource IconButtonStyle}"
                                        Command="{Binding CloseDownloadCenterCommand}"
                                        SemanticProperties.Description="关闭下载内容" />
                            </Grid>

                            <Border Grid.Row="1"
                                    Margin="4,0"
                                    Padding="10"
                                    IsVisible="{Binding ShowDownloadCenterCurrentTask}"
                                    Background="{StaticResource SurfaceSoftBrush}"
                                    Stroke="{StaticResource BorderBrush}"
                                    StrokeThickness="1">
                                <Border.StrokeShape><RoundRectangle CornerRadius="9" /></Border.StrokeShape>
                                <Grid RowDefinitions="Auto,Auto" RowSpacing="7">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
                                        <Image Source="icon_download.png" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                                        <VerticalStackLayout Grid.Column="1" Spacing="1">
                                            <Label Text="{Binding MediaDownloadFileName}"
                                                   Style="{StaticResource BaseLabelStyle}"
                                                   FontAttributes="Bold"
                                                   LineBreakMode="MiddleTruncation" />
                                            <Label Text="{Binding MediaActionStatus}"
                                                   Style="{StaticResource MutedLabelStyle}"
                                                   FontSize="11" />
                                        </VerticalStackLayout>
                                        <HorizontalStackLayout Grid.Column="2" Spacing="5">
                                            <Button Text="重试"
                                                    IsVisible="{Binding CanRetryMediaDownload}"
                                                    Style="{StaticResource BaseButtonStyle}"
                                                    Command="{Binding RetryMediaDownloadCommand}" />
                                            <Button Text="移除"
                                                    IsVisible="{Binding CanRetryMediaDownload}"
                                                    Style="{StaticResource BaseButtonStyle}"
                                                    Command="{Binding DismissFailedMediaDownloadCommand}" />
                                            <Button Text="取消"
                                                    IsVisible="{Binding IsMediaActionBusy}"
                                                    Style="{StaticResource BaseButtonStyle}"
                                                    Command="{Binding DownloadAttachmentCancelCommand}" />
                                        </HorizontalStackLayout>
                                    </Grid>
                                    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="7">
                                        <ActivityIndicator IsVisible="{Binding IsMediaDownloadIndeterminate}"
                                                           IsRunning="{Binding IsMediaDownloadIndeterminate}"
                                                           WidthRequest="15"
                                                           HeightRequest="15" />
                                        <ProgressBar Grid.Column="1"
                                                     IsVisible="{Binding HasKnownMediaDownloadLength}"
                                                     Progress="{Binding MediaDownloadProgress}"
                                                     ProgressColor="{StaticResource AccentColor}" />
                                        <Label Grid.Column="2"
                                               Text="{Binding MediaDownloadProgressText}"
                                               Style="{StaticResource MutedLabelStyle}"
                                               FontSize="10" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="2" MinimumHeightRequest="110" MaximumHeightRequest="390">
                                <CollectionView ItemsSource="{Binding RecentDownloads}"
                                                SelectionMode="None"
                                                IsVisible="{Binding HasRecentDownloads}">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="viewModels:DownloadHistoryItem">
                                            <Border Margin="4,2"
                                                    Padding="10,8"
                                                    Background="Transparent"
                                                    Stroke="Transparent"
                                                    StrokeThickness="0">
                                                <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding ViewModel.OpenRecentDownloadCommand, Source={x:Reference RootPage}, x:DataType=local:MainPage}"
                                                                          CommandParameter="{Binding .}" />
                                                </Border.GestureRecognizers>
                                                <FlyoutBase.ContextFlyout>
                                                    <MenuFlyout>
                                                        <MenuFlyoutItem Text="打开"
                                                                        Command="{Binding ViewModel.OpenRecentDownloadCommand, Source={x:Reference RootPage}, x:DataType=local:MainPage}"
                                                                        CommandParameter="{Binding .}" />
                                                        <MenuFlyoutItem Text="在文件夹中显示"
                                                                        Command="{Binding ViewModel.ShowRecentDownloadInFolderCommand, Source={x:Reference RootPage}, x:DataType=local:MainPage}"
                                                                        CommandParameter="{Binding .}" />
                                                        <MenuFlyoutSeparator />
                                                        <MenuFlyoutItem Text="从记录中移除"
                                                                        Command="{Binding ViewModel.RemoveRecentDownloadCommand, Source={x:Reference RootPage}, x:DataType=local:MainPage}"
                                                                        CommandParameter="{Binding .}" />
                                                    </MenuFlyout>
                                                </FlyoutBase.ContextFlyout>
                                                <Grid ColumnDefinitions="34,*,Auto" ColumnSpacing="9">
                                                    <Border WidthRequest="34"
                                                            HeightRequest="34"
                                                            Padding="7"
                                                            Background="{StaticResource SurfaceSoftBrush}"
                                                            StrokeThickness="0">
                                                        <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                                        <Image Source="icon_download.png" />
                                                    </Border>
                                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                                        <Label Text="{Binding FileName}"
                                                               Style="{StaticResource BaseLabelStyle}"
                                                               FontAttributes="Bold"
                                                               LineBreakMode="MiddleTruncation" />
                                                        <Label Text="{Binding StatusLabel}"
                                                               Style="{StaticResource MutedLabelStyle}"
                                                               FontSize="11">
                                                            <Label.Triggers>
                                                                <DataTrigger TargetType="Label" Binding="{Binding IsMissing}" Value="True">
                                                                    <Setter Property="TextColor" Value="{StaticResource DangerColor}" />
                                                                </DataTrigger>
                                                            </Label.Triggers>
                                                        </Label>
                                                    </VerticalStackLayout>
                                                    <HorizontalStackLayout Grid.Column="2" Spacing="2" VerticalOptions="Center">
                                                        <Button Text="打开"
                                                                Style="{StaticResource MessageQuickButtonStyle}"
                                                                Command="{Binding ViewModel.OpenRecentDownloadCommand, Source={x:Reference RootPage}, x:DataType=local:MainPage}"
                                                                CommandParameter="{Binding .}" />
                                                        <Button Text="定位"
                                                                Style="{StaticResource MessageQuickButtonStyle}"
                                                                Command="{Binding ViewModel.ShowRecentDownloadInFolderCommand, Source={x:Reference RootPage}, x:DataType=local:MainPage}"
                                                                CommandParameter="{Binding .}" />
                                                        <Button Text="×"
                                                                Style="{StaticResource MessageQuickButtonStyle}"
                                                                Command="{Binding ViewModel.RemoveRecentDownloadCommand, Source={x:Reference RootPage}, x:DataType=local:MainPage}"
                                                                CommandParameter="{Binding .}"
                                                                SemanticProperties.Description="从下载记录移除" />
                                                    </HorizontalStackLayout>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                                <VerticalStackLayout IsVisible="{Binding IsDownloadCenterEmpty}"
                                                     Spacing="6"
                                                     HorizontalOptions="Center"
                                                     VerticalOptions="Center">
                                    <Image Source="icon_download.png" WidthRequest="28" HeightRequest="28" Opacity="0.7" />
