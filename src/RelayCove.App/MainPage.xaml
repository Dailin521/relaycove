                                                <PointerGestureRecognizer
                                                    PointerEntered="OnEmojiPointerEntered"
                                                    PointerExited="OnEmojiPointerExited" />
                                            </Grid.GestureRecognizers>
                                            <Border InputTransparent="True"
                                                    WidthRequest="40"
                                                    HeightRequest="38"
                                                    HorizontalOptions="Center"
                                                    VerticalOptions="Center"
                                                    Stroke="Transparent"
                                                    StrokeThickness="2">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="7" />
                                                </Border.StrokeShape>
