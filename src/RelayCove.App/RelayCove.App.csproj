<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <AssemblyName>RichChat</AssemblyName>
    <RootNamespace>RelayCove.App</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <MauiVersion>10.0.20</MauiVersion>
    <ApplicationTitle>RichChat</ApplicationTitle>
    <ApplicationId>com.relaycove.client</ApplicationId>
    <!-- MAUI Windows resource metadata accepts only numeric major.minor.patch. -->
    <ApplicationDisplayVersion>1.0.8</ApplicationDisplayVersion>
    <ApplicationVersion>15</ApplicationVersion>
    <InformationalVersion>1.0.8</InformationalVersion>
    <FileVersion>$(ApplicationDisplayVersion).$(ApplicationVersion)</FileVersion>
    <ApplicationIcon>Resources\AppIcon\RelayCove.ico</ApplicationIcon>
    <WindowsPackageType>None</WindowsPackageType>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <RuntimeIdentifier Condition="'$(RuntimeIdentifierOverride)' == ''">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifierOverride)' != ''">$(RuntimeIdentifierOverride)</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="RichChatBuildNumber" Value="$(ApplicationVersion)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <!-- The desktop toast compatibility library extracts the app icon with System.Drawing. -->
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <MauiImage Include="Resources\Images\*.svg" />
    <Content Include="Resources\AppIcon\RelayCove.ico" Link="Assets\RichChat-R.ico"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Resources\Sounds\mattermost_bing.mp3" Link="Assets\Audio\mattermost_bing.mp3"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Resources\Sounds\Mattermost-LICENSE.txt" Link="Assets\Audio\Mattermost-LICENSE.txt"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RelayCove.Core\RelayCove.Core.csproj" />
    <ProjectReference Include="..\RelayCove.Data\RelayCove.Data.csproj" />
    <ProjectReference Include="..\RelayCove.Zulip.Client\RelayCove.Zulip.Client.csproj" />
  </ItemGroup>
</Project>
