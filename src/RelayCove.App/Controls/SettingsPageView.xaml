<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:RelayCove.App.ViewModels"
             x:Class="RelayCove.App.Controls.SettingsPageView"
             x:DataType="viewModels:ShellViewModel"
             Background="{StaticResource SurfaceBrush}">
    <Grid ColumnDefinitions="218,1,*">
        <Grid Grid.Column="0" RowDefinitions="Auto,*" Padding="13,23" Background="{StaticResource GroundBrush}"
              IsVisible="{Binding IsNotNarrowLayout}">
            <VerticalStackLayout Spacing="12" Margin="0,0,0,18">
                <Button Text="返回聊天"
                        ImageSource="icon_back.png"
                        Style="{StaticResource BaseButtonStyle}"
                        HorizontalOptions="Start"
                        Command="{Binding ShowMessagesCommand}"
                        SemanticProperties.Description="返回聊天" />
                <Label Text="设置"
                       Style="{StaticResource BaseLabelStyle}"
                       FontSize="20"
                       FontAttributes="Bold"
                       Margin="10,0" />
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Row="1" Spacing="4">
                <Button Text="外观" ImageSource="icon_moon.png" Style="{StaticResource SettingsNavigationButtonStyle}"
                        Command="{Binding ShowAppearanceSettingsCommand}">
                    <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding IsAppearanceSettings}" Value="True"><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightSurfaceSelectedColor}, Dark={StaticResource DarkSurfaceSelectedColor}}" /><Setter Property="BorderWidth" Value="0" /></DataTrigger></Button.Triggers>
                </Button>
                <Button Text="通用" ImageSource="icon_settings.png" Style="{StaticResource SettingsNavigationButtonStyle}"
                        Command="{Binding ShowGeneralSettingsCommand}">
                    <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding IsGeneralSettings}" Value="True"><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightSurfaceSelectedColor}, Dark={StaticResource DarkSurfaceSelectedColor}}" /><Setter Property="BorderWidth" Value="0" /></DataTrigger></Button.Triggers>
                </Button>
                <Button Text="通知" ImageSource="icon_info.png" Style="{StaticResource SettingsNavigationButtonStyle}"
                        Command="{Binding ShowNotificationSettingsCommand}">
                    <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding IsNotificationSettings}" Value="True"><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightSurfaceSelectedColor}, Dark={StaticResource DarkSurfaceSelectedColor}}" /><Setter Property="BorderWidth" Value="0" /></DataTrigger></Button.Triggers>
                </Button>
                <Button Text="存储" ImageSource="icon_bookmark.png" Style="{StaticResource SettingsNavigationButtonStyle}"
                        Command="{Binding ShowStorageSettingsCommand}">
                    <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding IsStorageSettings}" Value="True"><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightSurfaceSelectedColor}, Dark={StaticResource DarkSurfaceSelectedColor}}" /><Setter Property="BorderWidth" Value="0" /></DataTrigger></Button.Triggers>
                </Button>
                <Button Text="账户" ImageSource="icon_contacts.png" Style="{StaticResource SettingsNavigationButtonStyle}"
                        Command="{Binding ShowAccountSettingsCommand}">
                    <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding IsAccountSettings}" Value="True"><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightSurfaceSelectedColor}, Dark={StaticResource DarkSurfaceSelectedColor}}" /><Setter Property="BorderWidth" Value="0" /></DataTrigger></Button.Triggers>
                </Button>
            </VerticalStackLayout>
        </Grid>

        <BoxView Grid.Column="1" Background="{StaticResource BorderBrush}" IsVisible="{Binding IsNotNarrowLayout}" />

        <ScrollView Grid.Column="0"
                    Grid.ColumnSpan="3"
                    Orientation="Horizontal"
                    HorizontalScrollBarVisibility="Never"
                    VerticalOptions="Start"
                    HeightRequest="58"
                    Padding="10,8"
                    Background="{StaticResource GroundBrush}"
                    IsVisible="{Binding IsNarrowLayout}"
            ZIndex="2">
            <HorizontalStackLayout Spacing="6">
                <Button Text="返回聊天"
                        ImageSource="icon_back.png"
                        Style="{StaticResource BaseButtonStyle}"
                        Command="{Binding ShowMessagesCommand}"
                        SemanticProperties.Description="返回聊天" />
                <Button Text="外观" ImageSource="icon_moon.png" Style="{StaticResource BaseButtonStyle}" Command="{Binding ShowAppearanceSettingsCommand}">
                    <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding IsAppearanceSettings}" Value="True"><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightSurfaceSelectedColor}, Dark={StaticResource DarkSurfaceSelectedColor}}" /><Setter Property="BorderWidth" Value="0" /></DataTrigger></Button.Triggers>
                </Button>
                <Button Text="通用" ImageSource="icon_settings.png" Style="{StaticResource BaseButtonStyle}" Command="{Binding ShowGeneralSettingsCommand}">
                    <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding IsGeneralSettings}" Value="True"><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightSurfaceSelectedColor}, Dark={StaticResource DarkSurfaceSelectedColor}}" /><Setter Property="BorderWidth" Value="0" /></DataTrigger></Button.Triggers>
                </Button>
                <Button Text="通知" ImageSource="icon_info.png" Style="{StaticResource BaseButtonStyle}" Command="{Binding ShowNotificationSettingsCommand}">
                    <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding IsNotificationSettings}" Value="True"><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightSurfaceSelectedColor}, Dark={StaticResource DarkSurfaceSelectedColor}}" /><Setter Property="BorderWidth" Value="0" /></DataTrigger></Button.Triggers>
                </Button>
                <Button Text="存储" ImageSource="icon_bookmark.png" Style="{StaticResource BaseButtonStyle}" Command="{Binding ShowStorageSettingsCommand}">
                    <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding IsStorageSettings}" Value="True"><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightSurfaceSelectedColor}, Dark={StaticResource DarkSurfaceSelectedColor}}" /><Setter Property="BorderWidth" Value="0" /></DataTrigger></Button.Triggers>
                </Button>
                <Button Text="账户" ImageSource="icon_contacts.png" Style="{StaticResource BaseButtonStyle}" Command="{Binding ShowAccountSettingsCommand}">
                    <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding IsAccountSettings}" Value="True"><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightSurfaceSelectedColor}, Dark={StaticResource DarkSurfaceSelectedColor}}" /><Setter Property="BorderWidth" Value="0" /></DataTrigger></Button.Triggers>
                </Button>
            </HorizontalStackLayout>
        </ScrollView>

        <ScrollView Grid.Column="2">
            <ScrollView.Triggers>
                <DataTrigger TargetType="ScrollView" Binding="{Binding IsNarrowLayout}" Value="True">
                    <Setter Property="Grid.Column" Value="0" />
                    <Setter Property="Grid.ColumnSpan" Value="3" />
                    <Setter Property="Padding" Value="0,58,0,0" />
                </DataTrigger>
            </ScrollView.Triggers>
            <Grid Padding="34,28,34,42" MaximumWidthRequest="888" HorizontalOptions="Fill">
                <Grid.Triggers>
                    <DataTrigger TargetType="Grid" Binding="{Binding IsNarrowLayout}" Value="True">
                        <Setter Property="Padding" Value="18,20,18,32" />
                    </DataTrigger>
                </Grid.Triggers>
                <VerticalStackLayout IsVisible="{Binding IsAppearanceSettings}" Spacing="20">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="APPEARANCE" TextColor="{StaticResource AccentColor}" FontSize="10" FontAttributes="Bold" CharacterSpacing="3" />
                            <Label Text="外观与布局" Style="{StaticResource BaseLabelStyle}" FontSize="24" FontAttributes="Bold" />
                            <Label Text="这些是设备偏好，不进入 Zulip 业务状态。" Style="{StaticResource MutedLabelStyle}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="恢复默认" Style="{StaticResource BaseButtonStyle}" Command="{Binding ResetUiPreferencesCommand}" />
                    </Grid>

                    <Border Style="{StaticResource CardBorderStyle}" Padding="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                        <VerticalStackLayout Spacing="0">
                            <Grid Padding="16,13" ColumnDefinitions="*,Auto" MinimumHeightRequest="76">
                                <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                                    <Label Text="主题" Style="{StaticResource BaseLabelStyle}" FontAttributes="Bold" />
                                    <Label Text="立即预览浅色或深色外观" Style="{StaticResource MutedLabelStyle}" />
                                </VerticalStackLayout>
                                <HorizontalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="6">
                                    <Button Text="系统" Style="{StaticResource BaseButtonStyle}" Command="{Binding SetSystemThemeCommand}" />
                                    <Button Text="浅色" Style="{StaticResource BaseButtonStyle}" Command="{Binding SetLightThemeCommand}">
                                        <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding IsLightTheme}" Value="True"><Setter Property="BorderColor" Value="{StaticResource AccentColor}" /><Setter Property="BorderWidth" Value="2" /></DataTrigger></Button.Triggers>
                                    </Button>
                                    <Button Text="深色" Style="{StaticResource BaseButtonStyle}" Command="{Binding SetDarkThemeCommand}">
                                        <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding IsDarkTheme}" Value="True"><Setter Property="BorderColor" Value="{StaticResource AccentColor}" /><Setter Property="BorderWidth" Value="2" /></DataTrigger></Button.Triggers>
                                    </Button>
                                </HorizontalStackLayout>
                            </Grid>
                            <BoxView HeightRequest="1" Background="{StaticResource BorderBrush}" />
                            <Grid Padding="16,13" ColumnDefinitions="150,*,Auto" ColumnSpacing="12" MinimumHeightRequest="76">
                                <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                                    <Label Text="正文字号" Style="{StaticResource BaseLabelStyle}" FontAttributes="Bold" />
                                    <Label Text="{Binding CurrentFontSizeLabel}" Style="{StaticResource MutedLabelStyle}" />
                                </VerticalStackLayout>
                                <Slider Grid.Column="1" Minimum="12" Maximum="16" Value="{Binding FontScaleSliderValue, Mode=TwoWay}"
                                        MinimumTrackColor="{StaticResource AccentColor}" MaximumTrackColor="{AppThemeBinding Light={StaticResource LightStrongBorderColor}, Dark={StaticResource DarkStrongBorderColor}}" />
                                <Label Grid.Column="2" Text="Aa" Style="{StaticResource BaseLabelStyle}" FontSize="16" VerticalTextAlignment="Center" />
                            </Grid>
                            <BoxView HeightRequest="1" Background="{StaticResource BorderBrush}" />
                            <Grid Padding="16,13" ColumnDefinitions="150,*,Auto" ColumnSpacing="12" MinimumHeightRequest="76">
                                <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                                    <Label Text="会话栏宽度" Style="{StaticResource BaseLabelStyle}" FontAttributes="Bold" />
                                    <Label Text="{Binding CurrentConversationWidthLabel}" Style="{StaticResource MutedLabelStyle}" />
                                </VerticalStackLayout>
                                <Slider Grid.Column="1" Minimum="264" Maximum="352" Value="{Binding ConversationWidthSliderValue, Mode=TwoWay}"
                                        MinimumTrackColor="{StaticResource AccentColor}" MaximumTrackColor="{AppThemeBinding Light={StaticResource LightStrongBorderColor}, Dark={StaticResource DarkStrongBorderColor}}" />
                                <Label Grid.Column="2" Text="↔" Style="{StaticResource MutedLabelStyle}" VerticalTextAlignment="Center" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout IsVisible="{Binding IsGeneralSettings}" Spacing="20">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="GENERAL" TextColor="{StaticResource AccentColor}" FontSize="10" FontAttributes="Bold" CharacterSpacing="3" />
                        <Label Text="通用" Style="{StaticResource BaseLabelStyle}" FontSize="24" FontAttributes="Bold" />
                        <Label Text="启动行为、语言与系统集成" Style="{StaticResource MutedLabelStyle}" />
                    </VerticalStackLayout>
                    <Border Style="{StaticResource CardBorderStyle}"><Label Text="启动行为和语言尚未进入当前原生能力门；界面不会伪造已保存状态。" Style="{StaticResource BaseLabelStyle}" LineBreakMode="WordWrap" /></Border>
                </VerticalStackLayout>

                <VerticalStackLayout IsVisible="{Binding IsNotificationSettings}" Spacing="20">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="NOTIFICATIONS" TextColor="{StaticResource AccentColor}" FontSize="10" FontAttributes="Bold" CharacterSpacing="3" />
                        <Label Text="通知" Style="{StaticResource BaseLabelStyle}" FontSize="24" FontAttributes="Bold" />
                        <Label Text="系统通知与免打扰" Style="{StaticResource MutedLabelStyle}" />
                    </VerticalStackLayout>
                    <Border Style="{StaticResource CardBorderStyle}" Padding="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                        <VerticalStackLayout Spacing="0">
                            <Grid Padding="16,13" ColumnDefinitions="*,Auto" MinimumHeightRequest="76">
                                <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                                    <Label Text="免打扰" Style="{StaticResource BaseLabelStyle}" FontAttributes="Bold" />
                                    <Label Text="暂停系统横幅和任务栏闪烁，未读红点仍会保留" Style="{StaticResource MutedLabelStyle}" />
                                </VerticalStackLayout>
                                <Switch Grid.Column="1" IsToggled="{Binding DoNotDisturb, Mode=TwoWay}" OnColor="{StaticResource AccentColor}" />
                            </Grid>
                            <BoxView HeightRequest="1" Background="{StaticResource BorderBrush}" />
                            <Grid Padding="16,13" ColumnDefinitions="*,Auto" MinimumHeightRequest="76">
                                <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                                    <Label Text="Windows 系统通知" Style="{StaticResource BaseLabelStyle}" FontAttributes="Bold" />
                                    <Label Text="应用运行时收到其他人的新消息后显示系统横幅" Style="{StaticResource MutedLabelStyle}" />
                                </VerticalStackLayout>
                                <Switch Grid.Column="1" IsToggled="{Binding SystemNotificationsEnabled, Mode=TwoWay}" OnColor="{StaticResource AccentColor}" />
                            </Grid>
                            <BoxView HeightRequest="1" Background="{StaticResource BorderBrush}" />
                            <Grid Padding="16,13" ColumnDefinitions="*,Auto" MinimumHeightRequest="76">
                                <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                                    <Label Text="显示消息内容" Style="{StaticResource BaseLabelStyle}" FontAttributes="Bold" />
                                    <Label Text="关闭后，系统通知只显示收到一条新消息" Style="{StaticResource MutedLabelStyle}" />
                                </VerticalStackLayout>
                                <Switch Grid.Column="1" IsToggled="{Binding ShowMessagePreview, Mode=TwoWay}" IsEnabled="{Binding SystemNotificationsEnabled}" OnColor="{StaticResource AccentColor}" />
                            </Grid>
                            <BoxView HeightRequest="1" Background="{StaticResource BorderBrush}" />
                            <Grid Padding="16,13" ColumnDefinitions="*,Auto" MinimumHeightRequest="76">
                                <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                                    <Label Text="任务栏图标闪烁" Style="{StaticResource BaseLabelStyle}" FontAttributes="Bold" />
                                    <Label Text="消息不在当前可见会话时提醒关注" Style="{StaticResource MutedLabelStyle}" />
                                </VerticalStackLayout>
                                <Switch Grid.Column="1" IsToggled="{Binding TaskbarFlashEnabled, Mode=TwoWay}" OnColor="{StaticResource AccentColor}" />
                            </Grid>
                            <BoxView HeightRequest="1" Background="{StaticResource BorderBrush}" />
                            <Grid Padding="16,13" ColumnDefinitions="*,Auto" MinimumHeightRequest="76">
                                <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                                    <Label Text="任务栏未读红点" Style="{StaticResource BaseLabelStyle}" FontAttributes="Bold" />
                                    <Label Text="显示已知未读数量；只有数量未知时显示新消息标记" Style="{StaticResource MutedLabelStyle}" />
                                </VerticalStackLayout>
                                <Switch Grid.Column="1" IsToggled="{Binding TaskbarBadgeEnabled, Mode=TwoWay}" OnColor="{StaticResource AccentColor}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                    <Border Style="{StaticResource CardBorderStyle}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Windows 状态" Style="{StaticResource BaseLabelStyle}" FontAttributes="Bold" />
                            <Label Text="{Binding SystemNotificationStatus}" Style="{StaticResource MutedLabelStyle}" LineBreakMode="WordWrap" />
                            <Label Text="{Binding TaskbarBadgeStatus}" Style="{StaticResource MutedLabelStyle}" LineBreakMode="WordWrap" />
                            <Label Text="离线或应用未运行时不会后台接收 Zulip 消息；本功能不是推送服务。" Style="{StaticResource MutedLabelStyle}" FontSize="12" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout IsVisible="{Binding IsStorageSettings}" Spacing="20">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="STORAGE" TextColor="{StaticResource AccentColor}" FontSize="10" FontAttributes="Bold" CharacterSpacing="3" />
                        <Label Text="存储" Style="{StaticResource BaseLabelStyle}" FontSize="24" FontAttributes="Bold" />
                        <Label Text="下载位置与当前账户的本地缓存" Style="{StaticResource MutedLabelStyle}" />
                    </VerticalStackLayout>
                    <Border Style="{StaticResource CardBorderStyle}" Padding="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                        <VerticalStackLayout Spacing="0">
                            <Grid Padding="16,13" ColumnDefinitions="*,Auto" ColumnSpacing="12" MinimumHeightRequest="76">
                                <VerticalStackLayout VerticalOptions="Center" Spacing="3">
                                    <Label Text="下载位置" Style="{StaticResource BaseLabelStyle}" FontAttributes="Bold" />
                                    <Label Text="{Binding DownloadFolderPath}"
                                           Style="{StaticResource MutedLabelStyle}"
                                           LineBreakMode="MiddleTruncation"
                                           MaxLines="2" />
                                </VerticalStackLayout>
                                <HorizontalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="6">
                                    <Button Text="更改位置" Style="{StaticResource BaseButtonStyle}" Command="{Binding ChangeDownloadFolderCommand}" />
                                    <Button Text="打开文件夹" Style="{StaticResource BaseButtonStyle}" Command="{Binding OpenDownloadFolderCommand}" />
                                </HorizontalStackLayout>
                            </Grid>
                            <BoxView HeightRequest="1" Background="{StaticResource BorderBrush}" />
                            <Grid Padding="16,13" ColumnDefinitions="*,Auto" MinimumHeightRequest="76">
                                <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                                    <Label Text="每次下载前询问保存位置" Style="{StaticResource BaseLabelStyle}" FontAttributes="Bold" />
                                    <Label Text="关闭时，文件会自动保存到上方目录；同名文件不会覆盖" Style="{StaticResource MutedLabelStyle}" />
                                </VerticalStackLayout>
                                <Switch Grid.Column="1"
                                        IsToggled="{Binding AskWhereToSaveDownloads, Mode=TwoWay}"
                                        OnColor="{StaticResource AccentColor}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                    <Label Text="{Binding DownloadSettingsStatus}"
                           IsVisible="{Binding HasDownloadSettingsStatus}"
                           Style="{StaticResource MutedLabelStyle}" />
                    <Border Style="{StaticResource CardBorderStyle}">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="SQLite 是本地缓存，不是第二消息后端，也不等同磁盘加密。" Style="{StaticResource BaseLabelStyle}" LineBreakMode="WordWrap" />
                            <HorizontalStackLayout Spacing="8">
                                <Button Text="清除当前账号缓存" Style="{StaticResource BaseButtonStyle}" Command="{Binding RequestClearCacheCommand}" />
                                <Button Text="确认清除" Style="{StaticResource PrimaryButtonStyle}" IsVisible="{Binding ClearCacheConfirmationVisible}" Command="{Binding ConfirmClearCacheCommand}" />
                                <Button Text="取消" Style="{StaticResource BaseButtonStyle}" IsVisible="{Binding ClearCacheConfirmationVisible}" Command="{Binding CancelClearCacheCommand}" />
                            </HorizontalStackLayout>
                            <Label Text="只删除经过账号路径校验的本地缓存，不删除服务端消息。"
                                   IsVisible="{Binding ClearCacheConfirmationVisible}" Style="{StaticResource DangerLabelStyle}" FontSize="12" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout IsVisible="{Binding IsAccountSettings}" Spacing="20">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="ACCOUNT" TextColor="{StaticResource AccentColor}" FontSize="10" FontAttributes="Bold" CharacterSpacing="3" />
                        <Label Text="账户" Style="{StaticResource BaseLabelStyle}" FontSize="24" FontAttributes="Bold" />
                        <Label Text="当前 Zulip 会话" Style="{StaticResource MutedLabelStyle}" />
                    </VerticalStackLayout>
                    <Border Style="{StaticResource CardBorderStyle}">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="{Binding CurrentUserDisplayName}" Style="{StaticResource BaseLabelStyle}" FontAttributes="Bold" />
                            <Label Text="{Binding Realm, StringFormat='Realm：{0}'}" Style="{StaticResource BaseLabelStyle}" />
                            <Label Text="API Key 与密码不会在设置、日志或异常中显示。" Style="{StaticResource MutedLabelStyle}" />
                            <Button Text="注销" HorizontalOptions="Start" Style="{StaticResource BaseButtonStyle}" Command="{Binding RequestLogoutCommand}" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </Grid>
        </ScrollView>
    </Grid>
</ContentView>
