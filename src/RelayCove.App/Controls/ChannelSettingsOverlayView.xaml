<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:RelayCove.App.ViewModels"
             x:Class="RelayCove.App.Controls.ChannelSettingsOverlayView"
             x:Name="Root"
             x:DataType="viewModels:ChannelSettingsViewModel">
    <Grid IsVisible="{Binding IsOpen}">
        <BoxView Background="{StaticResource OverlayBrush}">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseTopLayerCommand}" />
            </BoxView.GestureRecognizers>
        </BoxView>
        <Border Margin="20" Background="{StaticResource SurfaceBrush}" Stroke="{StaticResource StrongBorderBrush}" StrokeThickness="1">
            <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
            <Grid RowDefinitions="58,*">
                <Grid Padding="20,0" ColumnDefinitions="Auto,*,Auto" Background="{StaticResource SurfaceSoftBrush}">
                    <Button Text="‹" IsVisible="{Binding IsNarrowDetailVisible}" Command="{Binding BackToListCommand}" Style="{StaticResource IconButtonStyle}" />
                    <Label Grid.Column="1" Text="频道" Style="{StaticResource BaseLabelStyle}" FontSize="20" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                    <Button x:Name="CloseButton" Grid.Column="2" Text="×" Style="{StaticResource IconButtonStyle}" Command="{Binding CloseCommand}" SemanticProperties.Description="关闭频道设置" />
                </Grid>
                <Grid Grid.Row="1" ColumnSpacing="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding ListPaneWidth}" />
                        <ColumnDefinition Width="{Binding DetailPaneWidth}" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" IsVisible="{Binding IsDesktopListVisible}" RowDefinitions="Auto,Auto,*" Background="{StaticResource GroundBrush}">
                        <Grid Padding="12,10" ColumnDefinitions="*,*,*" ColumnSpacing="6">
                            <Button Text="已订阅" Command="{Binding SetSubscribedModeCommand}" Style="{StaticResource BaseButtonStyle}" />
                            <Button Grid.Column="1" Text="可用" Command="{Binding SetAvailableModeCommand}" Style="{StaticResource BaseButtonStyle}" />
                            <Button Grid.Column="2" Text="全部" Command="{Binding SetAllModeCommand}" Style="{StaticResource BaseButtonStyle}" />
                        </Grid>
                        <VerticalStackLayout Grid.Row="1" Padding="12,0,12,8" Spacing="6">
                            <Entry Text="{Binding SearchText}" Placeholder="搜索" Style="{StaticResource BaseEntryStyle}" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                                <Picker ItemsSource="{Binding ArchiveFilterOptions}" SelectedIndex="{Binding ArchiveFilterIndex}" Title="归档" />
                                <Picker Grid.Column="1" ItemsSource="{Binding SortOptions}" SelectedIndex="{Binding SortIndex}" Title="排序" />
                            </Grid>
                        </VerticalStackLayout>
                        <Grid Grid.Row="2">
                            <CollectionView ItemsSource="{Binding FilteredChannels}" SelectionMode="None">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:ChannelSettingsChannelItem">
                                        <Border Padding="14,10" StrokeThickness="0">
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource SurfaceSelectedBrush}" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding BindingContext.SelectChannelCommand, Source={x:Reference Root}}" CommandParameter="{Binding .}" /></Border.GestureRecognizers>
                                            <Grid ColumnDefinitions="30,30,*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="7">
                                                <Button Text="{Binding SubscriptionGlyph}"
                                                        WidthRequest="28"
                                                        HeightRequest="28"
                                                        Padding="0"
                                                        Command="{Binding BindingContext.ChangeChannelSubscriptionCommand, Source={x:Reference Root}}"
                                                        CommandParameter="{Binding .}"
                                                        Style="{StaticResource IconButtonStyle}" />
                                                <Label Grid.Column="1" Text="{Binding PrivacyGlyph}" TextColor="{Binding Color}" FontSize="21" FontAttributes="Bold" VerticalTextAlignment="Center" />
                                                <Label Grid.Column="2" Text="{Binding Name}" Style="{StaticResource BaseLabelStyle}" FontAttributes="Bold" FontSize="16" LineBreakMode="TailTruncation" />
                                                <Label Grid.Column="3" Text="{Binding SubscriberLabel}" Style="{StaticResource MutedLabelStyle}" FontSize="11" />
                                                <Label Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Text="{Binding DescriptionLabel}" Style="{StaticResource MutedLabelStyle}" LineBreakMode="TailTruncation" />
                                                <Label Grid.Row="2" Grid.Column="2" Text="{Binding TrafficLabel}" Style="{StaticResource MutedLabelStyle}" FontSize="11" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                            <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Grid>
                    </Grid>
                    <Grid Grid.Column="0" IsVisible="{Binding IsNarrowListVisible}" RowDefinitions="Auto,Auto,Auto,*" Background="{StaticResource GroundBrush}">
                        <Grid Padding="12,10" ColumnDefinitions="*,*,*" ColumnSpacing="6">
                            <Button Text="已订阅" Command="{Binding SetSubscribedModeCommand}" Style="{StaticResource BaseButtonStyle}" />
                            <Button Grid.Column="1" Text="可用" Command="{Binding SetAvailableModeCommand}" Style="{StaticResource BaseButtonStyle}" />
                            <Button Grid.Column="2" Text="全部" Command="{Binding SetAllModeCommand}" Style="{StaticResource BaseButtonStyle}" />
                        </Grid>
                        <Entry Grid.Row="1" Margin="12,0,12,8" Text="{Binding SearchText}" Placeholder="搜索" Style="{StaticResource BaseEntryStyle}" />
                        <Grid Grid.Row="2" Margin="12,0,12,8" ColumnDefinitions="*,*" ColumnSpacing="6">
                            <Picker ItemsSource="{Binding ArchiveFilterOptions}" SelectedIndex="{Binding ArchiveFilterIndex}" Title="归档" />
                            <Picker Grid.Column="1" ItemsSource="{Binding SortOptions}" SelectedIndex="{Binding SortIndex}" Title="排序" />
                        </Grid>
                        <CollectionView Grid.Row="3" ItemsSource="{Binding FilteredChannels}" SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:ChannelSettingsChannelItem">
                                    <Grid Padding="10,4" ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                        <Button Text="{Binding SubscriptionGlyph}"
                                                WidthRequest="32"
                                                Command="{Binding BindingContext.ChangeChannelSubscriptionCommand, Source={x:Reference Root}}"
                                                CommandParameter="{Binding .}"
                                                Style="{StaticResource IconButtonStyle}" />
                                        <Button Grid.Column="1"
                                                Text="{Binding Name}"
                                                HorizontalOptions="Fill"
                                                Command="{Binding BindingContext.SelectChannelCommand, Source={x:Reference Root}}"
                                                CommandParameter="{Binding .}"
                                                Style="{StaticResource BaseButtonStyle}" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Grid>
                    <ScrollView Grid.Column="1" IsVisible="{Binding IsDesktopDetailVisible}">
                        <VerticalStackLayout Padding="28,22" Spacing="14">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                                <VerticalStackLayout><Label Text="{Binding PrivacyLabel}" Style="{StaticResource MutedLabelStyle}" /><Label Text="{Binding SelectedName}" Style="{StaticResource BaseLabelStyle}" FontSize="24" FontAttributes="Bold" /></VerticalStackLayout>
                                <Button Grid.Column="1" Text="编辑" Command="{Binding BeginEditNameCommand}" IsEnabled="{Binding CanAdminister}" Style="{StaticResource BaseButtonStyle}" />
                                <Button Grid.Column="2" Text="前往频道" Command="{Binding ViewChannelCommand}" Style="{StaticResource BaseButtonStyle}" />
                                <Button Grid.Column="3" Text="{Binding SubscriptionActionLabel}" Command="{Binding ChangeSubscriptionCommand}" IsEnabled="{Binding CanChangeSubscription}" Style="{StaticResource BaseButtonStyle}" />
                                <Button Grid.Column="4" Text="归档" Command="{Binding RequestArchiveCommand}" IsEnabled="{Binding CanArchive}" Style="{StaticResource BaseButtonStyle}" />
                            </Grid>
                            <Border Padding="16,8" HorizontalOptions="Start" Background="{StaticResource SurfaceSelectedBrush}" StrokeThickness="0">
                                <Label Text="General" Style="{StaticResource BaseLabelStyle}" FontAttributes="Bold" />
                            </Border>
                            <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="说明" Style="{StaticResource MutedLabelStyle}" /><Label Text="{Binding DescriptionLabel}" Style="{StaticResource BaseLabelStyle}" /></VerticalStackLayout><Button Grid.Column="1" Text="编辑" Command="{Binding BeginEditDescriptionCommand}" IsEnabled="{Binding CanAdminister}" Style="{StaticResource BaseButtonStyle}" /></Grid>
                            <Label Text="{Binding CreatorLabel}" Style="{StaticResource MutedLabelStyle}" />
                            <Label Text="{Binding DateLabel}" Style="{StaticResource MutedLabelStyle}" />
                            <Label Text="{Binding ChannelIdLabel}" Style="{StaticResource MutedLabelStyle}" />
                            <BoxView HeightRequest="1" Background="{StaticResource BorderBrush}" />
                            <Label Text="设置" Style="{StaticResource BaseLabelStyle}" FontSize="21" FontAttributes="Bold" />
                            <Label Text="频道文件夹" Style="{StaticResource BaseLabelStyle}" />
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="7"><Picker ItemsSource="{Binding Folders}" ItemDisplayBinding="{Binding Name}" SelectedItem="{Binding DraftFolder, Mode=TwoWay}" IsEnabled="{Binding CanAdminister}" /><Button Grid.Column="1" Text="清除" Command="{Binding ClearFolderCommand}" IsEnabled="{Binding CanAdminister}" Style="{StaticResource BaseButtonStyle}" /><Button Grid.Column="2" Text="取消" Command="{Binding CancelFolderCommand}" IsEnabled="{Binding IsFolderDirty}" Style="{StaticResource BaseButtonStyle}" /><Button Grid.Column="3" Text="保存" Command="{Binding SaveFolderCommand}" IsEnabled="{Binding CanSaveFolder}" Style="{StaticResource PrimaryButtonStyle}" /><Button Grid.Column="4" Text="新建文件夹" Command="{Binding OpenCreateFolderCommand}" IsEnabled="{Binding CanCreateFolder}" Style="{StaticResource BaseButtonStyle}" /></Grid>
                            <Label Text="频道邮件地址" Style="{StaticResource BaseLabelStyle}" />
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="7"><Label Text="{Binding EmailAddress}" Style="{StaticResource MutedLabelStyle}" VerticalTextAlignment="Center" LineBreakMode="TailTruncation" /><Button Grid.Column="1" Text="获取" Command="{Binding FetchEmailCommand}" IsEnabled="{Binding CanFetchEmail}" Style="{StaticResource BaseButtonStyle}" /><Button Grid.Column="2" Text="复制" Command="{Binding CopyEmailCommand}" IsEnabled="{Binding HasEmailAddress}" Style="{StaticResource BaseButtonStyle}" /></Grid>
                            <Label Text="{Binding Error}" IsVisible="{Binding HasError}" Style="{StaticResource DangerLabelStyle}" />
                        </VerticalStackLayout>
                    </ScrollView>
                    <ScrollView Grid.Column="1" IsVisible="{Binding IsNarrowDetailVisible}"><VerticalStackLayout Padding="20" Spacing="12"><Label Text="{Binding PrivacyLabel}" Style="{StaticResource MutedLabelStyle}" /><Label Text="{Binding SelectedName}" Style="{StaticResource BaseLabelStyle}" FontSize="22" FontAttributes="Bold" /><Border Padding="14,7" HorizontalOptions="Start" Background="{StaticResource SurfaceSelectedBrush}" StrokeThickness="0"><Label Text="General" Style="{StaticResource BaseLabelStyle}" FontAttributes="Bold" /></Border><Grid ColumnDefinitions="*,*,*" ColumnSpacing="7"><Button Text="编辑名称" Command="{Binding BeginEditNameCommand}" IsEnabled="{Binding CanAdminister}" Style="{StaticResource BaseButtonStyle}" /><Button Grid.Column="1" Text="{Binding SubscriptionActionLabel}" Command="{Binding ChangeSubscriptionCommand}" IsEnabled="{Binding CanChangeSubscription}" Style="{StaticResource BaseButtonStyle}" /><Button Grid.Column="2" Text="前往频道" Command="{Binding ViewChannelCommand}" Style="{StaticResource BaseButtonStyle}" /></Grid><Label Text="说明" Style="{StaticResource MutedLabelStyle}" /><Label Text="{Binding DescriptionLabel}" Style="{StaticResource BaseLabelStyle}" /><Button Text="编辑说明" Command="{Binding BeginEditDescriptionCommand}" IsEnabled="{Binding CanAdminister}" Style="{StaticResource BaseButtonStyle}" HorizontalOptions="Start" /><Label Text="{Binding CreatorLabel}" Style="{StaticResource MutedLabelStyle}" /><Label Text="{Binding DateLabel}" Style="{StaticResource MutedLabelStyle}" /><Label Text="{Binding ChannelIdLabel}" Style="{StaticResource MutedLabelStyle}" /><Label Text="频道文件夹" Style="{StaticResource BaseLabelStyle}" /><Grid ColumnDefinitions="*,Auto,Auto,Auto"><Picker ItemsSource="{Binding Folders}" ItemDisplayBinding="{Binding Name}" SelectedItem="{Binding DraftFolder, Mode=TwoWay}" IsEnabled="{Binding CanAdminister}" /><Button Grid.Column="1" Text="取消" Command="{Binding CancelFolderCommand}" IsEnabled="{Binding IsFolderDirty}" Style="{StaticResource BaseButtonStyle}" /><Button Grid.Column="2" Text="保存" Command="{Binding SaveFolderCommand}" IsEnabled="{Binding CanSaveFolder}" Style="{StaticResource PrimaryButtonStyle}" /><Button Grid.Column="3" Text="新建" Command="{Binding OpenCreateFolderCommand}" IsEnabled="{Binding CanCreateFolder}" Style="{StaticResource BaseButtonStyle}" /></Grid><Label Text="频道邮件地址" Style="{StaticResource BaseLabelStyle}" /><Grid ColumnDefinitions="*,Auto,Auto"><Label Text="{Binding EmailAddress}" Style="{StaticResource MutedLabelStyle}" /><Button Grid.Column="1" Text="获取" Command="{Binding FetchEmailCommand}" IsEnabled="{Binding CanFetchEmail}" Style="{StaticResource BaseButtonStyle}" /><Button Grid.Column="2" Text="复制" Command="{Binding CopyEmailCommand}" IsEnabled="{Binding HasEmailAddress}" Style="{StaticResource BaseButtonStyle}" /></Grid><Button Text="归档频道" Command="{Binding RequestArchiveCommand}" IsEnabled="{Binding CanArchive}" Style="{StaticResource BaseButtonStyle}" HorizontalOptions="Start" /><Label Text="{Binding Error}" IsVisible="{Binding HasError}" Style="{StaticResource DangerLabelStyle}" /></VerticalStackLayout></ScrollView>
                </Grid>
            </Grid>
        </Border>
        <Grid IsVisible="{Binding IsEditDialogOpen}"><BoxView Background="{StaticResource OverlayBrush}"><BoxView.GestureRecognizers><TapGestureRecognizer Command="{Binding CloseTopLayerCommand}" /></BoxView.GestureRecognizers></BoxView><Border Style="{StaticResource DialogBorderStyle}" MaximumWidthRequest="480"><VerticalStackLayout Spacing="12"><Label Text="{Binding EditLabel}" Style="{StaticResource BaseLabelStyle}" FontSize="18" FontAttributes="Bold" /><Editor x:Name="EditValueEditor" Text="{Binding EditValue}" AutoSize="TextChanges" MinimumHeightRequest="90" /><Label Text="{Binding EditError}" Style="{StaticResource DangerLabelStyle}" /><HorizontalStackLayout HorizontalOptions="End" Spacing="8"><Button Text="取消" Command="{Binding CancelEditCommand}" Style="{StaticResource BaseButtonStyle}" /><Button Text="保存" Command="{Binding SaveEditCommand}" IsEnabled="{Binding CanSaveEdit}" Style="{StaticResource PrimaryButtonStyle}" /></HorizontalStackLayout></VerticalStackLayout></Border></Grid>
        <Grid IsVisible="{Binding IsCreateFolderOpen}"><BoxView Background="{StaticResource OverlayBrush}"><BoxView.GestureRecognizers><TapGestureRecognizer Command="{Binding CloseTopLayerCommand}" /></BoxView.GestureRecognizers></BoxView><Border Style="{StaticResource DialogBorderStyle}" MaximumWidthRequest="480"><VerticalStackLayout Spacing="12"><Label Text="新建频道文件夹" Style="{StaticResource BaseLabelStyle}" FontSize="18" FontAttributes="Bold" /><Entry x:Name="NewFolderNameEntry" Text="{Binding NewFolderName}" Placeholder="文件夹名称" /><Entry Text="{Binding NewFolderDescription}" Placeholder="说明（可选）" /><Label Text="{Binding EditError}" Style="{StaticResource DangerLabelStyle}" /><HorizontalStackLayout HorizontalOptions="End" Spacing="8"><Button Text="取消" Command="{Binding CancelCreateFolderCommand}" Style="{StaticResource BaseButtonStyle}" /><Button Text="创建" Command="{Binding CreateFolderCommand}" IsEnabled="{Binding CanCreateNewFolder}" Style="{StaticResource PrimaryButtonStyle}" /></HorizontalStackLayout></VerticalStackLayout></Border></Grid>
        <Grid IsVisible="{Binding IsConfirmationOpen}"><BoxView Background="{StaticResource OverlayBrush}"><BoxView.GestureRecognizers><TapGestureRecognizer Command="{Binding CloseTopLayerCommand}" /></BoxView.GestureRecognizers></BoxView><Border Style="{StaticResource DialogBorderStyle}" MaximumWidthRequest="460"><VerticalStackLayout Spacing="12"><Label Text="{Binding ConfirmationText}" Style="{StaticResource BaseLabelStyle}" LineBreakMode="WordWrap" /><HorizontalStackLayout HorizontalOptions="End" Spacing="8"><Button x:Name="ConfirmationCancelButton" Text="取消" Command="{Binding CancelConfirmationCommand}" Style="{StaticResource BaseButtonStyle}" /><Button Text="确认" Command="{Binding ConfirmCommand}" Style="{StaticResource BaseButtonStyle}" /></HorizontalStackLayout></VerticalStackLayout></Border></Grid>
    </Grid>
</ContentView>
