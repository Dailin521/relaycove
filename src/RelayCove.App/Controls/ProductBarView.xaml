<?xml version="1.0" encoding="utf-8" ?>
<TitleBar xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
          xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
          xmlns:controls="clr-namespace:RelayCove.App.Controls"
          xmlns:windowsBehaviors="clr-namespace:RelayCove.App.Platforms.Windows.Behaviors"
          xmlns:viewModels="clr-namespace:RelayCove.App.ViewModels"
          x:Class="RelayCove.App.Controls.ProductBarView"
          x:Name="Root"
          x:DataType="viewModels:ShellViewModel"
          Title="RichChat"
          HeightRequest="{StaticResource ProductBarHeight}"
          BackgroundColor="{AppThemeBinding Light={StaticResource LightGroundColor}, Dark={StaticResource DarkGroundColor}}"
          ForegroundColor="{AppThemeBinding Light={StaticResource LightTextColor}, Dark={StaticResource DarkTextColor}}">
    <TitleBar.LeadingContent>
        <Border x:Name="AccountButtonBorder"
                WidthRequest="30"
                HeightRequest="30"
                Padding="0"
                Margin="8,1,0,1"
                IsVisible="{Binding MainVisible}"
                Background="{StaticResource AccentBrush}"
                Stroke="Transparent"
                StrokeThickness="0"
                SemanticProperties.Description="{Binding CurrentUserDisplayName, StringFormat='账户 {0}'}">
            <Border.StrokeShape><RoundRectangle CornerRadius="15" /></Border.StrokeShape>
            <Grid>
                <Label x:Name="AccountInitialLabel"
                       Text="{Binding CurrentUserInitial}"
                       Style="{StaticResource BaseLabelStyle}"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center" />
                <controls:RealmMediaImageView x:Name="AccountAvatar"
                                              SourceUrl="{Binding CurrentUserAvatarUrl}"
                                              MediaKind="Avatar"
                                              Aspect="AspectFill"
                                              ShowFailureText="False" />
                <Button x:Name="AccountButton"
                        BackgroundColor="Transparent"
                        BorderWidth="0"
                        Padding="0"
                        Command="{Binding ToggleAccountMenuCommand}"
                        SemanticProperties.Description="打开账户菜单" />
                <Border x:Name="ProductBarOwnPresenceDot"
                        WidthRequest="10"
                        HeightRequest="10"
                        Padding="0"
                        Margin="0,0,1,1"
                        HorizontalOptions="End"
                        VerticalOptions="End"
                        InputTransparent="True"
                        IsVisible="{Binding HasOwnPresenceStatus}"
                        Background="{Binding OwnPresenceBrush}"
                        Stroke="{StaticResource GroundBrush}"
                        StrokeThickness="2"
                        SemanticProperties.Description="{Binding OwnPresenceLabel, StringFormat='我的状态 {0}'}">
                    <Border.StrokeShape><RoundRectangle CornerRadius="5" /></Border.StrokeShape>
                </Border>
            </Grid>
            <Border.Triggers>
                <DataTrigger TargetType="Border"
                             Binding="{Binding IsAccountMenuOpen, Source={x:Reference Root}, x:DataType=controls:ProductBarView}"
                             Value="True">
                    <Setter Property="Stroke" Value="{StaticResource AccentStrongColor}" />
                    <Setter Property="StrokeThickness" Value="2" />
                </DataTrigger>
            </Border.Triggers>
        </Border>
    </TitleBar.LeadingContent>

    <TitleBar.Content>
        <Border x:Name="ConnectionStatusBorder"
                Padding="9,3"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                IsVisible="{Binding ShowConnectionStatus}"
                Background="{StaticResource SurfaceSoftBrush}"
                Stroke="{StaticResource BorderBrush}"
                StrokeThickness="1">
            <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
            <Label x:Name="ConnectionStatusLabel"
                   Style="{StaticResource MutedLabelStyle}"
                   FontSize="11"
                   VerticalTextAlignment="Center" />
        </Border>
    </TitleBar.Content>

    <TitleBar.TrailingContent>
        <HorizontalStackLayout Spacing="6">
            <Grid WidthRequest="32"
                  HeightRequest="32"
                  IsVisible="{Binding MainVisible}">
                <ImageButton x:Name="DownloadButton"
                             Source="icon_download.png"
                             Style="{StaticResource ProductBarImageButtonStyle}"
                             WidthRequest="32"
                             HeightRequest="32"
                             Padding="8"
                             ToolTipProperties.Text="{Binding DownloadButtonDescription}"
                             SemanticProperties.Description="{Binding DownloadButtonDescription}">
                    <ImageButton.Behaviors>
                        <windowsBehaviors:ProductBarButtonBehavior />
                    </ImageButton.Behaviors>
                </ImageButton>
                <Border x:Name="CompletedDownloadDot"
                        WidthRequest="8"
                        HeightRequest="8"
                        Margin="0,3,3,0"
                        Padding="0"
                        HorizontalOptions="End"
                        VerticalOptions="Start"
                        IsVisible="False"
                        Background="{StaticResource AccentBrush}"
                        Stroke="{StaticResource GroundBrush}"
                        StrokeThickness="1"
                        InputTransparent="True"
                        SemanticProperties.Description="存在未查看的下载完成">
                    <Border.StrokeShape><RoundRectangle CornerRadius="4" /></Border.StrokeShape>
                </Border>
                <Border x:Name="FailedDownloadDot"
                        WidthRequest="8"
                        HeightRequest="8"
                        Margin="0,3,3,0"
                        Padding="0"
                        HorizontalOptions="End"
                        VerticalOptions="Start"
                        IsVisible="False"
                        Background="{StaticResource DangerBrush}"
                        Stroke="{StaticResource GroundBrush}"
                        StrokeThickness="1"
                        InputTransparent="True"
                        SemanticProperties.Description="存在未查看的下载失败">
                    <Border.StrokeShape><RoundRectangle CornerRadius="4" /></Border.StrokeShape>
                </Border>
            </Grid>
            <ImageButton x:Name="SettingsButton"
                         Source="icon_settings.png"
                         Style="{StaticResource ProductBarImageButtonStyle}"
                         WidthRequest="32"
                         HeightRequest="32"
                         Padding="8"
                         IsVisible="{Binding MainVisible}"
                         SemanticProperties.Description="打开或关闭设置">
                <ImageButton.Behaviors>
                    <windowsBehaviors:ProductBarButtonBehavior />
                </ImageButton.Behaviors>
            </ImageButton>
            <ImageButton x:Name="ThemeButton"
                         Source="icon_moon.png"
                         Style="{StaticResource ProductBarImageButtonStyle}"
                         WidthRequest="32"
                         HeightRequest="32"
                         Padding="8"
                         SemanticProperties.Description="切换浅色或深色主题">
                <ImageButton.Behaviors>
                    <windowsBehaviors:ProductBarButtonBehavior />
                </ImageButton.Behaviors>
            </ImageButton>
            <ImageButton Source="icon_pin.png"
                         Style="{StaticResource ProductBarImageButtonStyle}"
                         WidthRequest="32"
                         HeightRequest="32"
                         Padding="8"
                         Clicked="OnPinClicked"
                         SemanticProperties.Description="置顶窗口">
                <ImageButton.Behaviors>
                    <windowsBehaviors:ProductBarButtonBehavior />
                </ImageButton.Behaviors>
            </ImageButton>
        </HorizontalStackLayout>
    </TitleBar.TrailingContent>
</TitleBar>
