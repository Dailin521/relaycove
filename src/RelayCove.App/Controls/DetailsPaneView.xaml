<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:RelayCove.App.Controls"
             xmlns:viewModels="clr-namespace:RelayCove.App.ViewModels"
             xmlns:windowsBehaviors="clr-namespace:RelayCove.App.Platforms.Windows.Behaviors"
             x:Class="RelayCove.App.Controls.DetailsPaneView"
             x:Name="Root"
             x:DataType="viewModels:ShellViewModel"
             Background="{StaticResource SurfaceSoftBrush}">
    <Grid RowDefinitions="59,1,*">
        <Grid Grid.Row="0" ColumnDefinitions="*,39" Padding="15,0,10,0">
            <Label Text="详情"
                   Style="{StaticResource BaseLabelStyle}"
                   FontSize="15"
                   FontAttributes="Bold"
                   VerticalTextAlignment="Center" />
            <Button x:Name="CloseButton"
                    Grid.Column="1"
                    Text=""
                    ImageSource="icon_close.png"
                    Style="{StaticResource IconButtonStyle}"
                    WidthRequest="39"
                    HeightRequest="39"
                    Command="{Binding ToggleDetailsCommand}"
                    SemanticProperties.Description="收起详情">
                <Button.Behaviors>
                    <windowsBehaviors:EscapeCommandBehavior
                        Command="{Binding ViewModel.ToggleDetailsCommand, Source={x:Reference Root}, x:DataType=controls:DetailsPaneView}"
                        TrapFocus="{Binding IsModal, Source={x:Reference Root}, x:DataType=controls:DetailsPaneView}" />
                </Button.Behaviors>
            </Button>
        </Grid>
        <BoxView Grid.Row="1" Background="{StaticResource BorderBrush}" />

        <ScrollView Grid.Row="2">
            <VerticalStackLayout Spacing="0">
                <VerticalStackLayout Padding="16,15" Spacing="7">
                    <Label Text="{Binding DetailsKindLabel}" Style="{StaticResource SectionHeaderStyle}" />
                    <Label Text="{Binding DetailsTitle}"
                           Style="{StaticResource BaseLabelStyle}"
                           FontSize="18"
                           FontAttributes="Bold" />
                    <Label Text="{Binding DetailsBody}"
                           Style="{StaticResource MutedLabelStyle}"
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>

                <BoxView HeightRequest="1" Background="{StaticResource BorderBrush}" />

                <VerticalStackLayout Padding="16,15" Spacing="8">
                    <Label Text="会话状态" Style="{StaticResource SectionHeaderStyle}" />
                    <Grid ColumnDefinitions="32,*" ColumnSpacing="10">
                        <Border WidthRequest="32" HeightRequest="32" Padding="0" Background="{StaticResource SurfaceSelectedBrush}" StrokeThickness="0">
                            <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                            <Label Text="{Binding DetailsGlyph}" Style="{StaticResource MutedLabelStyle}" FontAttributes="Bold"
                                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                            <Label Text="{Binding DetailsIdentifierLabel}" Style="{StaticResource BaseLabelStyle}" FontAttributes="Bold" LineBreakMode="WordWrap" />
                            <Label Text="{Binding DetailsStateLabel}" Style="{StaticResource MutedLabelStyle}" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>

                <BoxView HeightRequest="1" Background="{StaticResource BorderBrush}" />

                <VerticalStackLayout Padding="16,15" Spacing="7">
                    <Label Text="已接通能力" Style="{StaticResource SectionHeaderStyle}" />
                    <Label Text="{Binding DetailsAvailableMessage}"
                           Style="{StaticResource BaseLabelStyle}"
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>

                <VerticalStackLayout Padding="16,15" Spacing="7">
                    <Label Text="能力边界" Style="{StaticResource SectionHeaderStyle}" />
                    <Label Text="{Binding DetailsUnavailableMessage}"
                           Style="{StaticResource MutedLabelStyle}"
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>

                <VerticalStackLayout Padding="16,4,16,18"
                                     Spacing="8"
                                     IsVisible="{Binding ShowChannelDetails}">
                    <BoxView HeightRequest="1" Background="{StaticResource BorderBrush}" />
                    <Label Text="连接 Zulip 并确认频道订阅状态后可使用下列写操作。"
                           IsVisible="{Binding ShowChannelActionBoundary}"
                           Style="{StaticResource MutedLabelStyle}"
                           LineBreakMode="WordWrap" />
                    <Button Text="{Binding SelectedChannelMuteLabel}"
                            Style="{StaticResource BaseButtonStyle}"
                            Command="{Binding ToggleSelectedChannelMutedCommand}"
                            IsEnabled="{Binding CanManageSelectedChannel}"
                            SemanticProperties.Description="切换当前频道静音" />
                    <Button Text="{Binding SelectedChannelPinLabel}"
                            Style="{StaticResource BaseButtonStyle}"
                            Command="{Binding ToggleSelectedChannelPinnedCommand}"
                            IsEnabled="{Binding CanManageSelectedChannel}"
                            SemanticProperties.Description="切换当前频道置顶" />
                    <Button x:Name="UnsubscribeButton"
                            Text="退出频道"
                            Style="{StaticResource BaseButtonStyle}"
                            TextColor="{StaticResource DangerColor}"
                            Command="{Binding RequestChannelUnsubscribeCommand}"
                            IsEnabled="{Binding CanUnsubscribeSelectedChannel}"
                            SemanticProperties.Description="退出当前频道" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentView>
