<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:RelayCove.App.ViewModels"
             x:Class="RelayCove.App.Controls.ChatHeaderView"
             x:DataType="viewModels:ShellViewModel"
             Background="{StaticResource SurfaceBrush}">
    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto"
          Padding="12,8"
          ColumnSpacing="8">
        <Button Grid.Column="0"
                Text="‹"
                Style="{StaticResource IconButtonStyle}"
                Command="{Binding BackToConversationListCommand}"
                IsVisible="{Binding IsNarrowLayout}"
                SemanticProperties.Description="返回会话列表" />

        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
            <Label Text="{Binding ConversationTitle}"
                   Style="{StaticResource BaseLabelStyle}"
                   FontSize="16"
                   FontAttributes="Bold" />
            <Label Text="{Binding ConversationSubtitle}"
                   Style="{StaticResource MutedLabelStyle}" />
        </VerticalStackLayout>

        <Button Grid.Column="2"
                Text="已读"
                Style="{StaticResource BaseButtonStyle}"
                Command="{Binding MarkReadCommand}"
                IsEnabled="{Binding CanMarkRead}"
                SemanticProperties.Description="标记当前显示页已读；仅服务器确认后更新" />
        <Button Grid.Column="3"
                Text="⌕"
                Style="{StaticResource IconButtonStyle}"
                Command="{Binding OpenSearchCommand}"
                SemanticProperties.Description="搜索当前已加载工作区" />
        <Button x:Name="DetailsButton"
                Grid.Column="4"
                Text="ⓘ"
                Style="{StaticResource IconButtonStyle}"
                Command="{Binding ToggleDetailsCommand}"
                IsEnabled="{Binding HasSelectedConversation}"
                SemanticProperties.Description="{Binding DetailsButtonDescription}" />
    </Grid>
</ContentView>
