<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:RelayCove.App.Controls"
             xmlns:viewModels="clr-namespace:RelayCove.App.ViewModels"
             xmlns:windowsBehaviors="clr-namespace:RelayCove.App.Platforms.Windows.Behaviors"
             x:Class="RelayCove.App.Controls.MessageListView"
             x:Name="Root"
             x:DataType="viewModels:ShellViewModel"
             IsClippedToBounds="True"
             Background="{StaticResource SurfaceBrush}">
    <Grid RowDefinitions="Auto,Auto,*">
        <HorizontalStackLayout Grid.Row="0"
                               Margin="18,8,18,0"
                               Spacing="8"
                               HorizontalOptions="Center"
                               IsVisible="{Binding ShowLoadOlderButton}">
            <Button Text="加载更早消息"
                    Style="{StaticResource BaseButtonStyle}"
                    HeightRequest="30"
                    MinimumHeightRequest="30"
                    FontSize="11"
                    Command="{Binding LoadOlderCommand}"
                    IsEnabled="{Binding HasSelectedConversation}"
                    SemanticProperties.Description="加载更早的 50 条消息" />
            <ActivityIndicator IsVisible="{Binding IsLoadingOlder}"
                               IsRunning="{Binding IsLoadingOlder}"
                               WidthRequest="22"
                               SemanticProperties.Description="正在加载更早消息" />
        </HorizontalStackLayout>

        <Label Grid.Row="0"
               Margin="18,10,18,0"
               HorizontalOptions="Center"
               Text="已到最早消息"
               Style="{StaticResource MutedLabelStyle}"
               IsVisible="{Binding HasReachedOldestMessage}"
               SemanticProperties.Description="已经到达当前会话的最早消息" />

        <Border Grid.Row="1"
                Margin="18,6,18,0"
                Padding="10,7"
                IsVisible="{Binding HasMessageLoadError}"
                Background="{StaticResource SurfaceSoftBrush}"
                Stroke="{StaticResource DangerBrush}"
                StrokeThickness="1">
            <Border.StrokeShape><RoundRectangle CornerRadius="7" /></Border.StrokeShape>
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <Label Text="{Binding MessageLoadError}" Style="{StaticResource DangerLabelStyle}" LineBreakMode="WordWrap" />
                <Button Grid.Column="1" Text="重试" Style="{StaticResource BaseButtonStyle}"
                        IsVisible="{Binding ShowHistoryRetry}" Command="{Binding LoadOlderCommand}" />
                <Button Grid.Column="2" Text="重试" Style="{StaticResource BaseButtonStyle}"
                        IsVisible="{Binding HasConversationActivationError}" Command="{Binding RetryConversationActivationCommand}" />
            </Grid>
        </Border>

        <CollectionView x:Name="MessageCollection"
                        Grid.Row="2"
                        Margin="0"
                        ItemsSource="{Binding Messages}"
                        IsVisible="{Binding IsMessageCollectionVisible}"
                        SelectionMode="None"
                        ItemsUpdatingScrollMode="KeepScrollOffset"
                        Scrolled="OnMessageCollectionScrolled">
            <CollectionView.Header>
                <BoxView HeightRequest="18" Background="Transparent" InputTransparent="True" />
            </CollectionView.Header>
            <CollectionView.Footer>
                <BoxView HeightRequest="16" Background="Transparent" InputTransparent="True" />
            </CollectionView.Footer>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="viewModels:MessageItem">
                    <Grid Padding="20,0,20,10"
                          ColumnDefinitions="*,16"
                          SemanticProperties.Description="{Binding AccessibleLabel}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Grid.Column="0" Margin="0,8,0,6" ColumnDefinitions="*,Auto,*" IsVisible="{Binding ShowDateDivider}">
                            <BoxView Grid.Column="0" HeightRequest="1" VerticalOptions="Center" Background="{StaticResource BorderBrush}" />
                            <Label Grid.Column="1" Margin="10,0" Text="{Binding DateDividerLabel}" Style="{StaticResource MutedLabelStyle}" />
                            <BoxView Grid.Column="2" HeightRequest="1" VerticalOptions="Center" Background="{StaticResource BorderBrush}" />
                        </Grid>

                        <Grid Grid.Row="1" Grid.Column="0" Margin="0,4,0,8" ColumnDefinitions="*,Auto,*" IsVisible="{Binding ShowUnreadDivider}">
                            <BoxView Grid.Column="0" HeightRequest="1" VerticalOptions="Center" Color="{StaticResource DangerColor}" />
                            <Label Grid.Column="1" Margin="10,0" Text="{Binding UnreadDividerLabel}" Style="{StaticResource DangerLabelStyle}" FontSize="11" />
                            <BoxView Grid.Column="2" HeightRequest="1" VerticalOptions="Center" Color="{StaticResource DangerColor}" />
                        </Grid>

                        <Border x:Name="MessageRow" Grid.Row="2" Grid.Column="0" Padding="0" StrokeThickness="0" Background="Transparent">
                            <Border.Behaviors>
                                <windowsBehaviors:MessageContextBehavior RevealElement="{x:Reference QuickActions}" />
                            </Border.Behaviors>
                            <Grid ColumnDefinitions="Auto,*,Auto"
                                  ColumnSpacing="0"
                                  MaximumWidthRequest="{Binding ViewModel.MessageRowMaximumWidth, Source={x:Reference Root}, x:DataType=controls:MessageListView}"
                                  HorizontalOptions="Start">
                                <Grid.Triggers>
                                    <DataTrigger TargetType="Grid" Binding="{Binding IsOwn}" Value="True">
                                        <Setter Property="HorizontalOptions" Value="End" />
                                    </DataTrigger>
                                </Grid.Triggers>

                                <Border Grid.Column="0"
                                        WidthRequest="40"
                                        HeightRequest="40"
                                        Margin="0,0,10,0"
                                        Padding="0"
                                        VerticalOptions="Start"
                                        Background="{Binding ToneBrush}"
                                        StrokeThickness="0">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsOwn}" Value="True">
                                            <Setter Property="Grid.Column" Value="2" />
                                            <Setter Property="Margin" Value="10,0,0,0" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                                    <Grid>
                                        <Label Text="{Binding AvatarInitial}"
                                               TextColor="White"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               HorizontalTextAlignment="Center"
                                               VerticalTextAlignment="Center" />
                                        <controls:RealmMediaImageView SourceUrl="{Binding SenderAvatarUrl}"
                                                                      MediaKind="Avatar"
                                                                      Aspect="AspectFill"
                                                                      ShowFailureText="False" />
                                    </Grid>
                                </Border>

                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="4"
                                                     MaximumWidthRequest="690"
                                                     HorizontalOptions="Start"
                                                     FlowDirection="LeftToRight">
                                    <VerticalStackLayout.Triggers>
                                        <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding IsOwn}" Value="True">
                                            <Setter Property="HorizontalOptions" Value="End" />
                                        </DataTrigger>
                                    </VerticalStackLayout.Triggers>

                                    <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="7" Margin="2,0,2,1" HorizontalOptions="Start">
                                        <Grid.Triggers>
                                            <DataTrigger TargetType="Grid" Binding="{Binding IsOwn}" Value="True">
                                                <Setter Property="HorizontalOptions" Value="End" />
                                                <Setter Property="FlowDirection" Value="RightToLeft" />
                                            </DataTrigger>
                                        </Grid.Triggers>
                                        <HorizontalStackLayout Grid.Column="0" Spacing="7">
                                            <HorizontalStackLayout.Triggers>
                                                <DataTrigger TargetType="HorizontalStackLayout" Binding="{Binding IsOwn}" Value="True">
                                                    <Setter Property="FlowDirection" Value="RightToLeft" />
                                                </DataTrigger>
                                            </HorizontalStackLayout.Triggers>
                                            <Label Text="{Binding Sender}"
                                                   Style="{StaticResource BaseLabelStyle}"
                                                   FontSize="11"
                                                   FontAttributes="Bold"
                                                   VerticalTextAlignment="Center" />
                                            <Label Text="{Binding Timestamp}"
                                                   Style="{StaticResource MutedLabelStyle}"
                                                   FontSize="10"
                                                   VerticalTextAlignment="Center" />
                                            <Label Text="★"
                                                   IsVisible="{Binding IsStarred}"
                                                   TextColor="{StaticResource WarningColor}"
                                                   FontSize="12"
                                                   VerticalTextAlignment="Center"
                                                   SemanticProperties.Description="已收藏" />
                                        </HorizontalStackLayout>
                                        <Border x:Name="QuickActions"
                                                Grid.Column="1"
                                                Padding="1"
                                                FlowDirection="LeftToRight"
                                                Opacity="0"
                                                IsEnabled="False"
                                                Background="{StaticResource SurfaceRaisedBrush}"
                                                Stroke="{StaticResource BorderBrush}"
                                                StrokeThickness="1">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="7" /></Border.StrokeShape>
                                            <HorizontalStackLayout Spacing="0">
                                                <ImageButton Source="icon_smile.png"
                                                             Style="{StaticResource MessageQuickImageButtonStyle}"
                                                             IsVisible="{Binding IsOther}"
                                                             Clicked="OnOpenReactionPickerClicked"
                                                             SemanticProperties.Description="添加表情反应" />
                                                <ImageButton Source="icon_edit.png"
                                                             Style="{StaticResource MessageQuickImageButtonStyle}"
                                                             IsVisible="{Binding CanEditOrDelete}"
                                                             Clicked="OnEditMessageClicked"
                                                             SemanticProperties.Description="编辑消息" />
                                                <ImageButton Source="icon_star.png"
                                                             Style="{StaticResource MessageQuickImageButtonStyle}"
                                                             Clicked="OnToggleMessageStarClicked"
                                                             SemanticProperties.Description="收藏或取消收藏消息" />
                                                <ImageButton Source="icon_quote.png"
                                                             Style="{StaticResource MessageQuickImageButtonStyle}"
                                                             Clicked="OnQuoteMessageClicked"
                                                             SemanticProperties.Description="引用消息" />
                                                <ImageButton Source="icon_copy.png"
                                                             Style="{StaticResource MessageQuickImageButtonStyle}"
                                                             Clicked="OnCopyMessageClicked"
                                                             SemanticProperties.Description="复制消息" />
                                                <ImageButton Source="icon_more.png"
                                                             Style="{StaticResource MessageQuickImageButtonStyle}"
                                                             Clicked="OnOpenMessageMenuClicked"
                                                             SemanticProperties.Description="打开消息操作菜单" />
                                            </HorizontalStackLayout>
                                        </Border>
                                    </Grid>

                                    <Border x:Name="Bubble"
                                            Padding="12,10"
                                            Background="{StaticResource BubbleBrush}"
                                            Stroke="{StaticResource BorderBrush}"
                                            StrokeThickness="1">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsOwn}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource OwnBubbleBrush}" />
                                                <Setter Property="Stroke" Value="{StaticResource OwnBubbleBorderBrush}" />
                                                <Setter Property="StrokeShape">
                                                    <Setter.Value>
                                                        <RoundRectangle CornerRadius="10,0,10,10" />
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Border.StrokeShape><RoundRectangle CornerRadius="0,10,10,10" /></Border.StrokeShape>
                                        <VerticalStackLayout Spacing="6">
                                            <Grid IsVisible="{Binding HasQuote}" ColumnDefinitions="2,*" Background="{StaticResource SurfaceSoftBrush}">
                                                <BoxView Grid.Column="0" Background="{StaticResource AccentBrush}" />
                                                <VerticalStackLayout Grid.Column="1" Padding="9,7" Spacing="2">
                                                    <Label Text="{Binding QuoteSender, StringFormat='↩ {0} 写道'}"
                                                           Style="{StaticResource MutedLabelStyle}"
                                                           FontSize="11"
                                                           FontAttributes="Bold"
                                                           TextColor="{StaticResource AccentStrongColor}" />
                                                    <Label Text="{Binding QuoteBody}"
                                                           Style="{StaticResource BaseLabelStyle}"
                                                           FontSize="12"
                                                           MaxLines="4"
                                                           LineBreakMode="TailTruncation" />
                                                </VerticalStackLayout>
                                            </Grid>

                                            <Label Text="{Binding Body}"
                                                   IsVisible="{Binding HasBody}"
                                                   Style="{StaticResource BaseLabelStyle}"
                                                   LineBreakMode="WordWrap"
                                                   FlowDirection="LeftToRight" />

                                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Attachments}"
                                                                 IsVisible="{Binding HasAttachments}"
                                                                 Spacing="6">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate x:DataType="viewModels:MessageAttachmentItem">
                                                        <Border Padding="0"
                                                                MaximumWidthRequest="360"
                                                                Background="{StaticResource SurfaceSoftBrush}"
                                                                Stroke="{StaticResource BorderBrush}"
                                                                StrokeThickness="1"
                                                                SemanticProperties.Description="{Binding AccessibleLabel}">
                                                            <Border.StrokeShape><RoundRectangle CornerRadius="7" /></Border.StrokeShape>
                                                            <VerticalStackLayout Spacing="0">
                                                                <Border HeightRequest="220"
                                                                        MaximumWidthRequest="360"
                                                                        Padding="0"
                                                                        IsVisible="{Binding IsImage}"
                                                                        Background="{StaticResource GroundBrush}"
                                                                        StrokeThickness="0">
                                                                    <Border.StrokeShape><RoundRectangle CornerRadius="7" /></Border.StrokeShape>
                                                                    <Border.GestureRecognizers>
                                                                        <TapGestureRecognizer Tapped="OnImageTapped" CommandParameter="{Binding .}" />
                                                                    </Border.GestureRecognizers>
                                                                    <controls:RealmMediaImageView SourceUrl="{Binding SourceUrl}" Aspect="AspectFit" />
                                                                </Border>
                                                                <Grid Padding="9,7" ColumnDefinitions="40,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="9">
                                                                    <Border Grid.RowSpan="2" WidthRequest="40" HeightRequest="40" Padding="9"
                                                                            Background="{StaticResource SurfaceSelectedBrush}" StrokeThickness="0">
                                                                        <Border.StrokeShape><RoundRectangle CornerRadius="7" /></Border.StrokeShape>
                                                                        <Image Source="icon_attachment.png" />
                                                                    </Border>
                                                                    <Label Grid.Column="1" Text="{Binding Name}" Style="{StaticResource BaseLabelStyle}"
                                                                           FontSize="12" FontAttributes="Bold" />
                                                                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding KindLabel}" Style="{StaticResource MutedLabelStyle}" />
                                                                    <Button Grid.Column="2" Grid.RowSpan="2" Text="下载" Style="{StaticResource BaseButtonStyle}"
                                                                            HeightRequest="30" MinimumHeightRequest="30"
                                                                            Clicked="OnDownloadAttachmentClicked" />
                                                                </Grid>
                                                            </VerticalStackLayout>
                                                        </Border>
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </VerticalStackLayout>

                                            <FlexLayout BindableLayout.ItemsSource="{Binding Reactions}"
                                                        IsVisible="{Binding HasReactions}"
                                                        Wrap="Wrap"
                                                        Direction="Row"
                                                        JustifyContent="Start"
                                                        AlignItems="Start">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate x:DataType="viewModels:ReactionItem">
                                                        <Button Text="{Binding ButtonLabel}"
                                                                Style="{StaticResource ReactionButtonStyle}"
                                                                Clicked="OnToggleReactionClicked"
                                                                SemanticProperties.Description="{Binding AccessibleLabel}">
                                                            <Button.Triggers>
                                                                <DataTrigger TargetType="Button" Binding="{Binding CurrentUserReacted}" Value="True">
                                                                    <Setter Property="BorderColor" Value="{StaticResource AccentColor}" />
                                                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightOwnBubbleColor}, Dark={StaticResource DarkOwnBubbleColor}}" />
                                                                </DataTrigger>
                                                            </Button.Triggers>
                                                        </Button>
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </FlexLayout>

                                            <Label Text="{Binding MutationState}" IsVisible="{Binding HasMutationState}"
                                                   Style="{StaticResource MutedLabelStyle}" TextColor="{StaticResource WarningColor}" LineBreakMode="WordWrap" />
                                            <Label Text="{Binding DeliveryState}" IsVisible="{Binding HasDeliveryState}"
                                                   Style="{StaticResource MutedLabelStyle}" TextColor="{StaticResource WarningColor}" LineBreakMode="WordWrap" />
                                            <Button Text="恢复到输入框" IsVisible="{Binding CanRecover}"
                                                    Style="{StaticResource BaseButtonStyle}" HorizontalOptions="Start"
                                                    Command="{Binding RecoverCommand}" CommandParameter="{Binding .}"
                                                    SemanticProperties.Description="恢复失败消息到输入框；再次发送可能重复" />
                                        </VerticalStackLayout>
                                    </Border>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <VerticalStackLayout Grid.Row="2"
                             Padding="28"
                             Spacing="8"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"
                             IsVisible="{Binding ShowMessageEmptyState}">
            <Border WidthRequest="42" HeightRequest="42" Padding="0"
                    HorizontalOptions="Center" Background="{StaticResource AccentBrush}" StrokeThickness="0">
                <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                <Label Text="R" TextColor="White" FontSize="18" FontAttributes="Bold"
                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
            </Border>
            <Label Text="{Binding MessageEmptyTitle}" Style="{StaticResource BaseLabelStyle}" FontSize="15" HorizontalTextAlignment="Center" />
            <Label Text="频道话题与私信会从当前 Zulip Realm 加载。"
                   Style="{StaticResource MutedLabelStyle}" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="2"
                             Padding="28"
                             Spacing="10"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"
                             IsVisible="{Binding ShowEmptyChannelTopicState}">
            <Image Source="icon_messages.png" WidthRequest="34" HeightRequest="34" HorizontalOptions="Center" />
            <Label Text="这个频道还没有可显示的话题。"
                   Style="{StaticResource BaseLabelStyle}"
                   FontSize="15"
                   HorizontalTextAlignment="Center" />
            <Button Text="新建话题"
                    HorizontalOptions="Center"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding OpenNewChannelTopicCommand}" />
        </VerticalStackLayout>

        <ActivityIndicator Grid.Row="2"
                           IsVisible="{Binding ShowConversationLoadingIndicator}"
                           IsRunning="{Binding ShowConversationLoadingIndicator}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           WidthRequest="40"
                           HeightRequest="40"
                           SemanticProperties.Description="正在加载会话" />

        <Button Grid.Row="2"
                ZIndex="2"
                Margin="0,0,0,12"
                Padding="14,7"
                HeightRequest="36"
                MinimumHeightRequest="36"
                HorizontalOptions="Center"
                VerticalOptions="End"
                Text="{Binding NewMessagesButtonText}"
                Style="{StaticResource PrimaryButtonStyle}"
                IsVisible="{Binding ShowNewMessagesButton}"
                Command="{Binding ScrollToLatestCommand}"
                SemanticProperties.Description="跳到最新消息" />
    </Grid>
</ContentView>
