<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:RelayCove.App.Controls"
             xmlns:viewModels="clr-namespace:RelayCove.App.ViewModels"
             x:Class="RelayCove.App.Controls.ConversationPaneView"
             x:Name="Root"
             x:DataType="viewModels:ShellViewModel"
             Background="{StaticResource GroundBrush}">
    <Grid RowDefinitions="76,*,Auto" Padding="0,0,0,8">
        <Grid Grid.Row="0" RowDefinitions="47,18" Padding="11,7,11,4">
            <Grid Grid.Row="0" ColumnDefinitions="*,36" ColumnSpacing="8">
                <Grid Grid.Column="0">
                    <Entry x:Name="ConversationFilterEntry"
                           Style="{StaticResource BaseEntryStyle}"
                           Text="{Binding ConversationFilterQuery, Mode=TwoWay}"
                           Placeholder="搜索聊天"
                           SemanticProperties.Description="筛选当前聊天列表；向下键打开首项，Escape 清除" />
                    <Image Source="icon_search.png"
                           WidthRequest="17"
                           HeightRequest="17"
                           Margin="0,0,10,0"
                           HorizontalOptions="End"
                           VerticalOptions="Center"
                           InputTransparent="True" />
                </Grid>
                <ImageButton x:Name="NewConversationButton"
                             Grid.Column="1"
                             Source="icon_plus.png"
                             Style="{StaticResource ImageIconButtonStyle}"
                             BackgroundColor="{AppThemeBinding Light={StaticResource LightSurfaceHoverColor}, Dark={StaticResource DarkSurfaceHoverColor}}"
                             Command="{Binding OpenNewConversationCommand}"
                             SemanticProperties.Description="发起私聊或新建群聊" />
            </Grid>
            <Label Grid.Row="1"
                   Text="{Binding NativePreviewStatus}"
                   IsVisible="{Binding IsNativePreview}"
                   Style="{StaticResource MutedLabelStyle}"
                   FontSize="10"
                   VerticalTextAlignment="Center" />
            <Label Grid.Row="1"
                   Text="{Binding ConversationFilterStatus}"
                   IsVisible="{Binding HasConversationFilterStatus}"
                   Style="{StaticResource MutedLabelStyle}"
                   FontSize="10"
                   HorizontalTextAlignment="End"
                   VerticalTextAlignment="Center" />
        </Grid>

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding FilteredConversations}"
                        SelectionMode="None"
                        ItemsUpdatingScrollMode="KeepItemsInView">
            <CollectionView.EmptyView>
                <Label x:DataType="viewModels:ShellViewModel"
                       Text="{Binding ConversationFilterEmptyText}"
                       Style="{StaticResource MutedLabelStyle}"
                       Padding="18,12" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="viewModels:ConversationListItem">
                    <Border HeightRequest="67"
                            Margin="8,0,8,1"
                            Padding="8"
                            StrokeThickness="0"
                            Opacity="{Binding ItemOpacity}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnConversationTapped" CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="Background" Value="{StaticResource SurfaceSelectedBrush}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Grid ColumnDefinitions="40,*,38" RowDefinitions="Auto,Auto" ColumnSpacing="11">
                            <Border Grid.RowSpan="2"
                                    WidthRequest="40"
                                    HeightRequest="40"
                                    Padding="0"
                                    VerticalOptions="Center"
                                    Background="{Binding ToneBrush}"
                                    StrokeThickness="0">
                                <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                <Grid>
                                    <Grid IsVisible="{Binding ShowSingleAvatar}">
                                        <Label Text="{Binding Initial}"
                                               TextColor="White"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               HorizontalTextAlignment="Center"
                                               VerticalTextAlignment="Center" />
                                        <controls:RealmMediaImageView SourceUrl="{Binding AvatarUrl}"
                                                                      MediaKind="Avatar"
                                                                      Aspect="AspectFill"
                                                                      ShowFailureText="False" />
                                        <Border WidthRequest="11"
                                                HeightRequest="11"
                                                Padding="0"
                                                Margin="0,0,1,1"
                                                HorizontalOptions="End"
                                                VerticalOptions="End"
                                                IsVisible="{Binding HasPresence}"
                                                Background="{Binding PresenceBrush}"
                                                Stroke="{StaticResource SurfaceBrush}"
                                                StrokeThickness="2"
                                                SemanticProperties.Description="{Binding PresenceLabel}">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="6" /></Border.StrokeShape>
                                        </Border>
                                    </Grid>
                                    <Label Text="{Binding Initial}"
                                           IsVisible="{Binding ShowGroupFallback}"
                                           TextColor="White"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center" />
                                    <Grid IsVisible="{Binding HasAvatarTiles}"
                                          RowDefinitions="*,*"
                                          ColumnDefinitions="*,*"
                                          RowSpacing="1"
                                          ColumnSpacing="1"
                                          Padding="1"
                                          BindableLayout.ItemsSource="{Binding AvatarTiles}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="viewModels:ConversationAvatarTile">
                                                <Border Grid.Row="{Binding Row}"
                                                        Grid.Column="{Binding Column}"
                                                        Padding="0"
                                                        Background="{Binding ToneBrush}"
                                                        StrokeThickness="0">
                                                    <Border.StrokeShape><RoundRectangle CornerRadius="4" /></Border.StrokeShape>
                                                    <Grid>
                                                        <Label Text="{Binding Initial}"
                                                               TextColor="White"
                                                               FontSize="7"
                                                               FontAttributes="Bold"
                                                               HorizontalTextAlignment="Center"
                                                               VerticalTextAlignment="Center" />
                                                        <controls:RealmMediaImageView SourceUrl="{Binding AvatarUrl}"
                                                                                      MediaKind="Avatar"
                                                                                      Aspect="AspectFill"
                                                                                      ShowFailureText="False" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </Grid>
                                </Grid>
                            </Border>
                            <Grid Grid.Column="1" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="5">
                                <Label Text="📌" IsVisible="{Binding IsPinned}" FontSize="10" VerticalTextAlignment="End" />
                                <Label Grid.Column="1"
                                       Text="{Binding Title}"
                                       Style="{StaticResource BaseLabelStyle}"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       VerticalTextAlignment="End"
                                       LineBreakMode="TailTruncation" />
                                <Label Grid.Column="2"
                                       Text="{Binding UserStatusGlyph}"
                                       IsVisible="{Binding HasUserStatusGlyph}"
                                       FontSize="12"
                                       VerticalTextAlignment="End"
                                       ToolTipProperties.Text="{Binding UserStatusDescription}"
                                       SemanticProperties.Description="{Binding UserStatusDescription}" />
                                <Label Grid.Column="3"
                                       Text="{Binding Timestamp}"
                                       IsVisible="{Binding HasTimestamp}"
                                       Style="{StaticResource MutedLabelStyle}"
                                       FontSize="10"
                                       VerticalTextAlignment="End" />
                            </Grid>
                            <Label Grid.Row="1"
                                   Grid.Column="1"
                                   Text="{Binding Detail}"
                                   Style="{StaticResource MutedLabelStyle}"
                                   FontSize="12"
                                   VerticalTextAlignment="Start"
                                   LineBreakMode="TailTruncation" />
                            <Border Grid.Column="2"
                                    Grid.RowSpan="2"
                                    Padding="5,1"
                                    VerticalOptions="Center"
                                    HorizontalOptions="End"
                                    IsVisible="{Binding HasUnread}"
                                    Background="{StaticResource DangerBrush}"
                                    StrokeThickness="0">
                                <Border.StrokeShape><RoundRectangle CornerRadius="9" /></Border.StrokeShape>
                                <Label Text="{Binding UnreadLabel}" FontSize="9" TextColor="White" />
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button x:Name="ConversationFilterLoadMoreButton"
                Grid.Row="2"
                Text="加载更多搜索结果"
                Margin="18,8"
                Style="{StaticResource BaseButtonStyle}"
                IsVisible="{Binding ShowMoreConversationFilterResults}"
                Command="{Binding LoadMoreConversationFilterCommand}" />
    </Grid>
</ContentView>
