<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Style x:Key="RelayCovePageStyle" TargetType="ContentPage">
        <Setter Property="Background" Value="{StaticResource GroundBrush}" />
    </Style>

    <Style x:Key="BaseLabelStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource RelayCoveFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource BaseFontSize}" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource LightTextColor}, Dark={StaticResource DarkTextColor}}" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
    </Style>

    <Style x:Key="MutedLabelStyle" TargetType="Label" BasedOn="{StaticResource BaseLabelStyle}">
        <Setter Property="FontSize" Value="{DynamicResource MutedFontSize}" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource LightMutedColor}, Dark={StaticResource DarkMutedColor}}" />
    </Style>

    <Style x:Key="SectionHeaderStyle" TargetType="Label" BasedOn="{StaticResource BaseLabelStyle}">
        <Setter Property="FontSize" Value="{DynamicResource MutedFontSize}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextTransform" Value="Uppercase" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource LightMutedColor}, Dark={StaticResource DarkMutedColor}}" />
    </Style>

    <Style x:Key="DangerLabelStyle" TargetType="Label" BasedOn="{StaticResource BaseLabelStyle}">
        <Setter Property="TextColor" Value="{StaticResource DangerColor}" />
    </Style>

    <Style x:Key="BaseButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource RelayCoveFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource ButtonFontSize}" />
        <Setter Property="HeightRequest" Value="{DynamicResource ControlHeight}" />
        <Setter Property="MinimumHeightRequest" Value="{DynamicResource ControlHeight}" />
        <Setter Property="Padding" Value="{DynamicResource ControlHorizontalPadding}" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="BorderColor"
                Value="{AppThemeBinding Light={StaticResource LightBorderColor}, Dark={StaticResource DarkBorderColor}}" />
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource LightSurfaceSoftColor}, Dark={StaticResource DarkSurfaceSoftColor}}" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource LightTextColor}, Dark={StaticResource DarkTextColor}}" />
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="BackgroundColor" Value="{StaticResource AccentColor}" />
        <Setter Property="BorderColor" Value="{StaticResource AccentStrongColor}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style x:Key="JumpToLatestButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="HeightRequest" Value="42" />
        <Setter Property="MinimumHeightRequest" Value="42" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="CornerRadius" Value="21" />
        <Setter Property="BorderColor"
                Value="{AppThemeBinding Light={StaticResource LightStrongBorderColor}, Dark={StaticResource DarkStrongBorderColor}}" />
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource LightSurfaceRaisedColor}, Dark={StaticResource DarkSurfaceRaisedColor}}" />
        <Setter Property="TextColor" Value="{StaticResource SuccessColor}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="ContentLayout" Value="Left,8" />
    </Style>

    <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="WidthRequest" Value="36" />
        <Setter Property="MinimumWidthRequest" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>

    <Style x:Key="NavigationButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="WidthRequest" Value="48" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="Padding" Value="6,5" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="ContentLayout" Value="Top,2" />
    </Style>

    <Style x:Key="ImageIconButtonStyle" TargetType="ImageButton">
        <Setter Property="WidthRequest" Value="36" />
        <Setter Property="HeightRequest" Value="36" />
        <Setter Property="MinimumWidthRequest" Value="36" />
        <Setter Property="MinimumHeightRequest" Value="36" />
        <Setter Property="Padding" Value="9" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>

    <Style x:Key="MessageQuickImageButtonStyle" TargetType="ImageButton" BasedOn="{StaticResource ImageIconButtonStyle}">
        <Setter Property="WidthRequest" Value="25" />
        <Setter Property="HeightRequest" Value="23" />
        <Setter Property="MinimumWidthRequest" Value="25" />
        <Setter Property="MinimumHeightRequest" Value="23" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="CornerRadius" Value="5" />
    </Style>

    <Style x:Key="MessageQuickButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="HeightRequest" Value="28" />
        <Setter Property="MinimumHeightRequest" Value="28" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="FontSize" Value="{DynamicResource SmallFontSize}" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>

    <Style x:Key="PopoverMenuButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="HeightRequest" Value="35" />
        <Setter Property="MinimumHeightRequest" Value="35" />
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="ContentLayout" Value="Left,7" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>

    <Style x:Key="PopoverBorderStyle" TargetType="Border">
        <Setter Property="Padding" Value="6" />
        <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
        <Setter Property="Stroke" Value="{StaticResource BorderBrush}" />
        <Setter Property="StrokeThickness" Value="1" />
    </Style>

    <Style x:Key="EmojiPickerButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
        <Setter Property="WidthRequest" Value="30" />
        <Setter Property="HeightRequest" Value="30" />
        <Setter Property="MinimumWidthRequest" Value="30" />
        <Setter Property="MinimumHeightRequest" Value="30" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="EmojiCategoryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="HeightRequest" Value="32" />
        <Setter Property="MinimumHeightRequest" Value="32" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="CornerRadius" Value="15" />
    </Style>

    <Style x:Key="SettingsNavigationButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="HeightRequest" Value="41" />
        <Setter Property="MinimumHeightRequest" Value="41" />
        <Setter Property="Padding" Value="11,0" />
        <Setter Property="HorizontalOptions" Value="Fill" />
        <Setter Property="ContentLayout" Value="Left,10" />
    </Style>

    <Style x:Key="ReactionButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="HeightRequest" Value="30" />
        <Setter Property="MinimumHeightRequest" Value="30" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="FontSize" Value="{DynamicResource MutedFontSize}" />
    </Style>

    <Style x:Key="BaseEntryStyle" TargetType="Entry">
        <Setter Property="FontFamily" Value="{StaticResource RelayCoveFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource BaseFontSize}" />
        <Setter Property="HeightRequest" Value="{DynamicResource ControlHeight}" />
        <Setter Property="ClearButtonVisibility" Value="WhileEditing" />
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource LightSurfaceSoftColor}, Dark={StaticResource DarkSurfaceSoftColor}}" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource LightTextColor}, Dark={StaticResource DarkTextColor}}" />
        <Setter Property="PlaceholderColor"
                Value="{AppThemeBinding Light={StaticResource LightMutedColor}, Dark={StaticResource DarkMutedColor}}" />
    </Style>

    <Style x:Key="ComposerEditorStyle" TargetType="Editor">
        <Setter Property="FontFamily" Value="{StaticResource RelayCoveFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource BaseFontSize}" />
        <Setter Property="AutoSize" Value="Disabled" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource LightTextColor}, Dark={StaticResource DarkTextColor}}" />
        <Setter Property="PlaceholderColor"
                Value="{AppThemeBinding Light={StaticResource LightMutedColor}, Dark={StaticResource DarkMutedColor}}" />
    </Style>

    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="Stroke" Value="{StaticResource BorderBrush}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <Style x:Key="DialogBorderStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
        <Setter Property="Padding" Value="18" />
        <Setter Property="MinimumWidthRequest" Value="320" />
        <Setter Property="MaximumWidthRequest" Value="520" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="Stroke" Value="{StaticResource StrongBorderBrush}" />
    </Style>

    <!-- Channel settings overlay only: these do not alter shared controls. -->
    <Style x:Key="ChannelSettingsToolButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="HeightRequest" Value="34" />
        <Setter Property="MinimumHeightRequest" Value="34" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>
    <Style x:Key="SettingsSectionBorderStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
        <Setter Property="Padding" Value="16" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Stroke" Value="{StaticResource BorderBrush}" />
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    </Style>
    <Style x:Key="ChannelSettingsTabStyle" TargetType="Button" BasedOn="{StaticResource ChannelSettingsToolButtonStyle}">
        <Setter Property="MinimumWidthRequest" Value="112" />
        <Setter Property="HorizontalOptions" Value="Start" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style x:Key="ChannelSettingsPickerStyle" TargetType="Picker">
        <Setter Property="Background" Value="{StaticResource SurfaceSoftBrush}" />
        <Setter Property="HeightRequest" Value="40" />
        <Setter Property="FontFamily" Value="{StaticResource RelayCoveFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource BaseFontSize}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextColor}, Dark={StaticResource DarkTextColor}}" />
    </Style>
    <Style x:Key="ChannelSettingsCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="Color" Value="{StaticResource AccentColor}" />
    </Style>
    <Style x:Key="ChannelSettingsActionRowStyle" TargetType="Button" BasedOn="{StaticResource ChannelSettingsToolButtonStyle}">
        <Setter Property="HorizontalOptions" Value="End" />
        <Setter Property="MinimumWidthRequest" Value="68" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style x:Key="ChannelSettingsListRowStyle" TargetType="Border">
        <Setter Property="Stroke" Value="{StaticResource BorderBrush}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="10,8" />
    </Style>
    <Style x:Key="ChannelSettingsColorPreviewStyle" TargetType="Border">
        <Setter Property="Stroke" Value="{StaticResource StrongBorderBrush}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="StrokeShape"><Setter.Value><RoundRectangle CornerRadius="10" /></Setter.Value></Setter>
    </Style>
    <Style x:Key="ChannelSettingsColorSelectorStyle" TargetType="Button" BasedOn="{StaticResource ChannelSettingsToolButtonStyle}">
        <Setter Property="Padding" Value="10,0" />
    </Style>
    <Style x:Key="ChannelSettingsColorPickerBorderStyle" TargetType="Border" BasedOn="{StaticResource DialogBorderStyle}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="WidthRequest" Value="318" />
        <Setter Property="MinimumWidthRequest" Value="318" />
        <Setter Property="MaximumWidthRequest" Value="318" />
        <Setter Property="MaximumHeightRequest" Value="620" />
        <Setter Property="HorizontalOptions" Value="Start" />
        <Setter Property="VerticalOptions" Value="Start" />
        <Setter Property="StrokeShape"><Setter.Value><RoundRectangle CornerRadius="8" /></Setter.Value></Setter>
    </Style>
    <Style x:Key="ChannelSettingsColorPickerConfirmStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource LightTextColor}, Dark={StaticResource DarkTextColor}}" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="WidthRequest" Value="34" />
        <Setter Property="HeightRequest" Value="34" />
    </Style>
    <Style x:Key="ChannelSettingsColorSwatchStyle" TargetType="Border">
        <Setter Property="Stroke" Value="{StaticResource BorderBrush}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="StrokeShape"><Setter.Value><RoundRectangle CornerRadius="7" /></Setter.Value></Setter>
    </Style>
    <Style x:Key="ChannelSettingsColorSwatchButtonStyle" TargetType="Button">
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="13" />
        <Setter Property="MinimumWidthRequest" Value="26" />
        <Setter Property="MinimumHeightRequest" Value="26" />
    </Style>
    <Style x:Key="ChannelSettingsColorCustomButtonStyle" TargetType="Button" BasedOn="{StaticResource ChannelSettingsToolButtonStyle}">
        <Setter Property="HorizontalOptions" Value="Fill" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>
</ResourceDictionary>
