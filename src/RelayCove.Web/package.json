{
  "name": "relaycove-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "build": "vite build",
    "build:e2e": "vite build --mode e2e",
    "preview": "vite preview --host 127.0.0.1",
    "preview:e2e": "vite preview --mode e2e --host 127.0.0.1 --port 4173 --outDir dist-e2e",
    "preview:deploy-test": "node test-support/serve-deploy-preview.mjs",
    "test:e2e": "npm run build:e2e && playwright test && npm run build && playwright test --config playwright.deploy.config.ts",
    "verify:fast": "npm run typecheck && npm run test:unit && npm run build",
    "verify:full": "npm run verify:fast && npm run test:e2e"
  },
  "dependencies": {
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.2.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "29.0.1",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
