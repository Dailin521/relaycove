@page "/admin/login"
@model LoginModel
@{
    ViewData["Title"] = "RelayCove 管理登录";
}
<!doctype html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <style>
        body { background:#f4f7fb; color:#172033; font:16px system-ui,-apple-system,"Microsoft YaHei",sans-serif; margin:0; }
        main { max-width:420px; margin:10vh auto; padding:28px; background:#fff; border-radius:14px; box-shadow:0 8px 30px #12203a18; }
        label,input,button { display:block; box-sizing:border-box; width:100%; } label { margin:18px 0 6px; font-weight:600; } input { padding:10px; border:1px solid #bdc7d8; border-radius:7px; } button { margin-top:24px; padding:11px; border:0; border-radius:7px; background:#1769aa; color:#fff; font-weight:700; cursor:pointer; } .error { color:#a11b1b; margin-top:16px; }
    </style>
</head>
<body>
<main>
    <h1>RelayCove 管理面板</h1>
    <p>使用管理员账号登录。</p>
    <form method="post">
        <label asp-for="UserName">账号</label>
        <input asp-for="UserName" autocomplete="username" autofocus />
        <label asp-for="Password">密码</label>
        <input asp-for="Password" type="password" autocomplete="current-password" />
        <button type="submit">登录</button>
    </form>
    <div asp-validation-summary="ModelOnly" class="error" role="alert"></div>
</main>
</body>
</html>
