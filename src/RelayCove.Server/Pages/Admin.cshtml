@page "/admin"
@model AdminModel
@using RelayCove.Shared.Conversations
@{
    ViewData["Title"] = "RelayCove 管理面板";
}
<!doctype html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <style>
        :root { color-scheme:light; } body { margin:0; background:#f4f7fb; color:#172033; font:14px system-ui,-apple-system,"Microsoft YaHei",sans-serif; } header { background:#1769aa; color:white; padding:18px max(16px,calc((100% - 1200px)/2)); display:flex; justify-content:space-between; align-items:center; gap:12px; } main { max-width:1200px; margin:20px auto; padding:0 16px 32px; } section { background:#fff; border-radius:10px; padding:18px; margin:14px 0; box-shadow:0 2px 10px #12203a10; } h1,h2,h3 { margin:0 0 12px; } h2 { font-size:18px; } form.inline, .form-grid { display:flex; gap:8px; flex-wrap:wrap; align-items:end; } label { display:grid; gap:4px; min-width:120px; } input,select,button { font:inherit; padding:7px; border-radius:6px; border:1px solid #bdc7d8; } button { background:#1769aa; border:0; color:white; font-weight:650; cursor:pointer; } button.danger { background:#a52b2b; } button.secondary { background:#637186; } table { width:100%; border-collapse:collapse; } th,td { padding:9px 6px; border-bottom:1px solid #e5e9f0; text-align:left; vertical-align:top; } .muted { color:#637186; } details { margin:8px 0; } .status { display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:8px; } .metric { background:#f4f7fb; padding:10px; border-radius:6px; } .confirm { margin:0; } .flash { border-radius:8px; padding:12px 14px; margin:0 0 14px; font-weight:650; } .flash.success { background:#e8f6ed; color:#176535; } .flash.error { background:#fdecec; color:#8c2020; } @@media (max-width:680px) { table { display:block; overflow-x:auto; } header { align-items:flex-start; flex-direction:column; } }
    </style>
</head>
<body>
<header><div><h1>RelayCove 管理面板</h1><span>服务器状态、成员与频道</span></div><form method="post" asp-page-handler="Logout"><button class="secondary">退出登录</button></form></header>
<main>
    @if (!string.IsNullOrWhiteSpace(Model.FeedbackMessage))
    {
        <div class="flash @(Model.FeedbackIsError ? "error" : "success")" role="status">@Model.FeedbackMessage</div>
    }
    <section>
        <h2>服务器状态</h2>
        <div class="status">
            <div class="metric"><b>版本</b><br />@Model.Status.Version</div>
            <div class="metric"><b>运行秒数</b><br />@Model.Status.UptimeSeconds</div>
            <div class="metric"><b>在线连接</b><br />@Model.Status.OnlineConnectionCount</div>
            <div class="metric"><b>数据库</b><br />@Model.FormatBytes(Model.Status.DatabaseBytes)</div>
            <div class="metric"><b>附件</b><br />@Model.FormatBytes(Model.Status.AttachmentBytes)</div>
            <div class="metric"><b>最近错误</b><br />@(Model.Status.LastErrorCategory ?? "无") @if (Model.Status.LastErrorAt is DateTimeOffset errorAt) { <span class="muted">@errorAt.ToString("u")</span> }</div>
        </div>
    </section>
    <section>
        <h2>附件上传上限</h2>
        <p>当前：<b>@Model.FormatBytes(Model.UploadLimitBytes)</b></p>
        <form method="post" asp-page-handler="UpdateUpload" class="inline">
            <label>上限（MiB）<input name="maximumMiB" value="@(Model.UploadLimitBytes / 1024 / 1024)" inputmode="numeric" /></label>
            <button>保存</button>
        </form>
    </section>
    <section>
        <h2>创建用户</h2>
        <form method="post" asp-page-handler="CreateUser" class="form-grid">
            <label>账号<input name="userName" required /></label><label>显示名<input name="displayName" required /></label><label>初始密码<input name="password" type="password" required /></label>
            <label>角色<select name="isAdmin"><option value="false">普通用户</option><option value="true">管理员</option></select></label><button>创建用户</button>
        </form>
    </section>
    <section>
        <h2>用户</h2>
        <table><thead><tr><th>账号</th><th>显示名</th><th>状态</th><th>操作</th></tr></thead><tbody>
        @foreach (var user in Model.Users)
        {
            <tr><td>@user.UserName @if (user.IsAdmin) { <span class="muted">(管理员)</span> }</td><td>@user.DisplayName</td><td>@(user.RetiredAt is not null ? "已退役" : user.IsDisabled ? "已禁用" : "正常")</td><td>
                @if (user.RetiredAt is null)
                {
                    <form method="post" asp-page-handler="SetDisabled" class="inline"><input type="hidden" name="userId" value="@user.UserId" /><input type="hidden" name="isDisabled" value="@(!user.IsDisabled).ToString().ToLowerInvariant()" /><button class="secondary">@(user.IsDisabled ? "恢复" : "禁用")</button></form>
                    <form method="post" asp-page-handler="ResetPassword" class="inline"><input type="hidden" name="userId" value="@user.UserId" /><input name="password" type="password" required placeholder="新密码" /><button>重置密码</button></form>
                    <form method="post" asp-page-handler="RetireUser" class="inline confirm" onsubmit="return confirm('退役后不能恢复，确定吗？')"><input type="hidden" name="userId" value="@user.UserId" /><button class="danger">退役</button></form>
                }
            </td></tr>
        }
        </tbody></table>
    </section>
    <section>
        <h2>创建频道</h2>
        <form method="post" asp-page-handler="CreateChannel" class="inline"><label>名称<input name="name" required /></label><label>类型<select name="isPrivate"><option value="false">公开频道</option><option value="true">私有频道</option></select></label><button>创建频道</button></form>
    </section>
    <section>
        <h2>频道</h2>
        @foreach (var channel in Model.Channels)
        {
            <details><summary><b>@channel.Name</b> <span class="muted">@(channel.Type == ConversationType.PrivateChannel ? "私有" : "公开")</span></summary>
                <form method="post" asp-page-handler="RenameChannel" class="inline"><input type="hidden" name="conversationId" value="@channel.Id" /><label>名称<input name="name" value="@channel.Name" required /></label><button>改名</button></form>
                <form method="post" asp-page-handler="DeleteChannel" class="inline confirm" onsubmit="return confirm('删除频道会撤销成员访问，确定吗？')"><input type="hidden" name="conversationId" value="@channel.Id" /><button class="danger">删除频道</button></form>
                @if (channel.Type == ConversationType.PrivateChannel && Model.Members.TryGetValue(channel.Id, out var members))
                {
                    <h3>私有成员</h3>
                    <ul>@foreach (var member in members) { <li>@member.DisplayName（@member.UserName） <form method="post" asp-page-handler="RemoveMember" class="inline confirm" onsubmit="return confirm('移除这个成员？')"><input type="hidden" name="conversationId" value="@channel.Id" /><input type="hidden" name="userId" value="@member.UserId" /><button class="danger">移除</button></form></li> }</ul>
                    <form method="post" asp-page-handler="AddMember" class="inline"><input type="hidden" name="conversationId" value="@channel.Id" /><label>添加用户<select name="userId">@foreach (var user in Model.ActiveUsers) { <option value="@user.UserId">@user.DisplayName（@user.UserName）</option> }</select></label><label>角色<select name="isChannelAdmin"><option value="false">成员</option><option value="true">频道管理员</option></select></label><button>添加</button></form>
                }
            </details>
        }
    </section>
</main>
</body>
</html>
