<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <Color x:Key="RcPrimaryColor">#FF1677D2</Color>
    <Color x:Key="RcPrimaryHoverColor">#FF0958D9</Color>
    <Color x:Key="RcPrimaryPressedColor">#FF003EB3</Color>
    <Color x:Key="RcPrimarySoftColor">#FFEAF3FF</Color>
    <Color x:Key="RcPrimaryPressedSoftColor">#FFD8EAFE</Color>
    <Color x:Key="RcSurfaceHoverColor">#FFF2F7FD</Color>
    <Color x:Key="RcCanvasColor">#FFF5F7FA</Color>
    <Color x:Key="RcSurfaceColor">#FFFFFFFF</Color>
    <Color x:Key="RcBorderColor">#FFE5EAF0</Color>
    <Color x:Key="RcTextPrimaryColor">#FF1F2328</Color>
    <Color x:Key="RcTextSecondaryColor">#FF667085</Color>
    <Color x:Key="RcNeutralColor">#FF8F9AA5</Color>
    <Color x:Key="RcScrollBarTrackColor">#FFEAF0F6</Color>
    <Color x:Key="RcScrollBarThumbColor">#FFB8C3CF</Color>
    <Color x:Key="RcDangerColor">#FFD92D20</Color>
    <Color x:Key="RcSuccessColor">#FF12B76A</Color>
    <Color x:Key="RcWarningColor">#FFF79009</Color>

    <SolidColorBrush x:Key="RcPrimaryBrush" Color="{StaticResource RcPrimaryColor}" />
    <SolidColorBrush x:Key="RcPrimaryHoverBrush" Color="{StaticResource RcPrimaryHoverColor}" />
    <SolidColorBrush x:Key="RcPrimaryPressedBrush" Color="{StaticResource RcPrimaryPressedColor}" />
    <SolidColorBrush x:Key="RcPrimarySoftBrush" Color="{StaticResource RcPrimarySoftColor}" />
    <SolidColorBrush x:Key="RcPrimaryPressedSoftBrush" Color="{StaticResource RcPrimaryPressedSoftColor}" />
    <SolidColorBrush x:Key="RcSurfaceHoverBrush" Color="{StaticResource RcSurfaceHoverColor}" />
    <SolidColorBrush x:Key="RcCanvasBrush" Color="{StaticResource RcCanvasColor}" />
    <SolidColorBrush x:Key="RcSurfaceBrush" Color="{StaticResource RcSurfaceColor}" />
    <SolidColorBrush x:Key="RcBorderBrush" Color="{StaticResource RcBorderColor}" />
    <SolidColorBrush x:Key="RcTextPrimaryBrush" Color="{StaticResource RcTextPrimaryColor}" />
    <SolidColorBrush x:Key="RcTextSecondaryBrush" Color="{StaticResource RcTextSecondaryColor}" />
    <SolidColorBrush x:Key="RcNeutralBrush" Color="{StaticResource RcNeutralColor}" />
    <SolidColorBrush x:Key="RcFocusRingBrush" Color="{StaticResource RcPrimaryColor}" />
    <SolidColorBrush x:Key="RcScrollBarTrackBrush" Color="{StaticResource RcScrollBarTrackColor}" />
    <SolidColorBrush x:Key="RcScrollBarThumbBrush" Color="{StaticResource RcScrollBarThumbColor}" />
    <SolidColorBrush x:Key="RcDangerBrush" Color="{StaticResource RcDangerColor}" />
    <SolidColorBrush x:Key="RcSuccessBrush" Color="{StaticResource RcSuccessColor}" />
    <SolidColorBrush x:Key="RcWarningBrush" Color="{StaticResource RcWarningColor}" />
    <SolidColorBrush x:Key="RcTransparentBrush" Color="Transparent" />
    <SolidColorBrush x:Key="RcOverlayBrush" Color="#990F172A" />

    <FontFamily x:Key="RcFontFamily">Segoe UI</FontFamily>
    <sys:Double x:Key="RcFontSizeCaption">11</sys:Double>
    <sys:Double x:Key="RcFontSizeBody">14</sys:Double>
    <sys:Double x:Key="RcFontSizeSubtitle">16</sys:Double>
    <sys:Double x:Key="RcFontSizeTitle">22</sys:Double>

    <sys:Double x:Key="RcTitleBarHeight">48</sys:Double>
    <sys:Double x:Key="RcNavigationRailWidth">72</sys:Double>
    <sys:Double x:Key="RcNavigationRailCompactWidth">64</sys:Double>
    <sys:Double x:Key="RcConversationPanelWidth">340</sys:Double>
    <sys:Double x:Key="RcConversationPanelMediumWidth">320</sys:Double>
    <sys:Double x:Key="RcConversationPanelCompactWidth">280</sys:Double>
    <sys:Double x:Key="RcMemberDrawerWidth">360</sys:Double>
    <sys:Double x:Key="RcControlHeight">36</sys:Double>
    <sys:Double x:Key="RcIconSize">20</sys:Double>

    <Thickness x:Key="RcSpacing4">4</Thickness>
    <Thickness x:Key="RcSpacing8">8</Thickness>
    <Thickness x:Key="RcSpacing12">12</Thickness>
    <Thickness x:Key="RcSpacing16">16</Thickness>
    <Thickness x:Key="RcSpacing20">20</Thickness>
    <CornerRadius x:Key="RcButtonCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="RcInputCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="RcPanelCornerRadius">12</CornerRadius>

    <DropShadowEffect x:Key="RcPanelShadow"
                      BlurRadius="20"
                      Direction="270"
                      Opacity="0.10"
                      ShadowDepth="4"
                      Color="#FF344054" />
</ResourceDictionary>
