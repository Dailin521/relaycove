                                        Padding="10,7"
                                        Background="#FFF0F5FA"
                                        BorderBrush="#FFD7E2ED"
                                        BorderThickness="3,0,0,0"
                                        CornerRadius="3"
                                        Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock x:Name="ReplyComposerSenderText"
                                                       Text="正在回复"
                                                       Foreground="#FF52708C"
                                                       FontSize="11"
                                                       FontWeight="SemiBold" />
                                            <TextBlock x:Name="ReplyComposerContentText"
                                                       Margin="0,2,10,0"
                                                       Foreground="#FF718396"
                                                       FontSize="11"
                                                       MaxHeight="34"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Content="取消"
                                                MinHeight="28"
                                                Padding="8,2"
                                                VerticalAlignment="Center"
                                                Click="OnCancelReplyClicked" />
                                    </Grid>
                                </Border>
                                <Border x:Name="MentionPickerPanel"
                                        Grid.Row="1"
                                        Grid.ColumnSpan="4"
                                        Margin="0,0,0,7"
                                        Padding="10,8"
                                        Background="#FFF7FAFD"
                                        BorderBrush="#FFD7E2ED"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        Visibility="Collapsed">
                                    <StackPanel>
                                        <DockPanel LastChildFill="True">
                                            <Button DockPanel.Dock="Right"
                                                    MinHeight="26"
                                                    Padding="8,1"
                                                    Content="关闭"
                                                    Click="OnCloseMentionPickerClicked" />
                                            <TextBlock VerticalAlignment="Center"
                                                       Text="添加 @用户"
                                                       FontWeight="SemiBold"
                                                       Foreground="#FF36536D" />
                                        </DockPanel>
                                        <Grid Margin="0,7,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="MentionSearchTextBox"
                                                     MinHeight="30"
                                                     Padding="7,4"
                                                     MaxLength="64"
                                                     AutomationProperties.Name="按用户名搜索提及候选"
                                                     TextChanged="OnMentionSearchTextChanged"
                                                     PreviewKeyDown="OnMentionSearchPreviewKeyDown" />
                                            <Button x:Name="MentionSearchButton"
                                                    Grid.Column="1"
                                                    MinWidth="68"
                                                    Margin="8,0,0,0"
                                                    Padding="10,3"
                                                    Content="搜索"
                                                    Click="OnMentionSearchClicked" />
                                        </Grid>
                                        <TextBlock x:Name="MentionSearchStatusText"
                                                   Margin="1,5,0,0"
                                                   Text="输入 1–64 位用户名字符前缀后显式搜索。"
                                                   AutomationProperties.LiveSetting="Polite"
                                                   Foreground="#FF718396"
                                                   FontSize="11"
                                                   TextWrapping="Wrap" />
                                        <ListBox x:Name="MentionCandidateList"
                                                 Margin="0,6,0,0"
                                                 MaxHeight="132"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 AutomationProperties.Name="提及候选">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="2,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding DisplayName}"
                                                                       FontWeight="SemiBold" />
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="@" Foreground="#FF718396" />
                                                                <TextBlock Text="{Binding UserName}"
                                                                           Foreground="#FF718396" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <Button Grid.Column="1"
                                                                MinWidth="54"
                                                                Margin="10,0,0,0"
                                                                Padding="8,2"
                                                                Content="添加"
                                                                Click="OnMentionCandidateClicked" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <TextBlock x:Name="SelectedMentionHeadingText"
                                                   Margin="1,7,0,0"
                                                   Text="已选 0/20"
                                                   Foreground="#FF52708C"
                                                   FontSize="11" />
                                        <ItemsControl x:Name="SelectedMentionList"
                                                      Margin="0,3,0,0"
                                                      AutomationProperties.Name="已选提及用户">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,6,4"
                                                            Padding="6,3"
                                                            Background="#FFE8F1F8"
                                                            CornerRadius="3">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="@" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding UserName}"
                                                                       VerticalAlignment="Center" />
                                                            <Button Margin="5,0,0,0"
                                                                    MinWidth="24"
                                                                    Padding="3,0"
                                                                    Content="移除"
                                                                    AutomationProperties.Name="移除提及用户"
                                                                    Click="OnRemoveMentionClicked" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="SelectedAttachmentPanel"
                                        Grid.Row="2"
                                        Grid.ColumnSpan="4"
                                        Margin="0,0,0,7"
                                        Padding="10,7"
                                        Background="#FFF7FAFD"
                                        BorderBrush="#FFD7E2ED"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock x:Name="SelectedAttachmentHeadingText"
                                                   Text="已选 0/10 个附件"
