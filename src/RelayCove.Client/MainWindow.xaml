                                                                           FontSize="11"
                                                                           MaxHeight="34"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </Border>
                                                    </Button>
                                                    <StackPanel Margin="0,6,0,0"
                                                                HorizontalAlignment="Right"
                                                                Orientation="Horizontal">
