<Window x:Class="RelayCove.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RelayCove"
        Height="680"
        Width="1060"
        MinHeight="520"
        MinWidth="820"
        WindowStartupLocation="CenterScreen"
        Background="#FFF4F7FB"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#FF10243E">
            <Grid Margin="28,32,28,26">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="RelayCove"
                               Foreground="White"
                               FontWeight="SemiBold"
                               FontSize="27" />
                    <TextBlock Text="团队消息，安全抵达"
                               Margin="0,5,0,0"
                               Foreground="#FF9FB3C8"
                               FontSize="13" />
                </StackPanel>

                <Border Grid.Row="1"
                        Margin="0,32,0,0"
                        Padding="13,11"
                        Background="#FF19334F"
                        CornerRadius="8">
                    <StackPanel>
                        <TextBlock x:Name="SidebarConnectionText"
                                   Text="实时连接：未连接"
                                   AutomationProperties.LiveSetting="Polite"
                                   Foreground="#FFE7F0F8"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="SidebarSyncText"
                                   Text="同步：尚未完成"
                                   AutomationProperties.LiveSetting="Polite"
                                   Margin="0,5,0,0"
                                   Foreground="#FF9FB3C8"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="SidebarNotificationText"
                                   Text="系统通知：初始化中"
                                   AutomationProperties.LiveSetting="Polite"
                                   Margin="0,5,0,0"
                                   Foreground="#FF9FB3C8"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="2" Margin="0,34,0,0">
                    <TextBlock Text="当前账户"
                               Foreground="#FF7891AA"
                               FontWeight="SemiBold"
                               FontSize="12" />
                    <TextBlock x:Name="SidebarDisplayNameText"
                               Margin="0,8,0,0"
                               Text="尚未登录"
                               AutomationProperties.LiveSetting="Polite"
                               Foreground="White"
                               FontSize="16"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="SidebarServerText"
                               Margin="0,5,0,0"
                               Text="—"
                               AutomationProperties.LiveSetting="Polite"
                               Foreground="#FF9FB3C8"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <TextBlock x:Name="SidebarUnreadText"
                           Grid.Row="3"
                           Text="未读计数：0"
                           AutomationProperties.LiveSetting="Polite"
                           Foreground="#FF7891AA"
                           FontSize="12" />
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="42,34">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock x:Name="HeadingText"
                           Text="正在启动 RelayCove"
                           AutomationProperties.LiveSetting="Polite"
                           Foreground="#FF17263A"
                           FontSize="28"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="DetailText"
                           Margin="0,8,0,0"
                           MaxWidth="680"
                           AutomationProperties.LiveSetting="Polite"
                           HorizontalAlignment="Left"
                           Text="正在准备本地账户环境。"
                           Foreground="#FF5C6F82"
                           FontSize="14"
                           TextWrapping="Wrap" />
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,30,0,24">
                <Border x:Name="LoginPanel"
                        MaxWidth="500"
                        Padding="34"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        Background="White"
                        BorderBrush="#FFDCE5EF"
                        BorderThickness="1"
                        CornerRadius="12">
                    <StackPanel>
                        <TextBlock Text="服务器地址"
                                   Foreground="#FF31465B"
                                   FontWeight="SemiBold" />
                        <TextBox x:Name="ServerAddressTextBox"
                                 Margin="0,7,0,18"
                                 AutomationProperties.Name="服务器地址"
                                 ToolTip="例如 https://relay.example.com/" />
                        <TextBlock Text="用户名"
                                   Foreground="#FF31465B"
                                   FontWeight="SemiBold" />
                        <TextBox x:Name="UserNameTextBox"
                                 Margin="0,7,0,18"
                                 AutomationProperties.Name="用户名" />
                        <TextBlock Text="密码"
                                   Foreground="#FF31465B"
                                   FontWeight="SemiBold" />
                        <PasswordBox x:Name="PasswordInput"
                                     Margin="0,7,0,24"
                                     AutomationProperties.Name="密码" />
                        <Button x:Name="LoginButton"
                                Content="登录"
                                IsDefault="True"
                                Background="#FF1677D2"
                                Foreground="White"
                                BorderBrush="#FF0F69BD"
                                FontWeight="SemiBold"
                                Click="OnLoginClicked" />
                    </StackPanel>
                </Border>

                <Grid x:Name="AccountPanel" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Padding="14"
                            Background="White"
                            BorderBrush="#FFDCE5EF"
                            BorderThickness="1"
                            CornerRadius="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Margin="8,6,8,12"
                                       Text="会话"
                                       Foreground="#FF25394D"
                                       FontSize="18"
                                       FontWeight="SemiBold" />
                            <ListBox x:Name="ConversationList"
                                     Grid.Row="1"
                                     AutomationProperties.Name="会话列表"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.CanContentScroll="True"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     SelectionChanged="OnConversationSelectionChanged">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,0,0,4" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="10,9">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="34"
                                                    Height="34"
                                                    VerticalAlignment="Top"
                                                    Background="#FFE5F1FC"
                                                    CornerRadius="17">
                                                <TextBlock Text="{Binding AvatarText}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="#FF1677D2"
                                                           FontWeight="SemiBold" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="#FF25394D"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Preview}"
                                                           Margin="0,3,0,0"
                                                           Foreground="#FF718396"
                                                           FontSize="12"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding MutedLabel}"
                                                           Margin="0,2,0,0"
                                                           Foreground="#FF94A1AE"
                                                           FontSize="11" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding Timestamp}"
                                                           Foreground="#FF94A1AE"
                                                           FontSize="10" />
                                                <Border Margin="0,6,0,0"
                                                        Padding="6,2"
                                                        HorizontalAlignment="Right"
                                                        Background="#FFE14848"
                                                        CornerRadius="8">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasUnread}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding UnreadText}"
                                                               Foreground="White"
                                                               FontSize="10"
                                                               FontWeight="SemiBold" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="ConversationEmptyText"
                                       Grid.Row="1"
                                       Margin="18"
                                       Text="正在读取账户会话…"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="#FF8796A5"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </Border>

                    <Border Grid.Column="2"
                            Padding="32"
                            Background="White"
                            BorderBrush="#FFDCE5EF"
                            BorderThickness="1"
                            CornerRadius="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <Border Width="64"
                                        Height="64"
                                        HorizontalAlignment="Center"
                                        Background="#FFE5F1FC"
                                        CornerRadius="32">
                                    <TextBlock Text="✓"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="#FF1677D2"
                                               FontSize="30"
                                               FontWeight="Bold" />
                                </Border>
                                <TextBlock x:Name="ConversationHeadingText"
                                           Margin="0,18,0,0"
                                           Text="请选择会话"
                                           HorizontalAlignment="Center"
                                           Foreground="#FF25394D"
                                           FontSize="18"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="NavigationNoticeText"
                                           Margin="20,9,20,0"
                                           Text="消息视图尚未接入；此页面不会展示伪造的聊天内容。"
                                           AutomationProperties.LiveSetting="Polite"
                                           HorizontalAlignment="Center"
                                           Foreground="#FF718396"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Row="1"
                                        HorizontalAlignment="Center"
                                        Orientation="Horizontal">
                                <Button x:Name="RetryButton"
                                        Content="重试连接"
                                        Margin="0,0,10,0"
                                        Click="OnRetryClicked" />
                                <Button x:Name="LogoutButton"
                                        Content="退出账户"
                                        Click="OnLogoutClicked" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <ProgressBar x:Name="BusyIndicator"
                         Grid.Row="2"
                         Height="3"
                         AutomationProperties.Name="账户操作进行中"
                         IsIndeterminate="True"
                         Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>
