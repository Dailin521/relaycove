                                                                   VerticalAlignment="Center"
                                                                   Foreground="#FFB05A32"
                                                                   FontSize="11" />
                                                        <Button Content="复制"
                                                                Margin="0,0,6,0"
                                                                Padding="8,2"
                                                                Click="OnCopyMessageClicked">
                                                            <Button.Style>
                                                                <Style TargetType="Button">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding CanCopy}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                        <Button Content="回复"
                                                                Margin="0,0,6,0"
                                                                Padding="8,2"
                                                                Tag="{Binding ServerMessageId}"
                                                                Click="OnReplyMessageClicked">
                                                            <Button.Style>
                                                                <Style TargetType="Button">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding CanReply}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                        <Button Content="重试"
                                                                Padding="8,2"
                                                                Tag="{Binding ClientMessageId}"
