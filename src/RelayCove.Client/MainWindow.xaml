<Window x:Class="RelayCove.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:RelayCove.Client.Controls"
        xmlns:presentation="clr-namespace:RelayCove.Client.Presentation"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="RelayCove"
        Height="680"
        Width="1280"
        MinHeight="520"
        MinWidth="900"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource RcCanvasBrush}"
        FontFamily="Segoe UI"
        StateChanged="OnMainWindowStateChanged"
        SizeChanged="OnMainWindowSizeChanged"
        PreviewKeyDown="OnMainWindowPreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48"
                            ResizeBorderThickness="8"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#FF1677D2" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#FFEAF3FF" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FF1F2328" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF596B7C" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="CanvasBrush" Color="#FFF5F7FA" />
        <SolidColorBrush x:Key="BorderBrush" Color="#FFE5EAF0" />
        <SolidColorBrush x:Key="DangerBrush" Color="#FFD92D20" />
        <Style x:Key="WindowButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FFD8EAFE" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource WindowButtonStyle}">
            <Setter Property="MinHeight" Value="34" />
        </Style>
        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource WindowButtonStyle}">
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PrimaryButtonBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PrimaryButtonBorder" Property="Background" Value="#FF0958D9" />
                                <Setter TargetName="PrimaryButtonBorder" Property="BorderBrush" Value="#FF0958D9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PrimaryButtonBorder" Property="Background" Value="#FF003EB3" />
                                <Setter TargetName="PrimaryButtonBorder" Property="BorderBrush" Value="#FF003EB3" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SubtleButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource WindowButtonStyle}">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style x:Key="MessageActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource WindowButtonStyle}">
            <Setter Property="MinWidth" Value="42" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource RcTextSecondaryBrush}" />
        </Style>
        <Style x:Key="HeaderIconButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource WindowButtonStyle}">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource RcTextSecondaryBrush}" />
        </Style>
        <Style x:Key="ComposerIconButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource WindowButtonStyle}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource RcTextSecondaryBrush}" />
        </Style>
        <Style x:Key="ConversationFilterButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource WindowButtonStyle}">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource RcTextSecondaryBrush}" />
        </Style>
        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#FFFDA29B" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource RcCanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LoginBrandColumn" Width="270" />
            <ColumnDefinition x:Name="MainContentColumn" Width="*" />
        </Grid.ColumnDefinitions>

        <controls:TitleBarControl x:Name="ApplicationTitleBar"
                                  Grid.ColumnSpan="2"
                                  Title="RelayCove"
                                  DragRequested="OnTitleBarDragRequested"
                                  MinimizeRequested="OnTitleBarMinimizeRequested"
                                  MaximizeRestoreRequested="OnTitleBarMaximizeRestoreRequested"
                                  CloseRequested="OnTitleBarCloseRequested"
                                  SystemMenuRequested="OnTitleBarSystemMenuRequested" />

        <Border x:Name="LoginBrandPanel" Grid.Row="1" Grid.Column="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0" Color="#FF0958D9" />
                    <GradientStop Offset="1" Color="#FF1677D2" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="28,32,28,26">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="RelayCove"
                               Foreground="White"
                               FontWeight="SemiBold"
                               FontSize="27" />
                    <TextBlock Text="团队消息，安全抵达"
                               Margin="0,5,0,0"
                               Foreground="#FFEAF3FF"
                               FontSize="13" />
                </StackPanel>

                <Border Grid.Row="1"
                        Margin="0,32,0,0"
                        Padding="13,11"
                        Background="#24FFFFFF"
                        BorderBrush="#38FFFFFF"
                        BorderThickness="1"
                        CornerRadius="8">
                    <StackPanel>
                        <TextBlock x:Name="SidebarConnectionText"
                                   Text="实时连接：未连接"
                                   AutomationProperties.LiveSetting="Polite"
                                   Foreground="#FFE7F0F8"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="SidebarSyncText"
                                   Text="同步：尚未完成"
                                   AutomationProperties.LiveSetting="Polite"
                                   Margin="0,5,0,0"
                                   Foreground="#FFEAF3FF"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="SidebarNotificationText"
                                   Text="系统通知：初始化中"
                                   AutomationProperties.LiveSetting="Polite"
                                   Margin="0,5,0,0"
                                   Foreground="#FFEAF3FF"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="2" Margin="0,34,0,0">
                    <TextBlock Text="当前账户"
                               Foreground="#FFCAE5FF"
                               FontWeight="SemiBold"
                               FontSize="12" />
                    <TextBlock x:Name="SidebarDisplayNameText"
                               Margin="0,8,0,0"
                               Text="尚未登录"
                               AutomationProperties.LiveSetting="Polite"
                               Foreground="White"
                               FontSize="16"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="SidebarServerText"
                               Margin="0,5,0,0"
                               Text="—"
                               AutomationProperties.LiveSetting="Polite"
                               Foreground="#FFEAF3FF"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis" />
                    <Button x:Name="CheckForUpdatesButton"
                            Margin="0,14,0,0"
                            Padding="10,5"
                            HorizontalAlignment="Left"
                            Content="检查更新"
                            AutomationProperties.Name="检查更新"
                            Click="OnCheckForUpdatesClicked" />
                    <TextBlock x:Name="UpdateStatusText"
                               Margin="0,8,0,0"
                               AutomationProperties.LiveSetting="Polite"
                               Foreground="#FFEAF3FF"
                               Text="更新：尚未检查"
                               TextWrapping="Wrap" />
                </StackPanel>

                <TextBlock x:Name="SidebarUnreadText"
                           Grid.Row="3"
                           Text="未读计数：0"
                           AutomationProperties.LiveSetting="Polite"
                           Foreground="#FFCAE5FF"
                           FontSize="12" />
            </Grid>
        </Border>

        <Grid x:Name="MainContentPanel" Grid.Row="1" Grid.Column="1" Margin="42,34">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock x:Name="HeadingText"
                           Text="正在启动 RelayCove"
                           AutomationProperties.LiveSetting="Polite"
                           Foreground="#FF17263A"
                           FontSize="28"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="DetailText"
                           Margin="0,8,0,0"
                           MaxWidth="680"
                           AutomationProperties.LiveSetting="Polite"
                           HorizontalAlignment="Left"
                           Text="正在准备本地账户环境。"
                           Foreground="#FF5C6F82"
                           FontSize="14"
                           TextWrapping="Wrap" />
            </StackPanel>

            <Grid x:Name="MainWorkspace" Grid.Row="1" Margin="0,30,0,24">
                <Border x:Name="LoginPanel"
                        MaxWidth="500"
                        Padding="34"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        Background="White"
                        BorderBrush="#FFDCE5EF"
                        BorderThickness="1"
                        CornerRadius="12">
                    <StackPanel>
                        <TextBlock x:Name="LoginPanelHeadingText"
                                   Text="登录到工作区"
                                   Foreground="{DynamicResource RcTextPrimaryBrush}"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="LoginPanelSubtitleText"
                                   Margin="0,5,0,24"
                                   Text="输入团队服务器地址和账号信息。"
                                   Foreground="{DynamicResource RcTextSecondaryBrush}"
                                   FontSize="12" />
                        <TextBlock Text="服务器地址"
                                   Foreground="#FF31465B"
                                   FontWeight="SemiBold" />
                        <TextBox x:Name="ServerAddressTextBox"
                                 Margin="0,7,0,18"
                                 AutomationProperties.Name="服务器地址"
                                 ToolTip="例如 https://relay.example.com/" />
                        <TextBlock Text="用户名"
                                   Foreground="#FF31465B"
                                   FontWeight="SemiBold" />
                        <TextBox x:Name="UserNameTextBox"
                                 Margin="0,7,0,18"
                                 AutomationProperties.Name="用户名" />
                        <TextBlock Text="密码"
                                   Foreground="#FF31465B"
                                   FontWeight="SemiBold" />
                         <PasswordBox x:Name="PasswordInput"
                                      Margin="0,7,0,24"
                                      AutomationProperties.Name="密码" />
                        <Button x:Name="LoginButton"
                                Content="登录"
                                IsDefault="True"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="OnLoginClicked" />
                    </StackPanel>
                </Border>

                <Grid x:Name="AccountPanel" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="NavigationRailColumn" Width="72" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition x:Name="ConversationPanelColumn" Width="340" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <controls:NavigationRailControl x:Name="ApplicationNavigation"
                                                    Grid.Column="0"
                                                    NavigationRequested="OnNavigationRequested"
                                                    UnavailableFeatureRequested="OnUnavailableFeatureRequested" />

                    <controls:ConversationPanelControl x:Name="ConversationPanel"
                                                        Grid.Column="2"
                                                        CornerRadius="12"
                                                        InteractionRequested="OnConversationPanelInteractionRequested" />

                    <Border x:Name="ConversationChatPanel"
                            Grid.Column="4"
                            Padding="28,22,28,18"
                            Background="White"
                            BorderBrush="#FFF0F2F5"
                            BorderThickness="1"
                            CornerRadius="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition x:Name="ComposerRow" Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <controls:ChatHeaderControl x:Name="ChatHeader"
                                                        HorizontalAlignment="Left"
                                                        MembersRequested="OnChatHeaderMembersRequested"
                                                        SearchRequested="OnChatHeaderSearchRequested"
                                                        UnavailableFeatureRequested="OnUnavailableFeatureRequested" />

                            <Grid Grid.Row="1"
                                  Margin="0,10,0,6"
                                  HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="LoadOlderButton"
                                        Content="加载更早消息"
                                        MinHeight="30"
                                        Padding="12,5"
                                        Visibility="Collapsed"
                                        Click="OnLoadOlderMessagesClicked" />
                                <TextBlock x:Name="MessageStatusText"
                                           Grid.Column="1"
                                           Margin="12,0,0,0"
                                           Text="请选择会话"
                                           Visibility="Collapsed"
                                           AutomationProperties.LiveSetting="Polite"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap" />
                            </Grid>

                            <controls:MessageListControl x:Name="MessageListPanel"
                                                         Grid.Row="2"
                                                         HorizontalAlignment="Left"
                                                         InteractionRequested="OnMessageListInteractionRequested" />

                            <controls:ComposerControl x:Name="Composer"
                                                      Grid.Row="3"
                                                      Margin="0,14,0,0"
                                                      HorizontalAlignment="Left"
                                                      InteractionRequested="OnComposerInteractionRequested" />

                            <StackPanel Grid.Row="4"
                                        Margin="0,14,0,0"
                                        HorizontalAlignment="Center"
                                        Orientation="Horizontal"
                                        Visibility="Collapsed">
                                <Button x:Name="RetryButton"
                                        Content="重试连接"
                                        Margin="0,0,10,0"
                                        Click="OnRetryClicked" />
                                <Button x:Name="LogoutButton"
                                        Content="退出账户"
                                        Click="OnLogoutClicked" />
                            </StackPanel>

                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <ProgressBar x:Name="BusyIndicator"
                         Grid.Row="2"
                         Height="3"
                         AutomationProperties.Name="账户操作进行中"
                         IsIndeterminate="True"
                         Visibility="Collapsed" />
        </Grid>
        <Grid x:Name="SearchPanel"
              Grid.Row="1"
              Grid.Column="1"
              Panel.ZIndex="130"
             Visibility="Collapsed"
             Background="{DynamicResource RcOverlayBrush}"
             KeyboardNavigation.TabNavigation="Cycle"
             AutomationProperties.Name="消息搜索对话框">
                             <Border MaxWidth="760"
                MinHeight="360"
                MaxHeight="640"
               Margin="28"
               Padding="22"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Center"
               Background="{DynamicResource RcSurfaceBrush}"
               BorderBrush="{DynamicResource RcBorderBrush}"
               BorderThickness="1"
               CornerRadius="12"
               Effect="{DynamicResource RcPanelShadow}">
           <Grid>
               <Grid.RowDefinitions>
                   <RowDefinition Height="Auto" />
                   <RowDefinition Height="Auto" />
                   <RowDefinition Height="Auto" />
                   <RowDefinition Height="*" />
               </Grid.RowDefinitions>

               <Grid>
                   <Grid.ColumnDefinitions>
                       <ColumnDefinition Width="*" />
                       <ColumnDefinition Width="Auto" />
                   </Grid.ColumnDefinitions>
                   <StackPanel>
                       <TextBlock Text="搜索聊天记录"
             Foreground="#FF25394D"
             FontSize="20"
             FontWeight="SemiBold" />
                       <TextBlock Margin="0,4,0,0"
             Text="显式搜索消息正文与附件原名"
             Foreground="#FF596B7C" />
                   </StackPanel>
                   <Button x:Name="CloseSearchButton"
                           Grid.Column="1"
                           MinHeight="30"
                           Padding="12,4"
                           AutomationProperties.Name="关闭消息搜索"
                           Content="关闭"
                           Click="OnCloseSearchClicked" />
               </Grid>

               <Grid Grid.Row="1" Margin="0,18,0,10">
                   <Grid.ColumnDefinitions>
                       <ColumnDefinition Width="*" />
                       <ColumnDefinition Width="150" />
                       <ColumnDefinition Width="Auto" />
                   </Grid.ColumnDefinitions>
                   <Grid>
                       <Path Width="16"
                             Height="16"
                             Margin="12,0,0,0"
                             Panel.ZIndex="1"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Center"
                             IsHitTestVisible="False"
                             Data="{DynamicResource RcIconSearch}"
                             Stretch="Uniform"
                             Stroke="{DynamicResource RcTextSecondaryBrush}"
                             StrokeThickness="1.5" />
                       <TextBox x:Name="MessageSearchTextBox"
                                Padding="36,7,10,7"
                                AutomationProperties.Name="搜索关键词"
                                ToolTip="输入 1–64 个字符后按 Enter 或点击搜索"
                                TextChanged="OnMessageSearchTextChanged"
                                PreviewKeyDown="OnMessageSearchPreviewKeyDown" />
                   </Grid>
                   <ComboBox x:Name="MessageSearchScopeComboBox"
        Grid.Column="1"
        Margin="10,0,0,0"
        MinHeight="40"
        Style="{DynamicResource RcComboBoxStyle}"
        AutomationProperties.Name="搜索范围"
        SelectionChanged="OnMessageSearchScopeChanged" />
                   <Button x:Name="RunSearchButton"
                           Grid.Column="2"
                           Margin="10,0,0,0"
                           Padding="18,7"
                           AutomationProperties.Name="执行消息搜索"
                           Content="搜索"
                           Click="OnRunSearchClicked" />
               </Grid>

               <TextBlock x:Name="MessageSearchStatusText"
                          Grid.Row="2"
                          Margin="0,0,0,10"
                          Text="输入关键词并选择搜索范围。"
                          AutomationProperties.LiveSetting="Polite"
                          Foreground="#FF596B7C"
                          TextWrapping="Wrap" />

                <Grid Grid.Row="3" MinHeight="190">
                <ListBox x:Name="MessageSearchResultList"
                         AutomationProperties.Name="消息搜索结果"
                         Background="{DynamicResource RcCanvasBrush}"
                         BorderBrush="{DynamicResource RcBorderBrush}"
                         BorderThickness="1"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                   <ListBox.ItemContainerStyle>
                       <Style TargetType="ListBoxItem">
                           <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                           <Setter Property="Padding" Value="0" />
                           <Setter Property="Margin" Value="6,3" />
                       </Style>
                   </ListBox.ItemContainerStyle>
                   <ListBox.ItemTemplate>
                       <DataTemplate>
                           <Button Padding="12,10"
              HorizontalContentAlignment="Stretch"
               AutomationProperties.Name="{Binding AutomationName}"
              Background="White"
              BorderBrush="#FFDCE5EF"
              Click="OnSearchResultClicked">
          <StackPanel>
              <Grid>
                  <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding ConversationAndSender}"
        Foreground="#FF1677D2"
        FontWeight="SemiBold"
        TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1"
        Margin="12,0,0,0"
        Text="{Binding Timestamp}"
        Foreground="#FF596B7C"
        FontSize="11" />
              </Grid>
              <TextBlock Margin="0,6,0,0"
                         Text="{Binding Snippet}"
                         Foreground="#FF25394D"
                         TextWrapping="Wrap"
                         MaxHeight="66" />
              <TextBlock Margin="0,5,0,0"
                         Text="{Binding AttachmentLabel}"
                         Foreground="#FF5C6F82"
                         FontSize="12">
                  <TextBlock.Style>
                      <Style TargetType="TextBlock">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
         <DataTrigger Binding="{Binding HasMatchedAttachment}" Value="True">
             <Setter Property="Visibility" Value="Visible" />
         </DataTrigger>
                          </Style.Triggers>
                      </Style>
                  </TextBlock.Style>
              </TextBlock>
          </StackPanel>
                           </Button>
                       </DataTemplate>
                   </ListBox.ItemTemplate>
                </ListBox>
                <Border x:Name="MessageSearchEmptyState"
                        IsHitTestVisible="False"
                        Background="{DynamicResource RcCanvasBrush}"
                        BorderBrush="{DynamicResource RcBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasItems, ElementName=MessageSearchResultList}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Width="300"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Border Width="42"
                                Height="42"
                                HorizontalAlignment="Center"
                                Background="{DynamicResource RcPrimarySoftBrush}"
                                CornerRadius="21">
                            <Path Width="18"
                                  Height="18"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="{DynamicResource RcIconSearch}"
                                  Stretch="Uniform"
                                  Stroke="{DynamicResource RcPrimaryBrush}"
                                  StrokeThickness="1.6" />
                        </Border>
                        <TextBlock x:Name="MessageSearchEmptyTitleText"
                                   HorizontalAlignment="Center"
                                   Margin="0,10,0,0"
                                   Text="搜索结果将在这里显示"
                                   Foreground="{DynamicResource RcTextPrimaryBrush}"
                                   FontWeight="SemiBold" />
                        <TextBlock Margin="0,6,0,0"
                                   HorizontalAlignment="Center"
                                   Text="{Binding Text, ElementName=MessageSearchStatusText}"
                                   Foreground="{DynamicResource RcTextSecondaryBrush}"
                                   FontSize="12"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                </Grid>
           </Grid>
                            </Border>
                            </Grid>
        <controls:UiNoticeHost x:Name="UnavailableFeatureNotice"
                               Grid.Row="1"
                               Grid.ColumnSpan="2"
                               Panel.ZIndex="80" />
        <Grid x:Name="ChannelOverlay"
               Grid.Row="1"
               Grid.Column="1"
               Panel.ZIndex="140"
               Visibility="Collapsed"
               Background="Transparent"
               VerticalAlignment="Stretch"
              Focusable="True"
              KeyboardNavigation.TabNavigation="Cycle"
              AutomationProperties.Name="成员侧栏">
            <Border x:Name="ChannelDrawerSurface"
                    Width="380"
                    Margin="0,12,16,12"
                    Padding="20,18"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Stretch"
                    Background="{DynamicResource RcSurfaceBrush}"
                    BorderBrush="{DynamicResource RcBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Effect="{DynamicResource RcPanelShadow}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False">
                    <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="成员与频道"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource RcTextPrimaryBrush}" />
                        <TextBlock x:Name="ChannelPanelSubtitleText"
                                   Margin="0,4,0,0"
                                   Text="查看成员并管理私有频道"
                                   Foreground="{DynamicResource RcTextSecondaryBrush}"
                                   FontSize="12" />
                    </StackPanel>
                    <Button x:Name="CloseChannelPanelButton"
                             Grid.Column="1"
                             Width="32"
                             Height="32"
                             MinHeight="32"
                             Padding="6"
                             Background="Transparent"
                             BorderBrush="Transparent"
                             ToolTip="关闭"
                             AutomationProperties.Name="关闭频道与成员面板"
                             Click="OnCloseChannelPanelClicked">
                        <Path Data="{DynamicResource RcIconClose}"
                              Width="16"
                              Height="16"
                              Stretch="Uniform"
                              Stroke="{DynamicResource RcTextSecondaryBrush}"
                              StrokeThickness="1.6" />
                    </Button>
                    <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,18,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Path Width="16"
                                  Height="16"
                                  Margin="12,0,0,0"
                                  Panel.ZIndex="1"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  IsHitTestVisible="False"
                                  Data="{DynamicResource RcIconSearch}"
                                  Stretch="Uniform"
                                  Stroke="{DynamicResource RcTextSecondaryBrush}"
                                  StrokeThickness="1.5" />
                            <TextBox x:Name="ChannelMemberSearchTextBox"
                                     Padding="36,7,10,7"
                                     AutomationProperties.Name="搜索频道成员"
                                     ToolTip="按昵称或账号搜索"
                                     TextChanged="OnChannelMemberSearchTextChanged" />
                        </Grid>
                        <StackPanel x:Name="ChannelUserDirectorySection" Grid.Row="1">
                            <Border Padding="12"
                                    Background="{DynamicResource RcCanvasBrush}"
                                    BorderBrush="{DynamicResource RcBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                            <Expander x:Name="CreateChannelExpander"
                                      Header="创建频道"
                                      Style="{DynamicResource RcExpanderStyle}">
                            <StackPanel Margin="0,8,0,0">
                            <TextBox x:Name="ChannelNameInput"
                                     Margin="0,7,0,7"
                                     MaxLength="100"
                                     AutomationProperties.Name="新频道名称"
                                     ToolTip="输入频道名称"
                                     TextChanged="OnChannelNameTextChanged" />
                            <ComboBox x:Name="ChannelTypeComboBox"
                                      MinHeight="36"
                                      Style="{DynamicResource RcComboBoxStyle}"
                                      AutomationProperties.Name="新频道类型" />
                            <Button x:Name="CreateChannelButton"
                                    Margin="0,9,0,0"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Content="创建频道"
                                    Click="OnCreateChannelClicked" />
                            </StackPanel>
                             </Expander>
                            </Border>
                            <Border Margin="0,14,0,0"
                                    Padding="12"
                                    Background="{DynamicResource RcCanvasBrush}"
                                    BorderBrush="{DynamicResource RcBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                            <StackPanel>
                             <TextBlock
                                        Text="可添加成员"
                                        FontWeight="SemiBold" />
                            <TextBlock Margin="0,3,0,6"
                                       Text="在私有频道中点击“拉入”。"
                                        Foreground="{DynamicResource RcTextSecondaryBrush}"
                                       FontSize="11" />
                             <TextBlock x:Name="ChannelUserDirectoryStatusText"
                                        Margin="0,2,0,0"
                                        Foreground="{DynamicResource RcTextSecondaryBrush}"
                                        FontSize="11"
                                        TextWrapping="Wrap"
                                        AutomationProperties.LiveSetting="Polite" />
                             <ListBox x:Name="ChannelUserDirectoryList"
                                     MaxHeight="190"
                                     Margin="0,6,0,0"
                                      BorderThickness="0"
                                      Background="Transparent"
                                     AutomationProperties.Name="团队成员目录">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="38" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="30" Height="30" Background="{StaticResource AccentSoftBrush}" CornerRadius="15">
                                                <TextBlock Text="{Binding AvatarText}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           FontWeight="SemiBold" />
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding UserName, StringFormat=@{0}}"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               FontSize="11" />
                                                    <TextBlock Text="{Binding RoleLabel, StringFormat= · {0}}"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               FontSize="11" />
                                                </StackPanel>
                                            </StackPanel>
                                            <Button Grid.Column="2"
                                                    MinWidth="52"
                                                    Padding="8,2"
                                                    Content="拉入"
                                                    IsEnabled="{Binding CanInvite}"
                                                    Click="OnInviteChannelMemberClicked" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                             </ListBox>
                            </StackPanel>
                            </Border>
                        </StackPanel>
                        <Border Grid.Row="2"
                                Margin="0,14,0,0"
                                Padding="12"
                                Background="{DynamicResource RcCanvasBrush}"
                                BorderBrush="{DynamicResource RcBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                        <StackPanel>
                            <TextBlock x:Name="ChannelCurrentHeadingText"
                                       Text="当前会话成员"
                                       FontSize="18"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="ChannelMemberHelpText"
                                       Margin="0,4,0,8"
                                       Text="选择会话后显示成员。"
                                        Foreground="{DynamicResource RcTextSecondaryBrush}"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="ChannelParticipantStatusText"
                                       Margin="0,2,0,0"
                                       Foreground="{DynamicResource RcTextSecondaryBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       AutomationProperties.LiveSetting="Polite" />
                            <ListBox x:Name="ChannelParticipantList"
                                     MaxHeight="230"
                                     Margin="0,6,0,0"
                                     BorderThickness="0"
                                     AutomationProperties.Name="当前会话成员列表">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="6,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="38" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="30" Height="30" Background="{StaticResource AccentSoftBrush}" CornerRadius="15">
                                                <TextBlock Text="{Binding AvatarText}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           FontWeight="SemiBold" />
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding UserName, StringFormat=@{0}}"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               FontSize="11" />
                                                    <TextBlock Text="{Binding RoleLabel, StringFormat= · {0}}"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               FontSize="11" />
                                                </StackPanel>
                                            </StackPanel>
                                            <Button Grid.Column="2"
                                                    Style="{StaticResource DangerButtonStyle}"
                                                    MinWidth="52"
                                                    Padding="8,2"
                                                    Content="移除"
                                                    IsEnabled="{Binding CanRemove}"
                                                    Click="OnRemoveChannelMemberClicked" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                             </ListBox>
                        </StackPanel>
                        </Border>
                    </Grid>
                    <TextBlock x:Name="ChannelLiveRegionText"
                               Grid.Row="2"
                               Grid.ColumnSpan="2"
                               Margin="0,14,0,0"
                               Text="准备就绪。"
                                Foreground="{DynamicResource RcPrimaryBrush}"
                               TextWrapping="Wrap"
                                AutomationProperties.Name="频道操作状态"
                                AutomationProperties.LiveSetting="Assertive">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="准备就绪。">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>
        <controls:SettingsPanelControl x:Name="SettingsOverlay"
                                       Grid.Row="1"
                                       Grid.ColumnSpan="2"
                                       Panel.ZIndex="130"
                                       Width="396"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Stretch"
                                       Visibility="Collapsed"
                                       CloseRequested="OnSettingsCloseRequested"
                                       CheckForUpdatesRequested="OnSettingsCheckForUpdatesRequested"
                                        ReconnectRequested="OnSettingsReconnectRequested"
                                        ExitAccountRequested="OnSettingsExitAccountRequested"
                                        OptionalUpdateActionRequested="OnSettingsOptionalUpdateActionRequested" />
        <Grid x:Name="AttachmentImageViewerOverlay"
              Grid.Row="1"
              Grid.ColumnSpan="2"
              Panel.ZIndex="100"
              Visibility="Collapsed"
              Background="{DynamicResource RcOverlayBrush}"
              Focusable="True"
              KeyboardNavigation.TabNavigation="Cycle"
              AutomationProperties.Name="图片查看器"
              AutomationProperties.LiveSetting="Polite">
            <Border MaxWidth="980"
                    MaxHeight="720"
                    Margin="36"
                    Padding="18"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#FF1F2937"
                    BorderBrush="#FF475467"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="AttachmentImageViewerTitleText"
                               Foreground="White"
                               FontSize="16"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               AutomationProperties.Name="图片查看器标题" />
                    <Button x:Name="CloseAttachmentImageViewerButton"
                             Grid.Column="1"
                             Margin="12,0,0,0"
                             Width="32"
                             Height="32"
                             MinHeight="32"
                             Padding="6"
                             Background="#FF344054"
                             BorderBrush="#FF475467"
                             ToolTip="关闭"
                             AutomationProperties.Name="关闭图片查看器"
                             Click="OnCloseAttachmentImageViewerClicked">
                        <Path Data="{DynamicResource RcIconClose}"
                              Width="16"
                              Height="16"
                              Stretch="Uniform"
                              Stroke="White"
                              StrokeThickness="1.6" />
                    </Button>
                    <Image x:Name="AttachmentImageViewerImage"
                           Grid.Row="1"
                           Grid.ColumnSpan="2"
                           MaxWidth="920"
                           MaxHeight="620"
                           Margin="0,14,0,12"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Stretch="Uniform"
                           AutomationProperties.Name="当前图片预览" />
                    <StackPanel Grid.Row="1"
                                Grid.ColumnSpan="2"
                                Width="260"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Source, ElementName=AttachmentImageViewerImage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Border Width="48"
                                Height="48"
                                HorizontalAlignment="Center"
                                Background="#FF344054"
                                CornerRadius="24">
                            <Path Width="20"
                                  Height="20"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="{DynamicResource RcIconFolder}"
                                  Stretch="Uniform"
                                  Stroke="#FFD0D5DD"
                                  StrokeThickness="1.6" />
                        </Border>
                        <TextBlock x:Name="AttachmentImageViewerEmptyTitleText"
                                   Margin="0,12,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="White"
                                   FontWeight="SemiBold"
                                   Text="正在准备图片预览" />
                        <TextBlock x:Name="AttachmentImageViewerEmptyDetailText"
                                   Margin="0,5,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="#FFD0D5DD"
                                   FontSize="12"
                                   Text="加载完成后会在这里显示。"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock x:Name="AttachmentImageViewerStatusText"
                               Grid.Row="2"
                               Grid.ColumnSpan="2"
                               Foreground="#FFD7E2ED"
                               FontSize="11"
                               Text="受限预览：图片已按安全显示上限处理。"
                               TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite" />
                </Grid>
            </Border>
        </Grid>
        <Grid x:Name="MandatoryUpdateOverlay"
              Grid.Row="1"
              Grid.ColumnSpan="2"
              Panel.ZIndex="200"
              Visibility="Collapsed"
              Background="{DynamicResource RcOverlayBrush}"
              Focusable="True"
              KeyboardNavigation.TabNavigation="Cycle"
              AutomationProperties.Name="需要更新"
              AutomationProperties.LiveSetting="Assertive">
            <Border MaxWidth="620"
                    MaxHeight="540"
                    Margin="36"
                    Padding="32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource RcSurfaceBrush}"
                    BorderBrush="{DynamicResource RcPrimaryBrush}"
                    BorderThickness="2"
                    CornerRadius="12"
                    Effect="{DynamicResource RcPanelShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="需要更新 RelayCove"
                               Foreground="{DynamicResource RcTextPrimaryBrush}"
                               FontSize="24"
                               FontWeight="SemiBold" />
                    <ScrollViewer x:Name="MandatoryUpdateNotesScrollViewer"
                                  Grid.Row="1"
                                  Margin="0,12,0,0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="True">
                        <TextBlock x:Name="MandatoryUpdateDetailText"
                                   Foreground="{DynamicResource RcTextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite" />
                    </ScrollViewer>
                    <StackPanel Grid.Row="2" Margin="0,12,0,0">
                        <TextBlock x:Name="MandatoryUpdateProgressText"
                                   Foreground="{DynamicResource RcPrimaryBrush}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite" />
                        <ProgressBar x:Name="MandatoryUpdateProgressBar"
                                     Margin="0,8,0,0"
                                     Height="8"
                                     Minimum="0"
                                     Maximum="100"
                                     Visibility="Collapsed" />
                        <TextBlock x:Name="MandatoryUpdateErrorText"
                                   Margin="0,12,0,0"
                                   Foreground="{DynamicResource RcDangerBrush}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Assertive" />
                    </StackPanel>
                    <WrapPanel Grid.Row="3" Margin="0,22,0,0">
                        <Button x:Name="RetryMandatoryUpdateButton"
                                Margin="0,0,10,0"
                                Content="重新检查"
                                Click="OnRetryMandatoryUpdateClicked" />
                        <Button x:Name="DownloadMandatoryUpdateButton"
                                Margin="0,0,10,0"
                                Content="下载更新"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="OnDownloadUpdateClicked" />
                        <Button x:Name="CancelMandatoryUpdateButton"
                                Margin="0,0,10,0"
                                Content="取消下载"
                                Visibility="Collapsed"
                                Click="OnCancelUpdateDownloadClicked" />
                        <Button x:Name="ApplyMandatoryUpdateButton"
                                Margin="0,0,10,0"
                                Content="关闭并更新"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Visibility="Collapsed"
                                Click="OnApplyUpdateClicked" />
                        <Button x:Name="ExitMandatoryUpdateButton"
                                Content="退出 RelayCove"
                                Click="OnExitForMandatoryUpdateClicked" />
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
