              AutomationProperties.Name="图片查看器"
              AutomationProperties.LiveSetting="Polite">
            <Border MaxWidth="980"
                    MaxHeight="720"
                    Margin="36"
                    Padding="18"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#FF10243E"
                    BorderBrush="#FF52708C"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
