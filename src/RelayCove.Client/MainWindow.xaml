<Window x:Class="RelayCove.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RelayCove"
        Height="680"
        Width="1060"
        MinHeight="520"
        MinWidth="820"
        WindowStartupLocation="CenterScreen"
        Background="#FFF4F7FB"
        FontFamily="Segoe UI"
        PreviewKeyDown="OnMainWindowPreviewKeyDown">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#FF10243E">
            <Grid Margin="28,32,28,26">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="RelayCove"
                               Foreground="White"
                               FontWeight="SemiBold"
                               FontSize="27" />
                    <TextBlock Text="团队消息，安全抵达"
                               Margin="0,5,0,0"
                               Foreground="#FF9FB3C8"
                               FontSize="13" />
                </StackPanel>

                <Border Grid.Row="1"
                        Margin="0,32,0,0"
                        Padding="13,11"
                        Background="#FF19334F"
                        CornerRadius="8">
                    <StackPanel>
                        <TextBlock x:Name="SidebarConnectionText"
                                   Text="实时连接：未连接"
                                   AutomationProperties.LiveSetting="Polite"
                                   Foreground="#FFE7F0F8"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="SidebarSyncText"
                                   Text="同步：尚未完成"
                                   AutomationProperties.LiveSetting="Polite"
                                   Margin="0,5,0,0"
                                   Foreground="#FF9FB3C8"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="SidebarNotificationText"
                                   Text="系统通知：初始化中"
                                   AutomationProperties.LiveSetting="Polite"
                                   Margin="0,5,0,0"
                                   Foreground="#FF9FB3C8"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="2" Margin="0,34,0,0">
                    <TextBlock Text="当前账户"
                               Foreground="#FF7891AA"
                               FontWeight="SemiBold"
                               FontSize="12" />
                    <TextBlock x:Name="SidebarDisplayNameText"
                               Margin="0,8,0,0"
                               Text="尚未登录"
                               AutomationProperties.LiveSetting="Polite"
                               Foreground="White"
                               FontSize="16"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="SidebarServerText"
                               Margin="0,5,0,0"
                               Text="—"
                               AutomationProperties.LiveSetting="Polite"
                               Foreground="#FF9FB3C8"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <TextBlock x:Name="SidebarUnreadText"
                           Grid.Row="3"
                           Text="未读计数：0"
                           AutomationProperties.LiveSetting="Polite"
                           Foreground="#FF7891AA"
                           FontSize="12" />
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="42,34">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock x:Name="HeadingText"
                           Text="正在启动 RelayCove"
                           AutomationProperties.LiveSetting="Polite"
                           Foreground="#FF17263A"
                           FontSize="28"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="DetailText"
                           Margin="0,8,0,0"
                           MaxWidth="680"
                           AutomationProperties.LiveSetting="Polite"
                           HorizontalAlignment="Left"
                           Text="正在准备本地账户环境。"
                           Foreground="#FF5C6F82"
                           FontSize="14"
                           TextWrapping="Wrap" />
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,30,0,24">
                <Border x:Name="LoginPanel"
                        MaxWidth="500"
                        Padding="34"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        Background="White"
                        BorderBrush="#FFDCE5EF"
                        BorderThickness="1"
                        CornerRadius="12">
                    <StackPanel>
                        <TextBlock Text="服务器地址"
                                   Foreground="#FF31465B"
                                   FontWeight="SemiBold" />
                        <TextBox x:Name="ServerAddressTextBox"
                                 Margin="0,7,0,18"
                                 AutomationProperties.Name="服务器地址"
                                 ToolTip="例如 https://relay.example.com/" />
                        <TextBlock Text="用户名"
                                   Foreground="#FF31465B"
                                   FontWeight="SemiBold" />
                        <TextBox x:Name="UserNameTextBox"
                                 Margin="0,7,0,18"
                                 AutomationProperties.Name="用户名" />
                        <TextBlock Text="密码"
                                   Foreground="#FF31465B"
                                   FontWeight="SemiBold" />
                        <PasswordBox x:Name="PasswordInput"
                                     Margin="0,7,0,24"
                                     AutomationProperties.Name="密码" />
                        <Button x:Name="LoginButton"
                                Content="登录"
                                IsDefault="True"
                                Background="#FF1677D2"
                                Foreground="White"
                                BorderBrush="#FF0F69BD"
                                FontWeight="SemiBold"
                                Click="OnLoginClicked" />
                    </StackPanel>
                </Border>

                <Grid x:Name="AccountPanel" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Padding="14"
                            Background="White"
                            BorderBrush="#FFDCE5EF"
                            BorderThickness="1"
                            CornerRadius="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Margin="8,6,8,12"
                                       Text="会话"
                                       Foreground="#FF25394D"
                                       FontSize="18"
                                       FontWeight="SemiBold" />
                            <ListBox x:Name="ConversationList"
                                     Grid.Row="1"
                                     AutomationProperties.Name="会话列表"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.CanContentScroll="True"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     SelectionChanged="OnConversationSelectionChanged">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,0,0,4" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="10,9">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="34"
                                                    Height="34"
                                                    VerticalAlignment="Top"
                                                    Background="#FFE5F1FC"
                                                    CornerRadius="17">
                                                <TextBlock Text="{Binding AvatarText}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="#FF1677D2"
                                                           FontWeight="SemiBold" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="#FF25394D"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Preview}"
                                                           Margin="0,3,0,0"
                                                           Foreground="#FF718396"
                                                           FontSize="12"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding MutedLabel}"
                                                           Margin="0,2,0,0"
                                                           Foreground="#FF94A1AE"
                                                           FontSize="11" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding Timestamp}"
                                                           Foreground="#FF94A1AE"
                                                           FontSize="10" />
                                                <Border Margin="0,6,0,0"
                                                        Padding="6,2"
                                                        HorizontalAlignment="Right"
                                                        Background="#FFE14848"
                                                        CornerRadius="8">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasUnread}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding UnreadText}"
                                                               Foreground="White"
                                                               FontSize="10"
                                                               FontWeight="SemiBold" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="ConversationEmptyText"
                                       Grid.Row="1"
                                       Margin="18"
                                       Text="正在读取账户会话…"
                                       AutomationProperties.LiveSetting="Polite"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="#FF8796A5"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </Border>

                    <Border Grid.Column="2"
                            Padding="24"
                            Background="White"
                            BorderBrush="#FFDCE5EF"
                            BorderThickness="1"
                            CornerRadius="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="ConversationHeadingText"
                                               Text="请选择会话"
                                               AutomationProperties.LiveSetting="Polite"
                                               Foreground="#FF25394D"
                                               FontSize="20"
                                               FontWeight="SemiBold" />
                                    <TextBlock x:Name="NavigationNoticeText"
                                               Margin="0,5,0,0"
                                               Text="选择左侧真实会话以查看消息。"
                                               AutomationProperties.LiveSetting="Polite"
                                               Foreground="#FF718396"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <Button x:Name="OpenSearchButton"
                                        Grid.Column="1"
                                        Margin="16,0,0,0"
                                        MinHeight="32"
                                        Padding="14,5"
                                        VerticalAlignment="Top"
                                        AutomationProperties.Name="打开消息搜索"
                                        Content="搜索"
                                        Click="OnOpenSearchClicked" />
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,14,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="LoadOlderButton"
                                        Content="加载更早消息"
                                        MinHeight="30"
                                        Padding="12,5"
                                        Visibility="Collapsed"
                                        Click="OnLoadOlderMessagesClicked" />
                                <TextBlock x:Name="MessageStatusText"
                                           Grid.Column="1"
                                           Margin="12,0,0,0"
                                           Text="请选择会话"
                                           AutomationProperties.LiveSetting="Polite"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"
                                           Foreground="#FF8796A5"
                                           FontSize="12"
                                           TextWrapping="Wrap" />
                            </Grid>

                            <Grid Grid.Row="2">
                                <ListBox x:Name="MessageList"
                                         AutomationProperties.Name="消息列表"
                                         Background="#FFF7F9FC"
                                         BorderBrush="#FFE6ECF3"
                                         BorderThickness="1"
                                         ScrollViewer.CanContentScroll="True"
                                         ScrollViewer.ScrollChanged="OnMessageScrollChanged"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="8,4" />
                                            <Setter Property="Focusable" Value="False" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <Border Margin="0,5,0,7"
                                                        Padding="9,3"
                                                        HorizontalAlignment="Center"
                                                        Background="#FFE9EEF4"
                                                        CornerRadius="9">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ShowDateSeparator}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding DateSeparatorLabel}"
                                                               Foreground="#FF718396"
                                                               FontSize="11" />
                                                </Border>
                                                <Grid Margin="0,6,0,8"
                                                      AutomationProperties.Name="新消息分割线">
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ShowNewMessageSeparator}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Height="1"
                                                            VerticalAlignment="Center"
                                                            Background="#FFCE6871" />
                                                    <TextBlock Grid.Column="1"
                                                               Margin="10,0"
                                                               Text="新消息"
                                                               Foreground="#FFB84F5A"
                                                               FontSize="11"
                                                               FontWeight="SemiBold" />
                                                    <Border Grid.Column="2"
                                                            Height="1"
                                                            VerticalAlignment="Center"
                                                            Background="#FFCE6871" />
                                                </Grid>
                                            <Border Padding="12,9"
                                                    Tag="MessageCard"
                                                    Background="White"
                                                    BorderBrush="#FFE5EBF2"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Loaded="OnMessageCardLoaded"
                                                    Unloaded="OnMessageCardUnloaded"
                                                    DataContextChanged="OnMessageCardDataContextChanged">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding SenderLabel}"
                                                                   Foreground="#FF1677D2"
                                                                   FontWeight="SemiBold" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Timestamp}"
                                                                   Foreground="#FF94A1AE"
                                                                   FontSize="11" />
                                                    </Grid>
                                                    <TextBlock Text="{Binding Content}"
                                                               Margin="0,6,0,0"
                                                               Foreground="#FF25394D"
                                                               TextWrapping="Wrap" />
                                                    <ItemsControl ItemsSource="{Binding Attachments}"
                                                                  Margin="0,8,0,0">
                                                        <ItemsControl.Style>
                                                            <Style TargetType="ItemsControl">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasAttachments}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ItemsControl.Style>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Margin="0,0,0,6"
                                                                        Padding="9,7"
                                                                        AutomationProperties.Name="{Binding DisplayName}"
                                                                        AutomationProperties.HelpText="{Binding DownloadState.StatusText}"
                                                                        Background="#FFF5F8FB"
                                                                        BorderBrush="#FFD7E2ED"
                                                                        BorderThickness="1"
                                                                        CornerRadius="5">
                                                                    <Grid>
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                        </Grid.RowDefinitions>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <StackPanel>
                                                                            <TextBlock Text="{Binding DisplayName}"
                                                                                       MaxWidth="420"
                                                                                       Foreground="#FF25394D"
                                                                                       FontWeight="SemiBold"
                                                                                       TextTrimming="CharacterEllipsis" />
                                                                            <TextBlock Text="{Binding DisplaySize}"
                                                                                       Margin="0,2,0,0"
                                                                                       Foreground="#FF718396"
                                                                                       FontSize="11" />
                                                                        </StackPanel>
                                                                        <StackPanel Grid.Column="1"
                                                                                    Margin="12,0,0,0"
                                                                                    Orientation="Horizontal">
                                                                            <Button MinWidth="52"
                                                                                    Margin="0,0,6,0"
                                                                                    Padding="9,3"
                                                                                    Content="打开"
                                                                                    IsEnabled="{Binding DownloadState.CanOpen}"
                                                                                    AutomationProperties.Name="{Binding DownloadState.DisplayName, StringFormat=打开附件：{0}}"
                                                                                    Click="OnAttachmentOpenClicked">
                                                                                <Button.Style>
                                                                                    <Style TargetType="Button">
                                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding DownloadState.CanOpen}" Value="True">
                                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Button.Style>
                                                                            </Button>
                                                                            <Button MinWidth="72"
                                                                                    Padding="9,3"
                                                                                    Content="{Binding DownloadState.ActionLabel}"
                                                                                    IsEnabled="{Binding DownloadState.CanInvoke}"
                                                                                    AutomationProperties.Name="{Binding DownloadState.AutomationName}"
                                                                                    Click="OnAttachmentDownloadActionClicked" />
                                                                        </StackPanel>
                                                                        <TextBlock Grid.Row="1"
                                                                                   Grid.ColumnSpan="2"
                                                                                   Margin="0,5,0,0"
                                                                                   Text="{Binding DownloadState.StatusText}"
                                                                                   AutomationProperties.LiveSetting="Polite"
                                                                                   Foreground="#FF52708C"
                                                                                   FontSize="11" />
                                                                        <ProgressBar Grid.Row="2"
                                                                                     Grid.ColumnSpan="2"
                                                                                     Height="4"
                                                                                     Margin="0,5,0,0"
                                                                                     Minimum="0"
                                                                                     Maximum="100"
                                                                                     Value="{Binding DownloadState.Percent, Mode=OneWay}"
                                                                                     AutomationProperties.Name="附件下载进度">
                                                                            <ProgressBar.Style>
                                                                                <Style TargetType="ProgressBar">
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding DownloadState.ShowProgress}" Value="True">
                                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </ProgressBar.Style>
                                                                        </ProgressBar>
                                                                        <Grid Grid.Row="3"
                                                                              Grid.ColumnSpan="2"
                                                                              Margin="0,8,0,0"
                                                                              HorizontalAlignment="Left">
                                                                            <Grid.Style>
                                                                                <Style TargetType="Grid">
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding ImageState.ShowPreview}" Value="True">
                                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Grid.Style>
                                                                            <Grid.RowDefinitions>
                                                                                <RowDefinition Height="Auto" />
                                                                                <RowDefinition Height="Auto" />
                                                                            </Grid.RowDefinitions>
                                                                            <Border Grid.Row="0"
                                                                                    MaxWidth="320"
                                                                                    MaxHeight="180"
                                                                                    Background="#FFE8F1F8"
                                                                                    BorderBrush="#FFD7E2ED"
                                                                                    BorderThickness="1"
                                                                                    CornerRadius="4">
                                                                                <Grid>
                                                                                    <Image Source="{Binding ImageState.Thumbnail}"
                                                                                           MaxWidth="320"
                                                                                           MaxHeight="180"
                                                                                           Stretch="Uniform"
                                                                                           Loaded="OnAttachmentThumbnailLoaded"
                                                                                           Unloaded="OnAttachmentThumbnailUnloaded"
                                                                                           DataContextChanged="OnAttachmentThumbnailDataContextChanged"
                                                                                           AutomationProperties.Name="{Binding ImageState.AutomationName}" />
                                                                                    <TextBlock Margin="10"
                                                                                               HorizontalAlignment="Center"
                                                                                               VerticalAlignment="Center"
                                                                                               Text="{Binding ImageState.StatusText}"
                                                                                               TextWrapping="Wrap"
                                                                                               TextAlignment="Center"
                                                                                               Foreground="#FF52708C"
                                                                                               FontSize="11"
                                                                                               AutomationProperties.LiveSetting="Polite"
                                                                                               IsHitTestVisible="False">
                                                                                        <TextBlock.Style>
                                                                                            <Style TargetType="TextBlock">
                                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                                                <Style.Triggers>
                                                                                                    <DataTrigger Binding="{Binding ImageState.Thumbnail}" Value="{x:Null}">
                                                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                                                    </DataTrigger>
                                                                                                </Style.Triggers>
                                                                                            </Style>
                                                                                        </TextBlock.Style>
                                                                                    </TextBlock>
                                                                                </Grid>
                                                                            </Border>
                                                                            <Button Grid.Row="1"
                                                                                    Margin="0,6,0,0"
                                                                                    Padding="9,3"
                                                                                    HorizontalAlignment="Left"
                                                                                    VerticalAlignment="Bottom"
                                                                                    Content="查看图片"
                                                                                    IsEnabled="{Binding ImageState.CanView}"
                                                                                    AutomationProperties.Name="{Binding ImageState.AutomationName}"
                                                                                    Click="OnAttachmentImageViewClicked" />
                                                                        </Grid>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <ItemsControl ItemsSource="{Binding Links}"
                                                                  Margin="0,6,0,0">
                                                        <ItemsControl.Style>
                                                            <Style TargetType="ItemsControl">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasLinks}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ItemsControl.Style>
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button MinHeight="0"
                                                                        MaxWidth="420"
                                                                        Margin="0,0,8,3"
                                                                        Padding="0"
                                                                        HorizontalContentAlignment="Left"
                                                                        AutomationProperties.Name="{Binding DisplayText}"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        Foreground="#FF1677D2"
                                                                        Click="OnMessageLinkClicked">
                                                                    <TextBlock Text="{Binding DisplayText}"
                                                                               MaxHeight="34"
                                                                               TextDecorations="Underline"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               TextWrapping="Wrap" />
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <Button Margin="0,7,0,0"
                                                            MinHeight="0"
                                                            Padding="0"
                                                            HorizontalContentAlignment="Stretch"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Tag="{Binding ReplyToMessageId}"
                                                            ToolTip="定位被回复的消息"
                                                            Click="OnReplyReferenceClicked">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasReply}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <Border Padding="9,6"
                                                                Background="#FFF0F5FA"
                                                                BorderBrush="#FFD7E2ED"
                                                                BorderThickness="3,0,0,0"
                                                                CornerRadius="3">
