<Window x:Class="RelayCove.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:RelayCove.Client.Controls"
        xmlns:presentation="clr-namespace:RelayCove.Client.Presentation"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="RelayCove"
        Height="680"
        Width="1280"
        MinHeight="520"
        MinWidth="900"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource RcCanvasBrush}"
        FontFamily="Segoe UI"
        StateChanged="OnMainWindowStateChanged"
        SizeChanged="OnMainWindowSizeChanged"
        PreviewKeyDown="OnMainWindowPreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48"
                            ResizeBorderThickness="8"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#FF1677D2" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#FFEAF3FF" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FF1F2328" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF596B7C" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="CanvasBrush" Color="#FFF5F7FA" />
        <SolidColorBrush x:Key="BorderBrush" Color="#FFE5EAF0" />
        <SolidColorBrush x:Key="DangerBrush" Color="#FFD92D20" />
        <Style x:Key="WindowButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FFD8EAFE" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource WindowButtonStyle}">
            <Setter Property="MinHeight" Value="34" />
        </Style>
        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource WindowButtonStyle}">
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="SubtleButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource WindowButtonStyle}">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style x:Key="MessageActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource WindowButtonStyle}">
            <Setter Property="MinWidth" Value="42" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource RcTextSecondaryBrush}" />
        </Style>
        <Style x:Key="HeaderIconButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource WindowButtonStyle}">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource RcTextSecondaryBrush}" />
        </Style>
        <Style x:Key="ComposerIconButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource WindowButtonStyle}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource RcTextSecondaryBrush}" />
        </Style>
        <Style x:Key="ConversationFilterButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource WindowButtonStyle}">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource RcTextSecondaryBrush}" />
        </Style>
        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#FFFDA29B" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource RcCanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LoginBrandColumn" Width="270" />
            <ColumnDefinition x:Name="MainContentColumn" Width="*" />
        </Grid.ColumnDefinitions>

        <controls:TitleBarControl x:Name="ApplicationTitleBar"
                                  Grid.ColumnSpan="2"
                                  Title="RelayCove"
                                  DragRequested="OnTitleBarDragRequested"
                                  MinimizeRequested="OnTitleBarMinimizeRequested"
                                  MaximizeRestoreRequested="OnTitleBarMaximizeRestoreRequested"
                                  CloseRequested="OnTitleBarCloseRequested"
                                  SystemMenuRequested="OnTitleBarSystemMenuRequested" />

        <Border x:Name="LoginBrandPanel" Grid.Row="1" Grid.Column="0" Background="#FF0958D9">
            <Grid Margin="28,32,28,26">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="RelayCove"
                               Foreground="White"
                               FontWeight="SemiBold"
                               FontSize="27" />
                    <TextBlock Text="团队消息，安全抵达"
                               Margin="0,5,0,0"
                               Foreground="#FFEAF3FF"
                               FontSize="13" />
                </StackPanel>

                <Border Grid.Row="1"
                        Margin="0,32,0,0"
                        Padding="13,11"
                        Background="#FF0958D9"
                        CornerRadius="8">
                    <StackPanel>
                        <TextBlock x:Name="SidebarConnectionText"
                                   Text="实时连接：未连接"
                                   AutomationProperties.LiveSetting="Polite"
                                   Foreground="#FFE7F0F8"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="SidebarSyncText"
                                   Text="同步：尚未完成"
                                   AutomationProperties.LiveSetting="Polite"
                                   Margin="0,5,0,0"
                                   Foreground="#FFEAF3FF"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="SidebarNotificationText"
                                   Text="系统通知：初始化中"
                                   AutomationProperties.LiveSetting="Polite"
                                   Margin="0,5,0,0"
                                   Foreground="#FFEAF3FF"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="2" Margin="0,34,0,0">
                    <TextBlock Text="当前账户"
                               Foreground="#FFCAE5FF"
                               FontWeight="SemiBold"
                               FontSize="12" />
                    <TextBlock x:Name="SidebarDisplayNameText"
                               Margin="0,8,0,0"
                               Text="尚未登录"
                               AutomationProperties.LiveSetting="Polite"
                               Foreground="White"
                               FontSize="16"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="SidebarServerText"
                               Margin="0,5,0,0"
                               Text="—"
                               AutomationProperties.LiveSetting="Polite"
                               Foreground="#FFEAF3FF"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis" />
                    <Button x:Name="CheckForUpdatesButton"
                            Margin="0,14,0,0"
                            Padding="10,5"
                            HorizontalAlignment="Left"
                            Content="检查更新"
                            AutomationProperties.Name="检查更新"
                            Click="OnCheckForUpdatesClicked" />
                    <TextBlock x:Name="UpdateStatusText"
                               Margin="0,8,0,0"
                               AutomationProperties.LiveSetting="Polite"
                               Foreground="#FFEAF3FF"
                               Text="更新：尚未检查"
                               TextWrapping="Wrap" />
                    <Button x:Name="OptionalUpdateActionButton"
                            Margin="0,8,0,0"
                            Padding="10,5"
                            HorizontalAlignment="Left"
                            Visibility="Collapsed"
                            Click="OnOptionalUpdateActionClicked" />
                </StackPanel>

                <TextBlock x:Name="SidebarUnreadText"
                           Grid.Row="3"
                           Text="未读计数：0"
                           AutomationProperties.LiveSetting="Polite"
                           Foreground="#FFCAE5FF"
                           FontSize="12" />
            </Grid>
        </Border>

        <Grid x:Name="MainContentPanel" Grid.Row="1" Grid.Column="1" Margin="42,34">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock x:Name="HeadingText"
                           Text="正在启动 RelayCove"
                           AutomationProperties.LiveSetting="Polite"
                           Foreground="#FF17263A"
                           FontSize="28"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="DetailText"
                           Margin="0,8,0,0"
                           MaxWidth="680"
                           AutomationProperties.LiveSetting="Polite"
                           HorizontalAlignment="Left"
                           Text="正在准备本地账户环境。"
                           Foreground="#FF5C6F82"
                           FontSize="14"
                           TextWrapping="Wrap" />
            </StackPanel>

            <Grid x:Name="MainWorkspace" Grid.Row="1" Margin="0,30,0,24">
                <Border x:Name="LoginPanel"
                        MaxWidth="500"
                        Padding="34"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        Background="White"
                        BorderBrush="#FFDCE5EF"
                        BorderThickness="1"
                        CornerRadius="12">
                    <StackPanel>
                        <TextBlock Text="服务器地址"
                                   Foreground="#FF31465B"
                                   FontWeight="SemiBold" />
                        <TextBox x:Name="ServerAddressTextBox"
                                 Margin="0,7,0,18"
                                 AutomationProperties.Name="服务器地址"
                                 ToolTip="例如 https://relay.example.com/" />
                        <TextBlock Text="用户名"
                                   Foreground="#FF31465B"
                                   FontWeight="SemiBold" />
                        <TextBox x:Name="UserNameTextBox"
                                 Margin="0,7,0,18"
                                 AutomationProperties.Name="用户名" />
                        <TextBlock Text="密码"
                                   Foreground="#FF31465B"
                                   FontWeight="SemiBold" />
                        <PasswordBox x:Name="PasswordInput"
                                     Margin="0,7,0,24"
                                     AutomationProperties.Name="密码" />
                        <Button x:Name="LoginButton"
                                Content="登录"
                                IsDefault="True"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="OnLoginClicked" />
                    </StackPanel>
                </Border>

                <Grid x:Name="AccountPanel" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="NavigationRailColumn" Width="72" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition x:Name="ConversationPanelColumn" Width="340" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <controls:NavigationRailControl x:Name="ApplicationNavigation"
                                                    Grid.Column="0"
                                                    NavigationRequested="OnNavigationRequested"
                                                    UnavailableFeatureRequested="OnUnavailableFeatureRequested" />

                    <Border x:Name="ConversationPanelContainer"
                            Grid.Column="2"
                            Padding="8,10,10,8"
                            Background="Transparent"
                            BorderThickness="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Margin="8,8,8,7">
                                <Border Background="{DynamicResource RcSurfaceBrush}"
                                        BorderBrush="{DynamicResource RcBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <Grid>
                                        <Path Width="17"
                                              Height="17"
                                              Margin="12,0,0,0"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              Data="{DynamicResource RcIconSearch}"
                                              Stretch="Uniform"
                                              Stroke="{DynamicResource RcTextSecondaryBrush}"
                                              StrokeThickness="1.6"
                                              IsHitTestVisible="False" />
                                        <TextBox x:Name="ConversationSearchTextBox"
                                                 MinHeight="42"
                                                 Padding="38,7,66,7"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 AutomationProperties.Name="搜索会话"
                                                 ToolTip="按会话名称或消息预览筛选。Ctrl+K 聚焦。"
                                                 TextChanged="OnConversationSearchTextChanged" />
                                        <TextBlock Margin="39,0,0,0"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource RcTextSecondaryBrush}"
                                                   FontSize="13"
                                                   IsHitTestVisible="False"
                                                   Text="搜索会话">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=ConversationSearchTextBox}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Border Margin="0,0,9,0"
                                                Padding="6,2"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Background="#FFF5F7FA"
                                                CornerRadius="5"
                                                IsHitTestVisible="False">
                                            <TextBlock Text="Ctrl K"
                                                       Foreground="{DynamicResource RcTextSecondaryBrush}"
                                                       FontSize="10" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                            <StackPanel Grid.Row="1" Margin="8,0,8,6">
                                <UniformGrid Margin="0,5,0,0" Columns="4">
                                    <Button x:Name="AllConversationFilterButton"
                                            Margin="0,0,4,0"
                                            Style="{StaticResource ConversationFilterButtonStyle}"
                                            Content="全部"
                                            Tag="All"
                                            Click="OnConversationFilterClicked" />
                                    <Button x:Name="UnreadConversationFilterButton"
                                            Margin="0,0,4,0"
                                            Style="{StaticResource ConversationFilterButtonStyle}"
                                            Content="未读"
                                            Tag="Unread"
                                            Click="OnConversationFilterClicked" />
                                    <Button x:Name="ChannelConversationFilterButton"
                                            Margin="0,0,4,0"
                                            Style="{StaticResource ConversationFilterButtonStyle}"
                                            Content="频道"
                                            Tag="Channels"
                                            Click="OnConversationFilterClicked" />
                                    <Button x:Name="DirectConversationFilterButton"
                                            Style="{StaticResource ConversationFilterButtonStyle}"
                                            Content="私聊"
                                            Tag="Direct"
                                            Click="OnConversationFilterClicked" />
                                </UniformGrid>
                            </StackPanel>
                            <ListBox x:Name="ConversationList"
                                     Grid.Row="2"
                                     AutomationProperties.Name="会话列表"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.CanContentScroll="True"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     SelectionChanged="OnConversationSelectionChanged">
                                <ListBox.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.ContainerStyle>
                                            <Style TargetType="{x:Type GroupItem}">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="{x:Type GroupItem}">
                                                            <Expander x:Name="ConversationGroupExpander"
                                                                      Tag="{Binding Name}"
                                                                      IsExpanded="True"
                                                                      BorderThickness="0"
                                                                      Loaded="OnConversationGroupExpanderLoaded"
                                                                      Expanded="OnConversationGroupExpanded"
                                                                      Collapsed="OnConversationGroupCollapsed">
                                                                <Expander.Header>
                                                                    <ContentPresenter Content="{Binding}"
                                                                                      ContentTemplate="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=HeaderTemplate}" />
                                                                </Expander.Header>
                                                                <ItemsPresenter />
                                                            </Expander>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </GroupStyle.ContainerStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <Grid Margin="6,12,4,5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold" />
                                                    <Button Grid.Column="1"
                                                            Width="24"
                                                            Height="24"
                                                            MinHeight="0"
                                                            Padding="0"
                                                            Content="+"
                                                            FontSize="16"
                                                            ToolTip="创建频道"
                                                            AutomationProperties.Name="创建频道"
                                                            Click="OnOpenChannelPanelClicked">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Name}" Value="私聊">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ListBox.GroupStyle>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,2" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#FFF5F6F8" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="9,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                                <Border Width="26"
                                                    Height="26"
                                                    VerticalAlignment="Top"
                                                    Background="{StaticResource AccentSoftBrush}"
                                                    CornerRadius="13">
                                                <TextBlock Text="{Binding TypeIcon}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           FontWeight="SemiBold" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="#FF25394D"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Preview}"
                                                           Margin="0,2,0,0"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           FontSize="11"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding MutedLabel}"
                                                           Margin="0,2,0,0"
                                                           Foreground="#FF596B7C"
                                                           FontSize="11" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding Timestamp}"
                                                           Foreground="#FF596B7C"
                                                           FontSize="10" />
                                                <Border Margin="0,4,0,0"
                                                        Padding="6,2"
                                                        HorizontalAlignment="Right"
                                                        Background="{StaticResource AccentBrush}"
                                                        CornerRadius="8">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasUnread}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding UnreadText}"
                                                               Foreground="White"
                                                               FontSize="10"
                                                               FontWeight="SemiBold" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="ConversationEmptyText"
                                       Grid.Row="2"
                                       Margin="18"
                                       Text="正在读取账户会话…"
                                       AutomationProperties.LiveSetting="Polite"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="#FF596B7C"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                            <Border Grid.Row="3"
                                    Margin="4,10,4,0"
                                    Padding="8,9,8,6"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,1,0,0">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="28" Height="28" Background="{StaticResource AccentSoftBrush}" CornerRadius="14">
                                            <TextBlock Text="●"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       FontSize="10" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="7,0,4,0">
                                            <TextBlock Text="{Binding Text, ElementName=SidebarDisplayNameText}"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Text, ElementName=SidebarConnectionText}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="10"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                         <Button Grid.Column="2"
                                                 MinWidth="48"
                                                 MinHeight="30"
                                                 Padding="8,4"
                                                 Background="Transparent"
                                                 BorderBrush="Transparent"
                                                 Content="设置"
                                                 ToolTip="打开账户与设置"
                                                 AutomationProperties.Name="打开账户与设置"
                                                 Click="OnToggleAccountDiagnosticsClicked" />
                                     </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
