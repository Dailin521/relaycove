                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           FontWeight="SemiBold" />
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding UserName, StringFormat=@{0}}"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               FontSize="11" />
                                                    <TextBlock Text="{Binding RoleLabel, StringFormat= · {0}}"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               FontSize="11" />
                                                </StackPanel>
                                            </StackPanel>
                                            <Button Grid.Column="2"
                                                    MinWidth="52"
                                                    Padding="8,2"
                                                    Content="拉入"
                                                    IsEnabled="{Binding CanInvite}"
                                                    Click="OnInviteChannelMemberClicked" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Margin="0,18,0,0">
                            <TextBlock x:Name="ChannelCurrentHeadingText"
                                       Text="当前会话成员"
                                       FontSize="18"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="ChannelMemberHelpText"
                                       Margin="0,4,0,8"
                                       Text="选择会话后显示成员。"
                                       Foreground="#FF596B7C"
                                       TextWrapping="Wrap" />
                            <ListBox x:Name="ChannelParticipantList"
                                     MaxHeight="230"
                                     Margin="0,6,0,0"
                                     BorderThickness="0"
                                     AutomationProperties.Name="当前会话成员列表">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="6,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="38" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="30" Height="30" Background="{StaticResource AccentSoftBrush}" CornerRadius="15">
                                                <TextBlock Text="{Binding AvatarText}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           FontWeight="SemiBold" />
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding UserName, StringFormat=@{0}}"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               FontSize="11" />
                                                    <TextBlock Text="{Binding RoleLabel, StringFormat= · {0}}"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               FontSize="11" />
                                                </StackPanel>
                                            </StackPanel>
                                            <Button Grid.Column="2"
                                                    Style="{StaticResource DangerButtonStyle}"
                                                    MinWidth="52"
                                                    Padding="8,2"
                                                    Content="移除"
                                                    IsEnabled="{Binding CanRemove}"
                                                    Click="OnRemoveChannelMemberClicked" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="ChannelLiveRegionText"
                               Grid.Row="2"
                               Grid.ColumnSpan="2"
                               Margin="0,14,0,0"
                               Text="准备就绪。"
                               Foreground="#FF1677D2"
                               TextWrapping="Wrap"
                               AutomationProperties.Name="频道操作状态"
                               AutomationProperties.LiveSetting="Assertive" />
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>
        <controls:SettingsPanelControl x:Name="SettingsOverlay"
                                       Grid.Row="1"
                                       Grid.ColumnSpan="2"
                                       Panel.ZIndex="130"
                                       Width="396"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Stretch"
                                       Visibility="Collapsed"
                                       CloseRequested="OnSettingsCloseRequested"
                                       CheckForUpdatesRequested="OnSettingsCheckForUpdatesRequested"
                                       ReconnectRequested="OnSettingsReconnectRequested"
                                       ExitAccountRequested="OnSettingsExitAccountRequested" />
        <Grid x:Name="AttachmentImageViewerOverlay"
              Grid.Row="1"
              Grid.ColumnSpan="2"
              Panel.ZIndex="100"
              Visibility="Collapsed"
              Background="{DynamicResource RcOverlayBrush}"
              Focusable="True"
              KeyboardNavigation.TabNavigation="Cycle"
              AutomationProperties.Name="图片查看器"
              AutomationProperties.LiveSetting="Polite">
            <Border MaxWidth="980"
                    MaxHeight="720"
                    Margin="36"
                    Padding="18"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#FF1F2937"
                    BorderBrush="#FF475467"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="AttachmentImageViewerTitleText"
                               Foreground="White"
                               FontSize="16"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               AutomationProperties.Name="图片查看器标题" />
                    <Button x:Name="CloseAttachmentImageViewerButton"
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            Padding="10,4"
                            Content="关闭"
                            AutomationProperties.Name="关闭图片查看器"
                            Click="OnCloseAttachmentImageViewerClicked" />
                    <Image x:Name="AttachmentImageViewerImage"
                           Grid.Row="1"
                           Grid.ColumnSpan="2"
                           MaxWidth="920"
                           MaxHeight="620"
                           Margin="0,14,0,12"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Stretch="Uniform"
                           AutomationProperties.Name="当前图片预览" />
                    <TextBlock x:Name="AttachmentImageViewerStatusText"
                               Grid.Row="2"
                               Grid.ColumnSpan="2"
                               Foreground="#FFD7E2ED"
                               FontSize="11"
                               Text="受限预览：图片已按安全显示上限处理。"
                               TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite" />
                </Grid>
            </Border>
        </Grid>
        <Grid x:Name="MandatoryUpdateOverlay"
              Grid.Row="1"
              Grid.ColumnSpan="2"
              Panel.ZIndex="200"
              Visibility="Collapsed"
              Background="{DynamicResource RcOverlayBrush}"
              Focusable="True"
              KeyboardNavigation.TabNavigation="Cycle"
              AutomationProperties.Name="需要更新"
              AutomationProperties.LiveSetting="Assertive">
            <Border MaxWidth="620"
                    Margin="36"
                    Padding="32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Stretch"
                    Background="{DynamicResource RcSurfaceBrush}"
                    BorderBrush="{DynamicResource RcPrimaryBrush}"
                    BorderThickness="2"
                    CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="需要更新 RelayCove"
                               Foreground="{DynamicResource RcTextPrimaryBrush}"
                               FontSize="24"
                               FontWeight="SemiBold" />
                    <ScrollViewer x:Name="MandatoryUpdateNotesScrollViewer"
                                  Grid.Row="1"
                                  Margin="0,12,0,0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="True">
                        <TextBlock x:Name="MandatoryUpdateDetailText"
                                   Foreground="{DynamicResource RcTextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite" />
                    </ScrollViewer>
                    <StackPanel Grid.Row="2" Margin="0,12,0,0">
                        <TextBlock x:Name="MandatoryUpdateProgressText"
                                   Foreground="{DynamicResource RcPrimaryBrush}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite" />
                        <ProgressBar x:Name="MandatoryUpdateProgressBar"
                                     Margin="0,8,0,0"
                                     Height="8"
                                     Minimum="0"
                                     Maximum="100"
                                     Visibility="Collapsed" />
                        <TextBlock x:Name="MandatoryUpdateErrorText"
                                   Margin="0,12,0,0"
                                   Foreground="{DynamicResource RcDangerBrush}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Assertive" />
                    </StackPanel>
                    <WrapPanel Grid.Row="3" Margin="0,22,0,0">
                        <Button x:Name="RetryMandatoryUpdateButton"
                                Margin="0,0,10,0"
                                Content="重新检查"
                                Click="OnRetryMandatoryUpdateClicked" />
                        <Button x:Name="DownloadMandatoryUpdateButton"
                                Margin="0,0,10,0"
                                Content="下载更新"
                                Background="#FF1677D2"
                                Foreground="White"
                                Click="OnDownloadUpdateClicked" />
                        <Button x:Name="CancelMandatoryUpdateButton"
                                Margin="0,0,10,0"
                                Content="取消下载"
                                Visibility="Collapsed"
                                Click="OnCancelUpdateDownloadClicked" />
                        <Button x:Name="ApplyMandatoryUpdateButton"
                                Margin="0,0,10,0"
                                Content="关闭并更新"
                                Background="#FF1677D2"
                                Foreground="White"
                                Visibility="Collapsed"
                                Click="OnApplyUpdateClicked" />
                        <Button x:Name="ExitMandatoryUpdateButton"
                                Content="退出 RelayCove"
                                Click="OnExitForMandatoryUpdateClicked" />
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
