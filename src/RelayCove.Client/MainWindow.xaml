                           MaxWidth="920"
                           MaxHeight="620"
                           Margin="0,14,0,12"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Stretch="Uniform"
                           AutomationProperties.Name="当前图片预览" />
                    <TextBlock x:Name="AttachmentImageViewerStatusText"
                               Grid.Row="2"
                               Grid.ColumnSpan="2"
                               Foreground="#FFD7E2ED"
