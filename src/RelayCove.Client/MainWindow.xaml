                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,7,5"
                                                            Padding="7,4"
                                                            Background="#FFE8F1F8"
                                                            CornerRadius="3">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding DisplayName}"
                                                                       MaxWidth="230"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock Margin="5,0,0,0"
                                                                       Text="{Binding DisplaySize}"
                                                                       Foreground="#FF718396"
                                                                       FontSize="10"
                                                                       VerticalAlignment="Center" />
                                                            <Button Margin="5,0,0,0"
                                                                    MinWidth="24"
                                                                    MinHeight="22"
                                                                    Padding="3,0"
                                                                    Content="移除"
                                                                    AutomationProperties.Name="移除附件"
                                                                    Click="OnRemoveAttachmentClicked" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="AttachmentInputDropTarget"
                                        Grid.Row="3"
                                        Grid.ColumnSpan="4"
                                        Padding="3"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        AllowDrop="True"
                                        AutomationProperties.Name="消息内容和附件输入区"
                                        AutomationProperties.HelpText="正文为空且未选择 @用户时，可拖入最多十个本地文件，或按 Ctrl+V 粘贴截图。"
                                        PreviewDragEnter="OnAttachmentInputPreviewDragEnter"
                                        PreviewDragOver="OnAttachmentInputPreviewDragOver"
                                        PreviewDragLeave="OnAttachmentInputPreviewDragLeave"
                                        PreviewDrop="OnAttachmentInputPreviewDrop"
                                        PreviewKeyDown="OnAttachmentInputPreviewKeyDown">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="MessageComposerTextBox"
                                                 MinHeight="68"
                                                 MaxHeight="150"
                                                 Padding="10,8"
                                                 AcceptsReturn="True"
                                                 IsEnabled="False"
                                                 TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto"
                                                 AutomationProperties.Name="消息内容"
                                                 TextChanged="OnMessageComposerTextChanged"
                                                 PreviewKeyDown="OnMessageComposerPreviewKeyDown" />
                                        <Button x:Name="SelectAttachmentsButton"
                                                Grid.Column="1"
                                                MinWidth="68"
                                                Margin="10,0,0,0"
                                                Padding="10,8"
                                                Content="附件"
                                                ToolTip="正文为空且未选择 @用户时，可以选择、拖入或粘贴最多 10 个附件。"
                                                AutomationProperties.Name="选择附件"
                                                IsEnabled="False"
                                                VerticalAlignment="Stretch"
                                                Click="OnSelectAttachmentsClicked" />
                                        <Button x:Name="MentionPickerButton"
                                                Grid.Column="2"
                                                MinWidth="76"
                                                Margin="10,0,0,0"
                                                Padding="10,8"
                                                Content="@用户"
                                                IsEnabled="False"
                                                VerticalAlignment="Stretch"
                                                Click="OnMentionPickerClicked" />
                                        <Button x:Name="SendMessageButton"
                                                Grid.Column="3"
                                                MinWidth="76"
                                                Margin="10,0,0,0"
                                                Padding="14,8"
                                                Content="发送"
                                                IsEnabled="False"
                                                VerticalAlignment="Stretch"
                                                Click="OnSendMessageClicked" />
                                    </Grid>
                                </Border>
                                <Grid x:Name="AttachmentUploadProgressPanel"
                                      Grid.Row="4"
                                      Grid.ColumnSpan="4"
                                      Margin="2,7,0,0"
                                      Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ProgressBar x:Name="AttachmentUploadProgressBar"
                                                 Height="8"
                                                 Minimum="0"
                                                 Maximum="100"
                                                 Value="0"
                                                 VerticalAlignment="Center"
                                                 AutomationProperties.Name="附件上传进度" />
                                    <TextBlock x:Name="AttachmentUploadProgressText"
                                               Grid.Column="1"
                                               Margin="10,0,0,0"
                                               Text="准备附件上传…"
                                               AutomationProperties.LiveSetting="Polite"
                                               Foreground="#FF52708C"
                                               FontSize="11"
                                               TextWrapping="Wrap" />
                                </Grid>
                                <TextBlock x:Name="MessageComposerStatusText"
                                           Grid.Row="5"
                                           Grid.ColumnSpan="4"
                                           Margin="2,5,0,0"
                                           Text="选择可用会话后发送文字；正文为空时可选择附件。Ctrl+Enter 换行。"
                                           AutomationProperties.LiveSetting="Polite"
                                           Foreground="#FF718396"
                                           FontSize="11"
                                           TextWrapping="Wrap" />
                            </Grid>

                            <StackPanel Grid.Row="4"
                                        Margin="0,14,0,0"
                                        HorizontalAlignment="Center"
                                        Orientation="Horizontal">
                                <Button x:Name="RetryButton"
                                        Content="重试连接"
                                        Margin="0,0,10,0"
                                        Click="OnRetryClicked" />
                                <Button x:Name="LogoutButton"
                                        Content="退出账户"
                                        Click="OnLogoutClicked" />
                            </StackPanel>

                            <Border x:Name="SearchPanel"
                                    Grid.RowSpan="5"
                                    Panel.ZIndex="20"
                                    Padding="22"
                                    Visibility="Collapsed"
                                    Background="White"
                                    BorderBrush="#FFDCE5EF"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="搜索聊天记录"
                                                       Foreground="#FF25394D"
                                                       FontSize="20"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Margin="0,4,0,0"
                                                       Text="显式搜索消息正文与附件原名"
                                                       Foreground="#FF718396" />
                                        </StackPanel>
                                        <Button x:Name="CloseSearchButton"
                                                Grid.Column="1"
                                                MinHeight="30"
                                                Padding="12,4"
                                                AutomationProperties.Name="关闭消息搜索"
