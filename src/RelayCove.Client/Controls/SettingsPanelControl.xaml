<UserControl x:Class="RelayCove.Client.Controls.SettingsPanelControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RelayCove.Client.Controls"
             Focusable="True"
             KeyboardNavigation.TabNavigation="Cycle"
             AutomationProperties.Name="账户与设置侧栏">
    <UserControl.Resources>
        <Style x:Key="SettingsButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Background" Value="{DynamicResource RcSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource RcTextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource RcBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource RcFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource RcPrimarySoftBrush}" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource RcPrimaryBrush}" />
                            </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource RcPrimaryPressedSoftBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource SettingsButtonStyle}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style x:Key="DangerButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource SettingsButtonStyle}">
            <Setter Property="Foreground" Value="{DynamicResource RcDangerBrush}" />
            <Setter Property="BorderBrush" Value="#FFFDA29B" />
        </Style>
        <Style x:Key="UpdateActionButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource SettingsButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource RcPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource RcPrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="UpdateActionBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="UpdateActionBorder" Property="Background" Value="#FF0958D9" />
                                <Setter TargetName="UpdateActionBorder" Property="BorderBrush" Value="#FF0958D9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="UpdateActionBorder" Property="Background" Value="#FF003EB3" />
                                <Setter TargetName="UpdateActionBorder" Property="BorderBrush" Value="#FF003EB3" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Border Width="380"
            Margin="0,12,16,12"
            Padding="20,18"
            HorizontalAlignment="Right"
            Background="{DynamicResource RcSurfaceBrush}"
            BorderBrush="{DynamicResource RcBorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Effect="{DynamicResource RcPanelShadow}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="账户与设置"
                               FontSize="19"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource RcTextPrimaryBrush}" />
                    <TextBlock Margin="0,4,0,0"
                               Text="管理账户连接、通知状态和客户端更新。"
                               Foreground="{DynamicResource RcTextSecondaryBrush}"
                               FontSize="12"
                               TextWrapping="Wrap" />
                </StackPanel>
                <Button x:Name="CloseButtonElement"
                        Grid.Column="1"
                        Style="{StaticResource CloseButtonStyle}"
                        ToolTip="关闭"
                        AutomationProperties.Name="关闭账户与设置侧栏"
                        Click="OnCloseClicked">
                    <Path Data="{DynamicResource RcIconClose}"
                          Width="16"
                          Height="16"
                          Stretch="Uniform"
                          Stroke="{DynamicResource RcTextSecondaryBrush}"
                          StrokeThickness="1.6" />
                </Button>
                <Border Grid.Row="1"
                        Grid.ColumnSpan="2"
                        Margin="0,18,0,0"
                        Padding="14"
                        Background="{DynamicResource RcPrimarySoftBrush}"
                        BorderBrush="#FFD0E5FA"
                        BorderThickness="1"
                        CornerRadius="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="32"
                                Height="32"
                                VerticalAlignment="Top"
                                Background="{DynamicResource RcPrimaryBrush}"
                                CornerRadius="10">
                            <Path Width="17"
                                  Height="17"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="{DynamicResource RcIconChat}"
                                  Stretch="Uniform"
                                  Stroke="White"
                                  StrokeThickness="1.5" />
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="当前账户"
                                       Foreground="{DynamicResource RcTextSecondaryBrush}"
                                       FontSize="11" />
                            <TextBlock Margin="0,3,0,0"
                                       Text="{Binding DisplayName, RelativeSource={RelativeSource AncestorType={x:Type local:SettingsPanelControl}}}"
                                       Foreground="{DynamicResource RcTextPrimaryBrush}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Margin="0,3,0,0"
                                       Text="{Binding ServerAddress, RelativeSource={RelativeSource AncestorType={x:Type local:SettingsPanelControl}}}"
                                       Foreground="{DynamicResource RcTextSecondaryBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Row="2"
                        Grid.ColumnSpan="2"
                        Margin="0,14,0,0"
                        Padding="14"
                        Background="{DynamicResource RcCanvasBrush}"
                        BorderBrush="{DynamicResource RcBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="连接与通知"
                                   Foreground="{DynamicResource RcTextPrimaryBrush}"
                                   FontWeight="SemiBold" />
                        <TextBlock Margin="0,8,0,0"
                               Text="{Binding ConnectionStatus, RelativeSource={RelativeSource AncestorType={x:Type local:SettingsPanelControl}}}"
                               Foreground="{DynamicResource RcTextSecondaryBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,4,0,0"
                               Text="{Binding SyncStatus, RelativeSource={RelativeSource AncestorType={x:Type local:SettingsPanelControl}}}"
                               Foreground="{DynamicResource RcTextSecondaryBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,4,0,0"
                               Text="{Binding NotificationStatus, RelativeSource={RelativeSource AncestorType={x:Type local:SettingsPanelControl}}}"
                               Foreground="{DynamicResource RcTextSecondaryBrush}"
                               TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="3"
                        Grid.ColumnSpan="2"
                        Margin="0,14,0,0"
                        Padding="14"
                        Background="{DynamicResource RcCanvasBrush}"
                        BorderBrush="{DynamicResource RcBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="客户端"
                                   Foreground="{DynamicResource RcTextPrimaryBrush}"
                                   FontWeight="SemiBold" />
                        <TextBlock Margin="0,8,0,0"
                               Text="{Binding UpdateStatus, RelativeSource={RelativeSource AncestorType={x:Type local:SettingsPanelControl}}}"
                               Foreground="{DynamicResource RcTextSecondaryBrush}"
                               TextWrapping="Wrap" />
                    <Button x:Name="CheckForUpdatesButtonElement"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Left"
                            Style="{StaticResource SettingsButtonStyle}"
                            Content="检查更新"
                            IsEnabled="{Binding CanCheckForUpdates, RelativeSource={RelativeSource AncestorType={x:Type local:SettingsPanelControl}}}"
                            Click="OnCheckForUpdatesClicked" />
                    <Button x:Name="OptionalUpdateActionButtonElement"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Left"
                            Content="{Binding UpdateActionLabel, RelativeSource={RelativeSource AncestorType={x:Type local:SettingsPanelControl}}}"
                            IsEnabled="{Binding IsUpdateActionEnabled, RelativeSource={RelativeSource AncestorType={x:Type local:SettingsPanelControl}}}"
                            AutomationProperties.Name="执行可选更新操作"
                            Click="OnOptionalUpdateActionClicked">
                        <Button.Style>
                            <Style TargetType="{x:Type Button}" BasedOn="{StaticResource UpdateActionButtonStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasOptionalUpdateAction, RelativeSource={RelativeSource AncestorType={x:Type local:SettingsPanelControl}}}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Margin="0,18,0,0">
                    <Button x:Name="ReconnectButtonElement"
                            Style="{StaticResource SettingsButtonStyle}"
                            Content="重试连接"
                            IsEnabled="{Binding CanReconnect, RelativeSource={RelativeSource AncestorType={x:Type local:SettingsPanelControl}}}"
                            Click="OnReconnectClicked" />
                    <Button x:Name="ExitAccountButtonElement"
                            Margin="0,8,0,0"
                            Style="{StaticResource DangerButtonStyle}"
                            Content="退出账户"
                            IsEnabled="{Binding CanExitAccount, RelativeSource={RelativeSource AncestorType={x:Type local:SettingsPanelControl}}}"
                            Click="OnExitAccountClicked" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Border>
</UserControl>
