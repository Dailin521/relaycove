<UserControl x:Class="RelayCove.Client.Controls.SettingsPanelControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RelayCove.Client.Controls"
             Focusable="True"
             KeyboardNavigation.TabNavigation="Cycle"
             AutomationProperties.Name="账户与设置侧栏">
    <UserControl.Resources>
        <Style x:Key="SettingsButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Background" Value="{DynamicResource RcSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource RcTextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource RcBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource RcFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource RcPrimarySoftBrush}" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource RcPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FFD8EAFE" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource SettingsButtonStyle}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style x:Key="DangerButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource SettingsButtonStyle}">
            <Setter Property="Foreground" Value="{DynamicResource RcDangerBrush}" />
            <Setter Property="BorderBrush" Value="#FFFDA29B" />
        </Style>
    </UserControl.Resources>
    <Border Width="380"
            Margin="0,16,16,16"
            Padding="20"
            HorizontalAlignment="Right"
            Background="{DynamicResource RcSurfaceBrush}"
            BorderBrush="{DynamicResource RcBorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Effect="{DynamicResource RcPanelShadow}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="账户与设置"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource RcTextPrimaryBrush}" />
                    <TextBlock Margin="0,4,0,0"
                               Text="管理账户连接、通知状态和客户端更新。"
                               Foreground="{DynamicResource RcTextSecondaryBrush}"
                               FontSize="12"
                               TextWrapping="Wrap" />
                </StackPanel>
                <Button x:Name="CloseButtonElement"
                        Grid.Column="1"
                        Style="{StaticResource CloseButtonStyle}"
                        ToolTip="关闭"
                        AutomationProperties.Name="关闭账户与设置侧栏"
                        Click="OnCloseClicked">
                    <Path Data="{DynamicResource RcIconClose}"
                          Width="16"
                          Height="16"
                          Stretch="Uniform"
                          Stroke="{DynamicResource RcTextSecondaryBrush}"
                          StrokeThickness="1.6" />
                </Button>
                <Border Grid.Row="1"
                        Grid.ColumnSpan="2"
                        Margin="0,20,0,0"
                        Padding="14"
                        Background="{DynamicResource RcPrimarySoftBrush}"
                        CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="当前账户"
                                   Foreground="{DynamicResource RcTextSecondaryBrush}"
                                   FontSize="11" />
                        <TextBlock Margin="0,4,0,0"
                                   Text="{Binding DisplayName, RelativeSource={RelativeSource AncestorType={x:Type local:SettingsPanelControl}}}"
                                   Foreground="{DynamicResource RcTextPrimaryBrush}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Margin="0,4,0,0"
                                   Text="{Binding ServerAddress, RelativeSource={RelativeSource AncestorType={x:Type local:SettingsPanelControl}}}"
                                   Foreground="{DynamicResource RcTextSecondaryBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,20,0,0">
                    <TextBlock Text="连接与通知"
                               Foreground="{DynamicResource RcTextPrimaryBrush}"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,6,0,0"
                               Text="{Binding ConnectionStatus, RelativeSource={RelativeSource AncestorType={x:Type local:SettingsPanelControl}}}"
                               Foreground="{DynamicResource RcTextSecondaryBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,4,0,0"
                               Text="{Binding SyncStatus, RelativeSource={RelativeSource AncestorType={x:Type local:SettingsPanelControl}}}"
                               Foreground="{DynamicResource RcTextSecondaryBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,4,0,0"
                               Text="{Binding NotificationStatus, RelativeSource={RelativeSource AncestorType={x:Type local:SettingsPanelControl}}}"
                               Foreground="{DynamicResource RcTextSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,20,0,0">
                    <TextBlock Text="客户端"
                               Foreground="{DynamicResource RcTextPrimaryBrush}"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,6,0,0"
                               Text="{Binding UpdateStatus, RelativeSource={RelativeSource AncestorType={x:Type local:SettingsPanelControl}}}"
                               Foreground="{DynamicResource RcTextSecondaryBrush}"
                               TextWrapping="Wrap" />
                    <Button x:Name="CheckForUpdatesButtonElement"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Left"
                            Content="检查更新"
                            IsEnabled="{Binding CanCheckForUpdates, RelativeSource={RelativeSource AncestorType={x:Type local:SettingsPanelControl}}}"
                            Click="OnCheckForUpdatesClicked" />
                </StackPanel>
                <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Margin="0,20,0,0">
                    <Button x:Name="ReconnectButtonElement"
                            Content="重试连接"
                            IsEnabled="{Binding CanReconnect, RelativeSource={RelativeSource AncestorType={x:Type local:SettingsPanelControl}}}"
                            Click="OnReconnectClicked" />
                    <Button x:Name="ExitAccountButtonElement"
                            Margin="0,8,0,0"
                            Style="{StaticResource DangerButtonStyle}"
                            Content="退出账户"
                            IsEnabled="{Binding CanExitAccount, RelativeSource={RelativeSource AncestorType={x:Type local:SettingsPanelControl}}}"
                            Click="OnExitAccountClicked" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Border>
</UserControl>
