<UserControl x:Class="RelayCove.Client.Controls.ComposerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             xmlns:presentation="clr-namespace:RelayCove.Client.Presentation"
             Background="Transparent">
    <Border x:Name="ComposerSurface" Padding="14,10,14,8" Background="{DynamicResource RcSurfaceBrush}" BorderBrush="{DynamicResource RcBorderBrush}" BorderThickness="1" CornerRadius="12" Effect="{DynamicResource RcPanelShadow}">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Border x:Name="ReplyComposerPanel" Grid.ColumnSpan="4" Margin="0,0,0,6" Padding="10,5" Background="#FFF8FAFC" BorderBrush="{DynamicResource RcPrimaryBrush}" BorderThickness="3,0,0,0" CornerRadius="3" Visibility="Collapsed">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="ReplyComposerSenderText" Text="正在回复" Foreground="{DynamicResource RcTextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" /><TextBlock x:Name="ReplyComposerContentText" Margin="0,1,10,0" Foreground="{DynamicResource RcTextSecondaryBrush}" FontSize="11" MaxHeight="18" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" /></StackPanel><Button Grid.Column="1" Content="取消" MinHeight="28" Padding="8,2" VerticalAlignment="Center" Click="OnCancelReplyClicked" /></Grid>
            </Border>
            <Border x:Name="MentionPickerPanel" Grid.Row="1" Grid.ColumnSpan="4" Margin="0,0,0,7" Padding="10,8" Background="#FFF8FAFC" BorderBrush="{DynamicResource RcBorderBrush}" BorderThickness="1" CornerRadius="3" MaxHeight="190" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><DockPanel LastChildFill="True"><Button DockPanel.Dock="Right" MinHeight="26" Padding="8,1" Content="关闭" Click="OnCloseMentionPickerClicked" /><TextBlock VerticalAlignment="Center" Text="添加 @用户" FontWeight="SemiBold" Foreground="{DynamicResource RcTextPrimaryBrush}" /></DockPanel><Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="MentionSearchTextBox" MinHeight="30" Padding="7,4" MaxLength="64" AutomationProperties.Name="按用户名搜索提及候选" TextChanged="OnMentionSearchTextChanged" PreviewKeyDown="OnMentionSearchPreviewKeyDown" /><Button x:Name="MentionSearchButton" Grid.Column="1" MinWidth="68" Margin="8,0,0,0" Padding="10,3" Content="搜索" Click="OnMentionSearchClicked" /></Grid><TextBlock x:Name="MentionSearchStatusText" Margin="1,5,0,0" Text="打开后自动列出成员；输入用户名字符会即时筛选。" AutomationProperties.LiveSetting="Polite" Foreground="{DynamicResource RcTextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" /><ListBox x:Name="MentionCandidateList" Margin="0,6,0,0" MaxHeight="132" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="提及候选"><ListBox.ItemTemplate><DataTemplate><Grid Margin="2,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" /><TextBlock Text="{Binding UserName, StringFormat=@{0}}" Foreground="{DynamicResource RcTextSecondaryBrush}" /></StackPanel><Button Grid.Column="1" MinWidth="54" Margin="10,0,0,0" Padding="8,2" Content="添加" Click="OnMentionCandidateClicked" /></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock x:Name="SelectedMentionHeadingText" Margin="1,7,0,0" Text="已选 0/20" Foreground="{DynamicResource RcTextSecondaryBrush}" FontSize="11" /><ItemsControl x:Name="SelectedMentionList" Margin="0,3,0,0" AutomationProperties.Name="已选提及用户"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Margin="0,0,6,4" Padding="6,3" Background="#FFE8F1F8" CornerRadius="3"><StackPanel Orientation="Horizontal"><TextBlock Text="@" /><TextBlock Text="{Binding UserName}" /><Button Margin="5,0,0,0" MinWidth="24" Padding="3,0" Content="移除" AutomationProperties.Name="移除提及用户" Click="OnRemoveMentionClicked" /></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer>
            </Border>
            <Border x:Name="SelectedAttachmentPanel" Grid.Row="2" Grid.ColumnSpan="4" Margin="0,0,0,6" Padding="9,5" Background="#FFF8FAFC" BorderBrush="{DynamicResource RcBorderBrush}" BorderThickness="1" CornerRadius="3" MaxHeight="96" Visibility="Collapsed">
                <StackPanel><TextBlock x:Name="SelectedAttachmentHeadingText" Text="已选 0/10 个附件" AutomationProperties.LiveSetting="Polite" Foreground="{DynamicResource RcTextPrimaryBrush}" FontSize="11" FontWeight="SemiBold" /><ScrollViewer MaxHeight="62" Margin="0,4,0,0" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="SelectedAttachmentList" AutomationProperties.Name="已选附件"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Margin="0,0,5,4" Padding="6,3" Background="#FFE8F1F8" CornerRadius="5"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding DisplayName}" MaxWidth="96" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" /><Button Width="22" Height="22" Margin="4,0,0,0" MinHeight="0" Padding="0" Background="Transparent" BorderBrush="Transparent" Content="×" FontSize="16" ToolTip="移除附件" AutomationProperties.Name="移除附件" AutomationProperties.HelpText="{Binding DisplaySize}" Click="OnRemoveAttachmentClicked" /></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></StackPanel>
            </Border>
            <Border x:Name="AttachmentInputDropTarget" Grid.Row="3" Grid.ColumnSpan="4" Padding="0" Background="Transparent" BorderThickness="0" AllowDrop="True" AutomationProperties.Name="消息内容和附件输入区" AutomationProperties.HelpText="正文为空且未选择 @用户时，可拖入最多十个本地文件，或按 Ctrl+V 粘贴截图。" PreviewDragEnter="OnAttachmentInputPreviewDragEnter" PreviewDragOver="OnAttachmentInputPreviewDragOver" PreviewDragLeave="OnAttachmentInputPreviewDragLeave" PreviewDrop="OnAttachmentInputPreviewDrop" PreviewKeyDown="OnAttachmentInputPreviewKeyDown">
                <Grid><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <primitives:Thumb x:Name="ComposerResizeThumb" Height="12" Margin="0,-8,0,0" VerticalAlignment="Top" Cursor="SizeNS" Panel.ZIndex="2" ToolTip="上下拖动以调整输入框高度" AutomationProperties.Name="调整输入框高度" DragDelta="OnResizeDragDelta"><primitives:Thumb.Template><ControlTemplate TargetType="primitives:Thumb"><Grid Background="Transparent"><Border x:Name="ResizeGrip" Width="34" Height="3" Background="{DynamicResource RcBorderBrush}" CornerRadius="2" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" /></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ResizeGrip" Property="Opacity" Value="1" /></Trigger></ControlTemplate.Triggers></ControlTemplate></primitives:Thumb.Template></primitives:Thumb>
                    <TextBox x:Name="MessageComposerTextBox" Height="64" MinHeight="58" Padding="10,7" AcceptsReturn="True" IsEnabled="False" BorderThickness="0" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="消息内容" TextChanged="OnMessageTextChanged" PreviewKeyDown="OnMessagePreviewKeyDown" />
                    <Grid Grid.Row="1" Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center" Orientation="Horizontal"><Button x:Name="SelectAttachmentsButton" Width="32" MinHeight="32" Margin="0,0,5,0" Padding="7" Style="{DynamicResource ComposerIconButtonStyle}" ToolTip="选择、拖入或粘贴最多 10 个附件。" AutomationProperties.Name="选择附件" IsEnabled="False" Click="OnSelectAttachmentsClicked"><Path Data="{DynamicResource RcIconAttach}" Stretch="Uniform" Stroke="{DynamicResource RcTextSecondaryBrush}" StrokeThickness="1.6" /></Button><Button x:Name="MentionPickerButton" Width="32" MinHeight="32" Padding="7" Style="{DynamicResource ComposerIconButtonStyle}" ToolTip="提及成员" AutomationProperties.Name="提及成员" IsEnabled="False" Click="OnMentionPickerClicked"><Path Data="{DynamicResource RcIconMention}" Stretch="Uniform" Stroke="{DynamicResource RcTextSecondaryBrush}" StrokeThickness="1.6" /></Button><StackPanel x:Name="ComposerSupplementaryActionsPanel" Margin="5,0,0,0" VerticalAlignment="Center" Orientation="Horizontal"><Button Width="32" Height="32" Padding="7" Style="{DynamicResource ComposerIconButtonStyle}" Opacity="0.72" ToolTip="表情回应（暂未开放）" AutomationProperties.Name="表情回应，暂未开放" Tag="{x:Static presentation:ClientUiFeatureId.Emoji}" Click="OnUnavailableClicked"><Path Data="{DynamicResource RcIconSmile}" Stretch="Uniform" Stroke="{DynamicResource RcNeutralBrush}" StrokeThickness="1.6" /></Button><Button Width="32" Height="32" Margin="3,0,0,0" Padding="7" Style="{DynamicResource ComposerIconButtonStyle}" Opacity="0.72" ToolTip="语音输入（暂未开放）" AutomationProperties.Name="语音输入，暂未开放" Tag="{x:Static presentation:ClientUiFeatureId.VoiceInput}" Click="OnUnavailableClicked"><Path Data="{DynamicResource RcIconMicrophone}" Stretch="Uniform" Stroke="{DynamicResource RcNeutralBrush}" StrokeThickness="1.6" /></Button><Button Width="32" Height="32" Margin="3,0,0,0" Padding="7" Style="{DynamicResource ComposerIconButtonStyle}" Opacity="0.72" ToolTip="主动截图（暂未开放）" AutomationProperties.Name="主动截图，暂未开放" Tag="{x:Static presentation:ClientUiFeatureId.ScreenCapture}" Click="OnUnavailableClicked"><Path Data="{DynamicResource RcIconScissors}" Stretch="Uniform" Stroke="{DynamicResource RcNeutralBrush}" StrokeThickness="1.6" /></Button><Button Width="32" Height="32" Margin="3,0,0,0" Padding="7" Style="{DynamicResource ComposerIconButtonStyle}" Opacity="0.72" ToolTip="发送选项（暂未开放）" AutomationProperties.Name="发送选项，暂未开放" Tag="{x:Static presentation:ClientUiFeatureId.SendOptions}" Click="OnUnavailableClicked"><Path Data="{DynamicResource RcIconChevronDown}" Stretch="Uniform" Stroke="{DynamicResource RcNeutralBrush}" StrokeThickness="1.6" /></Button></StackPanel></StackPanel><Button x:Name="SendMessageButton" Grid.Column="1" MinWidth="88" MinHeight="36" Padding="16,7" Style="{DynamicResource PrimaryButtonStyle}" IsEnabled="False" Click="OnSendMessageClicked"><StackPanel Orientation="Horizontal"><Path Width="15" Height="15" Margin="0,0,6,0" Data="{DynamicResource RcIconSend}" Stretch="Uniform" Stroke="White" StrokeThickness="1.6" /><TextBlock VerticalAlignment="Center" Text="发送" /></StackPanel></Button></Grid>
                </Grid>
            </Border>
            <Grid x:Name="AttachmentUploadProgressPanel" Grid.Row="4" Grid.ColumnSpan="4" Margin="2,7,0,0" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><ProgressBar x:Name="AttachmentUploadProgressBar" Height="8" Minimum="0" Maximum="100" Value="0" VerticalAlignment="Center" AutomationProperties.Name="附件上传进度" /><TextBlock x:Name="AttachmentUploadProgressText" Grid.Column="1" Margin="10,0,0,0" Text="准备附件上传…" AutomationProperties.LiveSetting="Polite" Foreground="{DynamicResource RcTextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" /></Grid>
            <TextBlock x:Name="MessageComposerStatusText" Grid.Row="5" Grid.ColumnSpan="4" Margin="2,4,0,0" Text="选择可用会话后发送文字；正文为空时可选择附件。Ctrl+Enter 换行。" AutomationProperties.LiveSetting="Polite" Foreground="{DynamicResource RcNeutralBrush}" FontSize="10" TextWrapping="Wrap" />
        </Grid>
    </Border>
</UserControl>
