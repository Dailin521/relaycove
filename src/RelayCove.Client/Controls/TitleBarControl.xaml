<UserControl x:Class="RelayCove.Client.Controls.TitleBarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             Height="48"
             Background="{DynamicResource RcSurfaceBrush}"
             Foreground="{DynamicResource RcTextPrimaryBrush}"
             Focusable="False"
             shell:WindowChrome.IsHitTestVisibleInChrome="True"
             MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown"
             MouseRightButtonUp="OnTitleBarMouseRightButtonUp">
    <Border BorderBrush="{DynamicResource RcBorderBrush}"
            BorderThickness="0,0,0,1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <Border Width="28"
                        Height="28"
                        Background="{DynamicResource RcPrimaryBrush}"
                        CornerRadius="14">
                    <Path Width="16"
                          Height="16"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Data="{DynamicResource RcIconChat}"
                          Fill="Transparent"
                          Stretch="Uniform"
                          Stroke="White"
                          StrokeLineJoin="Round"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeThickness="1.5" />
                </Border>
                <TextBlock Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           FontFamily="{DynamicResource RcFontFamily}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Text="{Binding Title, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="MinimizeButton"
                        Width="46"
                        Height="40"
                        Padding="13"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        ToolTip="最小化"
                        AutomationProperties.Name="最小化窗口"
                        Click="OnMinimizeClicked">
                    <Path Data="{DynamicResource RcIconMinimize}"
                          Stretch="Uniform"
                          Stroke="{DynamicResource RcTextPrimaryBrush}"
                          StrokeThickness="1.5" />
                </Button>
                <Button x:Name="MaximizeRestoreButton"
                        Width="46"
                        Height="40"
                        Padding="13"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        ToolTip="最大化或还原"
                        AutomationProperties.Name="最大化或还原窗口"
                        Click="OnMaximizeRestoreClicked">
                    <Grid>
                        <Path x:Name="MaximizeIcon"
                              Data="{DynamicResource RcIconMaximize}"
                              Stretch="Uniform"
                              Stroke="{DynamicResource RcTextPrimaryBrush}"
                              StrokeThickness="1.5" />
                        <Path x:Name="RestoreIcon"
                              Data="{DynamicResource RcIconRestore}"
                              Stretch="Uniform"
                              Stroke="{DynamicResource RcTextPrimaryBrush}"
                              StrokeThickness="1.5"
                              Visibility="Collapsed" />
                    </Grid>
                </Button>
                <Button x:Name="CloseButton"
                        Width="46"
                        Height="40"
                        Padding="13"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        ToolTip="关闭"
                        AutomationProperties.Name="关闭窗口"
                        Click="OnCloseClicked">
                    <Path Data="{DynamicResource RcIconClose}"
                          Stretch="Uniform"
                          Stroke="{DynamicResource RcTextPrimaryBrush}"
                          StrokeThickness="1.5" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
