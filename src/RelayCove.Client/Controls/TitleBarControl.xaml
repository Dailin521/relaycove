<UserControl x:Class="RelayCove.Client.Controls.TitleBarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             Height="48"
             Background="{DynamicResource RcSurfaceBrush}"
             Foreground="{DynamicResource RcTextPrimaryBrush}"
             Focusable="False"
             shell:WindowChrome.IsHitTestVisibleInChrome="True"
             MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown"
             MouseRightButtonUp="OnTitleBarMouseRightButtonUp">
    <UserControl.Resources>
        <Style x:Key="TitleBarButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource RcTextSecondaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource RcFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource RcPrimarySoftBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource RcPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FFD8EAFE" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TitleBarCloseButtonStyle"
               TargetType="{x:Type Button}">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource RcTextSecondaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource RcFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="CloseButtonBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseButtonBorder" Property="Background" Value="#FFFEE4E2" />
                                <Setter Property="Foreground" Value="{DynamicResource RcDangerBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CloseButtonBorder" Property="Background" Value="#FFFECACA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Border BorderBrush="{DynamicResource RcBorderBrush}"
            BorderThickness="0,0,0,1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <Border Width="26"
                        Height="26"
                        Background="{DynamicResource RcPrimaryBrush}"
                        CornerRadius="8">
                    <Path Width="16"
                          Height="16"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Data="{DynamicResource RcIconChat}"
                          Fill="Transparent"
                          Stretch="Uniform"
                          Stroke="White"
                          StrokeLineJoin="Round"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeThickness="1.5" />
                </Border>
                <TextBlock Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           FontFamily="{DynamicResource RcFontFamily}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Text="{Binding Title, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="MinimizeButton"
                        Style="{StaticResource TitleBarButtonStyle}"
                        ToolTip="最小化"
                        AutomationProperties.Name="最小化窗口"
                        Click="OnMinimizeClicked">
                    <Path Data="{DynamicResource RcIconMinimize}"
                          Stretch="Uniform"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                          StrokeThickness="1.5" />
                </Button>
                <Button x:Name="MaximizeRestoreButton"
                        Style="{StaticResource TitleBarButtonStyle}"
                        ToolTip="最大化或还原"
                        AutomationProperties.Name="最大化或还原窗口"
                        Click="OnMaximizeRestoreClicked">
                    <Grid>
                        <Path x:Name="MaximizeIcon"
                              Data="{DynamicResource RcIconMaximize}"
                              Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                              StrokeThickness="1.5" />
                        <Path x:Name="RestoreIcon"
                              Data="{DynamicResource RcIconRestore}"
                              Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                              StrokeThickness="1.5"
                              Visibility="Collapsed" />
                    </Grid>
                </Button>
                <Button x:Name="CloseButton"
                        Style="{StaticResource TitleBarCloseButtonStyle}"
                        ToolTip="关闭"
                        AutomationProperties.Name="关闭窗口"
                        Click="OnCloseClicked">
                    <Path Data="{DynamicResource RcIconClose}"
                          Stretch="Uniform"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                          StrokeThickness="1.5" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
