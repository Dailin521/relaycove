<UserControl x:Class="RelayCove.Client.Controls.MessageListControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Loaded="OnControlLoaded">
    <UserControl.Resources>
        <Style x:Key="MessageActionButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="42" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource RcTextSecondaryBrush}" />
        </Style>
        <Style x:Key="MessageRetryButtonStyle" TargetType="Button" BasedOn="{StaticResource MessageActionButtonStyle}">
            <Setter Property="Foreground" Value="{DynamicResource RcDangerBrush}" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <ListBox x:Name="MessageList" AutomationProperties.Name="消息列表" Background="Transparent" BorderThickness="0"
                 ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.ScrollChanged="OnScrollChanged"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel VerticalAlignment="Bottom" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" /><Setter Property="Focusable" Value="False" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /></Trigger></Style.Triggers></Style></ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <Border Margin="0,4,0,5" Padding="9,3" HorizontalAlignment="Center" Background="#FFE9EEF4" CornerRadius="9">
                            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding ShowDateSeparator}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                            <TextBlock Text="{Binding DateSeparatorLabel}" Foreground="{DynamicResource RcTextSecondaryBrush}" FontSize="11" />
                        </Border>
                        <Grid Margin="0,5,0,6" AutomationProperties.Name="新消息分割线">
                            <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding ShowNewMessageSeparator}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Grid.Style>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Height="1" VerticalAlignment="Center" Background="#FFCE6871" /><TextBlock Grid.Column="1" Margin="10,0" Text="新消息" Foreground="#FFB84F5A" FontSize="11" FontWeight="SemiBold" /><Border Grid.Column="2" Height="1" VerticalAlignment="Center" Background="#FFCE6871" />
                        </Grid>
                        <Border x:Name="MessageCardBorder" MaxWidth="680" Padding="10,5" Tag="MessageCard" BorderThickness="0" CornerRadius="12" Loaded="OnCardLoaded" Unloaded="OnCardUnloaded" DataContextChanged="OnCardDataContextChanged">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#FFF3F6F9" />
                                    <Setter Property="HorizontalAlignment" Value="Left" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOwnMessage}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource RcPrimarySoftBrush}" />
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid><Grid.Style><Style TargetType="Grid"><Setter Property="FlowDirection" Value="LeftToRight" /><Style.Triggers><DataTrigger Binding="{Binding IsOwnMessage}" Value="True"><Setter Property="FlowDirection" Value="RightToLeft" /></DataTrigger></Style.Triggers></Style></Grid.Style><Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Width="30" Height="30" VerticalAlignment="Top" Background="{DynamicResource RcPrimarySoftBrush}" CornerRadius="15"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding IsMergedWithPrevious}" Value="True"><Setter Property="Visibility" Value="Hidden" /></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding SenderLabel, TargetNullValue=?}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource RcPrimaryBrush}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /></Border>
                                <StackPanel Grid.Column="1" FlowDirection="LeftToRight">
                                    <Grid><Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding IsMergedWithPrevious}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Grid.Style><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding SenderLabel}" Foreground="{DynamicResource RcTextPrimaryBrush}" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="{Binding Timestamp}" Foreground="{DynamicResource RcTextSecondaryBrush}" FontSize="11" /></Grid>
                                    <TextBlock Text="{Binding Content}" Margin="0,3,0,0" Foreground="{DynamicResource RcTextPrimaryBrush}" FontSize="14" TextWrapping="Wrap" />
                                    <ItemsControl ItemsSource="{Binding Attachments}" Margin="0,8,0,0">
                                        <ItemsControl.Style><Style TargetType="ItemsControl"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasAttachments}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></ItemsControl.Style>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <Border Padding="9,7" Margin="0,0,0,6" Background="#FFF8FAFC" BorderBrush="{DynamicResource RcBorderBrush}" BorderThickness="1" CornerRadius="8">
                                                        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding IsImage}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding DisplayName}" MaxWidth="420" Foreground="{DynamicResource RcTextPrimaryBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding DisplaySize}" Margin="0,2,0,0" Foreground="{DynamicResource RcTextSecondaryBrush}" FontSize="11" /><TextBlock Margin="0,5,0,0" Text="{Binding DownloadState.StatusText}" AutomationProperties.LiveSetting="Polite" Foreground="{DynamicResource RcTextSecondaryBrush}" FontSize="11" /><ProgressBar Height="4" Margin="0,5,0,0" Minimum="0" Maximum="100" Value="{Binding DownloadState.Percent, Mode=OneWay}" AutomationProperties.Name="附件下载进度"><ProgressBar.Style><Style TargetType="ProgressBar"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding DownloadState.ShowProgress}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></ProgressBar.Style></ProgressBar></StackPanel><StackPanel Grid.Column="1" Margin="12,0,0,0" Orientation="Horizontal"><Button Margin="0,0,6,0" Padding="9,3" Content="打开" IsEnabled="{Binding DownloadState.CanOpen}" Click="OnAttachmentOpenClicked" /><Button Padding="9,3" Content="{Binding DownloadState.ActionLabel}" IsEnabled="{Binding DownloadState.CanInvoke}" AutomationProperties.Name="{Binding DownloadState.AutomationName}" Click="OnAttachmentDownloadClicked" /></StackPanel></Grid>
                                                    </Border>
                                                    <Border Margin="0,0,0,6" Padding="0" MaxWidth="360" MaxHeight="280" HorizontalAlignment="Left" Background="{DynamicResource RcPrimarySoftBrush}" BorderBrush="#FFD5E1EE" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                                                        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsImage}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                                        <Grid><Button Padding="0" Background="Transparent" BorderThickness="0" Content="查看图片" ToolTip="点击查看图片" IsEnabled="{Binding ImageState.CanView}" AutomationProperties.Name="{Binding ImageState.AutomationName}" Click="OnImageViewClicked"><Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><Image Source="{Binding ImageState.Thumbnail}" MaxWidth="360" MaxHeight="280" Stretch="Uniform" Loaded="OnThumbnailLoaded" Unloaded="OnThumbnailUnloaded" DataContextChanged="OnThumbnailDataContextChanged" AutomationProperties.Name="{Binding ImageState.AutomationName}" /></Border></ControlTemplate></Button.Template></Button><Border HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="260" Padding="10,5" Background="#EAF3FF" BorderBrush="#FFD5E1EE" BorderThickness="1" CornerRadius="12" IsHitTestVisible="False"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding ImageState.Thumbnail}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding ImageState.StatusText}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource RcTextSecondaryBrush}" FontSize="11" AutomationProperties.LiveSetting="Polite" /></Border></Grid>
                                                    </Border>
                                                    <Grid Margin="0,5,0,6" MinWidth="160" MaxWidth="360">
                                                        <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsImage}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Grid.Style>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock MaxWidth="260" Text="{Binding DisplayName}" Foreground="{DynamicResource RcTextSecondaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis" /><TextBlock Margin="6,0,0,0" Text="{Binding DisplaySize}" Foreground="#FF98A2B3" FontSize="11" /></StackPanel>
                                                        <Button Grid.Column="1" Padding="6,1" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource RcPrimaryBrush}" FontSize="11" Content="查看图片" ToolTip="在图片查看器中打开" IsEnabled="{Binding ImageState.CanView}" AutomationProperties.Name="{Binding ImageState.AutomationName}" Click="OnImageViewClicked" />
                                                    </Grid>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl ItemsSource="{Binding Links}" Margin="0,6,0,0">
                                        <ItemsControl.Style><Style TargetType="ItemsControl"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasLinks}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></ItemsControl.Style>
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button MinHeight="0" MaxWidth="420" Margin="0,0,8,3" Padding="0" HorizontalContentAlignment="Left" AutomationProperties.Name="{Binding DisplayText}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource RcPrimaryBrush}" Click="OnLinkClicked">
                                                    <TextBlock Text="{Binding DisplayText}" MaxHeight="34" TextDecorations="Underline" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button MaxWidth="520" Margin="0,7,0,0" MinHeight="0" Padding="0" HorizontalAlignment="Left" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Tag="{Binding ReplyToMessageId}" ToolTip="定位被回复的消息" Click="OnReplyReferenceClicked">
                                        <Button.Style><Style TargetType="Button"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasReply}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Button.Style>
                                        <Border Padding="9,6" Background="#FFF8FAFC" BorderBrush="{DynamicResource RcPrimaryBrush}" BorderThickness="3,0,0,0" CornerRadius="6">
                                            <StackPanel>
                                                <TextBlock Text="{Binding ReplySenderLabel}" Foreground="{DynamicResource RcTextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding ReplyContent}" Margin="0,2,0,0" Foreground="{DynamicResource RcTextSecondaryBrush}" FontSize="11" MaxHeight="34" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                    <Border x:Name="MessageActionBar" Margin="0,5,0,0" Padding="3,1" HorizontalAlignment="Right" Background="{DynamicResource RcSurfaceBrush}" BorderBrush="{DynamicResource RcBorderBrush}" BorderThickness="1" CornerRadius="7">
                                        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsMouseOver, ElementName=MessageCardBorder}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger><DataTrigger Binding="{Binding CanRetry}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                            <TextBlock Text="{Binding SendStatusLabel}" Margin="4,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource RcTextSecondaryBrush}" FontSize="10" />
                                            <Button Content="复制" Margin="0,0,6,0" Click="OnCopyClicked"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource MessageActionButtonStyle}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding CanCopy}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                                            <Button Content="回复" Margin="0,0,6,0" Tag="{Binding ServerMessageId}" Click="OnReplyClicked"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource MessageActionButtonStyle}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding CanReply}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                                            <Button Content="重试" Tag="{Binding ClientMessageId}" Click="OnRetryClicked"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource MessageRetryButtonStyle}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding CanRetry}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="MessageEmptyText" Margin="28" Text="请选择会话" AutomationProperties.LiveSetting="Polite" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource RcTextSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" />
        <Button x:Name="NewMessageIndicatorButton" Content="有新消息，回到最新" Margin="0,0,16,14" Padding="14,6" HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="Collapsed" Click="OnNewMessagesClicked" />
        <ProgressBar x:Name="MessageLoadingBar" Height="3" VerticalAlignment="Top" AutomationProperties.Name="消息加载中" IsIndeterminate="True" Visibility="Collapsed" />
    </Grid>
</UserControl>
