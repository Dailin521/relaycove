<UserControl x:Class="RelayCove.Client.Controls.ConversationPanelControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource RcSurfaceBrush}"
             BorderBrush="{DynamicResource RcBorderBrush}"
             BorderThickness="1">
    <Border Padding="8,10,10,8"
            Background="{Binding Background, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
            BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
            BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
            CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Margin="8,8,8,7">
                <Border Background="{DynamicResource RcSurfaceBrush}"
                        BorderBrush="{DynamicResource RcBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <Grid>
                        <Path Width="17" Height="17" Margin="12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                              Data="{DynamicResource RcIconSearch}" Stretch="Uniform" Stroke="{DynamicResource RcTextSecondaryBrush}" StrokeThickness="1.6" IsHitTestVisible="False" />
                        <TextBox x:Name="ConversationSearchTextBox" MinHeight="42" Padding="38,7,66,7" Background="Transparent" BorderThickness="0"
                                 AutomationProperties.Name="搜索会话" ToolTip="按会话名称或消息预览筛选。Ctrl+K 聚焦。" TextChanged="OnSearchTextChanged" />
                        <TextBlock Margin="39,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{DynamicResource RcTextSecondaryBrush}"
                                   FontSize="13" IsHitTestVisible="False" Text="搜索会话">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=ConversationSearchTextBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Border Margin="0,0,9,0" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#FFF5F7FA" CornerRadius="5" IsHitTestVisible="False">
                            <TextBlock Text="Ctrl K" Foreground="{DynamicResource RcTextSecondaryBrush}" FontSize="10" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>
            <UniformGrid Grid.Row="1" Margin="8,5,8,6" Columns="4">
                <Button x:Name="AllConversationFilterButton" Margin="0,0,4,0" Style="{DynamicResource ConversationFilterButtonStyle}" Content="全部" Tag="All" Click="OnFilterClicked" />
                <Button x:Name="UnreadConversationFilterButton" Margin="0,0,4,0" Style="{DynamicResource ConversationFilterButtonStyle}" Content="未读" Tag="Unread" Click="OnFilterClicked" />
                <Button x:Name="ChannelConversationFilterButton" Margin="0,0,4,0" Style="{DynamicResource ConversationFilterButtonStyle}" Content="频道" Tag="Channels" Click="OnFilterClicked" />
                <Button x:Name="DirectConversationFilterButton" Style="{DynamicResource ConversationFilterButtonStyle}" Content="私聊" Tag="Direct" Click="OnFilterClicked" />
            </UniformGrid>
            <Grid Grid.Row="2">
                <ListBox x:Name="ConversationList" AutomationProperties.Name="会话列表" Background="Transparent" BorderThickness="0"
                         ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                         VirtualizingPanel.VirtualizationMode="Recycling" SelectionChanged="OnSelectionChanged">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="{x:Type GroupItem}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type GroupItem}">
                                                <Expander Tag="{Binding Name}" IsExpanded="True" BorderThickness="0"
                                                          Loaded="OnGroupLoaded" Expanded="OnGroupExpanded" Collapsed="OnGroupCollapsed">
                                                    <Expander.Header>
                                                        <ContentPresenter Content="{Binding}" ContentTemplate="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=HeaderTemplate}" />
                                                    </Expander.Header>
                                                    <ItemsPresenter />
                                                </Expander>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <Grid Margin="6,12,4,5">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource RcTextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" />
                                        <Button Grid.Column="1" Width="24" Height="24" MinHeight="0" Padding="0" Content="+" FontSize="16" ToolTip="创建频道"
                                                AutomationProperties.Name="创建频道" Click="OnCreateChannelClicked">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{DynamicResource SubtleButtonStyle}">
                                                    <Style.Triggers><DataTrigger Binding="{Binding Name}" Value="私聊"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,2" />
                            <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#FFF5F6F8" /></Trigger>
                                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource RcPrimarySoftBrush}" /><Setter Property="Foreground" Value="{DynamicResource RcPrimaryBrush}" /></Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="9,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Border Width="26" Height="26" VerticalAlignment="Top" Background="{DynamicResource RcPrimarySoftBrush}" CornerRadius="13"><TextBlock Text="{Binding TypeIcon}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource RcPrimaryBrush}" FontWeight="SemiBold" /></Border>
                                <StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="{Binding Name}" Foreground="{DynamicResource RcTextPrimaryBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Preview}" Margin="0,2,0,0" Foreground="{DynamicResource RcTextSecondaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding MutedLabel}" Margin="0,2,0,0" Foreground="{DynamicResource RcTextSecondaryBrush}" FontSize="11" /></StackPanel>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Right"><TextBlock Text="{Binding Timestamp}" Foreground="{DynamicResource RcTextSecondaryBrush}" FontSize="10" /><Border Margin="0,4,0,0" Padding="6,2" HorizontalAlignment="Right" Background="{DynamicResource RcPrimaryBrush}" CornerRadius="8"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding HasUnread}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding UnreadText}" Foreground="White" FontSize="10" FontWeight="SemiBold" /></Border></StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="ConversationEmptyText" Margin="18" Text="正在读取账户会话…" AutomationProperties.LiveSetting="Polite" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource RcTextSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" />
                <Border x:Name="DirectContactsPanel" Padding="8,7" Background="{DynamicResource RcSurfaceBrush}" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <StackPanel Margin="3,2,3,7"><TextBlock Text="所有成员" Foreground="{DynamicResource RcTextPrimaryBrush}" FontWeight="SemiBold" /><TextBlock x:Name="DirectContactsStatusText" Margin="0,2,0,0" Text="选择成员即可开始私聊。" AutomationProperties.LiveSetting="Polite" Foreground="{DynamicResource RcTextSecondaryBrush}" FontSize="11" /></StackPanel>
                        <ListBox x:Name="DirectContactsList" Grid.Row="1" AutomationProperties.Name="所有成员，选择后开始私聊" Background="Transparent" BorderThickness="0" SelectionChanged="OnDirectContactSelectionChanged"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,2" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Background" Value="Transparent" /><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#FFF5F7FA" /></Trigger></Style.Triggers></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Grid Margin="7,6"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Width="28" Height="28" Background="{DynamicResource RcPrimarySoftBrush}" CornerRadius="14"><TextBlock Text="●" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource RcPrimaryBrush}" FontSize="9" /></Border><StackPanel Grid.Column="1" Margin="7,0,0,0"><TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource RcTextPrimaryBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding UserName, StringFormat=@{0}}" Foreground="{DynamicResource RcTextSecondaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis" /></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
                    </Grid>
                </Border>
            </Grid>
            <Border Grid.Row="3" Margin="4,10,4,0" Padding="8,9,8,6" BorderBrush="{DynamicResource RcBorderBrush}" BorderThickness="0,1,0,0">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Border Width="28" Height="28" Background="{DynamicResource RcPrimarySoftBrush}" CornerRadius="14"><TextBlock Text="●" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource RcPrimaryBrush}" FontSize="10" /></Border>
                    <StackPanel Grid.Column="1" Margin="7,0,4,0"><TextBlock x:Name="SidebarDisplayNameText" Text="尚未登录" Foreground="{DynamicResource RcTextPrimaryBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock x:Name="SidebarConnectionText" Text="实时连接：未连接" Foreground="{DynamicResource RcTextSecondaryBrush}" FontSize="10" TextTrimming="CharacterEllipsis" /></StackPanel>
                    <Button Grid.Column="2" MinWidth="48" MinHeight="30" Padding="8,4" Background="Transparent" BorderBrush="Transparent" Content="设置" ToolTip="打开账户与设置" AutomationProperties.Name="打开账户与设置" Click="OnSettingsClicked" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
