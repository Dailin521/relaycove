<UserControl x:Class="RelayCove.Client.Controls.NavigationRailControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:presentation="clr-namespace:RelayCove.Client.Presentation"
             Background="{DynamicResource RcSurfaceBrush}"
             Foreground="{DynamicResource RcTextSecondaryBrush}">
    <UserControl.Resources>
        <Style x:Key="RailButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource RcTextSecondaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource RcFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource RcPrimarySoftBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource RcPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FFD8EAFE" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource RcPrimarySoftBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource RcPrimaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="UnavailableRailButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource RailButtonStyle}">
            <Setter Property="Opacity" Value="0.68" />
        </Style>
        <Style x:Key="AccountButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource RcPrimarySoftBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource RcFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="AccountBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="AccountBorder" Property="Background" Value="#FFD8EAFE" />
                                <Setter TargetName="AccountBorder" Property="BorderBrush" Value="{DynamicResource RcPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="AccountBorder" Property="Background" Value="#FFC7E1FC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Border BorderBrush="{DynamicResource RcBorderBrush}"
            BorderThickness="0,0,1,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Button x:Name="AccountButton"
                    Margin="0,14,0,8"
                    Style="{StaticResource AccountButtonStyle}"
                    HorizontalAlignment="Center"
                    ToolTip="账户与设置"
                    AutomationProperties.Name="打开账户与设置"
                    Click="OnAccountClicked">
                <Grid>
                    <Border Width="30"
                            Height="30"
                            Background="{DynamicResource RcPrimaryBrush}"
                            CornerRadius="4" />
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="White"
                               FontWeight="SemiBold"
                               Text="{Binding AvatarText, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
                </Grid>
            </Button>
            <StackPanel Grid.Row="1" HorizontalAlignment="Center">
                <Button x:Name="ChatButton"
                        Style="{StaticResource RailButtonStyle}"
                        ToolTip="聊天"
                        AutomationProperties.Name="聊天"
                        Tag="{x:Static presentation:ClientNavigationSection.Chat}"
                        Click="OnNavigationClicked">
                    <Path Data="{DynamicResource RcIconChat}" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="1.5" />
                </Button>
                <Button x:Name="ContactsButton"
                        Style="{StaticResource UnavailableRailButtonStyle}"
                        ToolTip="联系人（暂未开放）"
                        AutomationProperties.Name="联系人，暂未开放"
                        Tag="{x:Static presentation:ClientUiFeatureId.Contacts}"
                        Click="OnUnavailableClicked">
                    <Path Data="{DynamicResource RcIconContacts}" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="1.5" />
                </Button>
                <Button x:Name="ChannelsButton"
                        Style="{StaticResource RailButtonStyle}"
                        ToolTip="频道"
                        AutomationProperties.Name="频道"
                        Tag="{x:Static presentation:ClientNavigationSection.Channels}"
                        Click="OnNavigationClicked">
                    <Path Data="{DynamicResource RcIconChannels}" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="1.5" />
                </Button>
                <Button x:Name="NotificationsButton"
                        Style="{StaticResource UnavailableRailButtonStyle}"
                        ToolTip="通知中心（暂未开放）"
                        AutomationProperties.Name="通知中心，暂未开放"
                        Tag="{x:Static presentation:ClientUiFeatureId.NotificationCenter}"
                        Click="OnUnavailableClicked">
                    <Path Data="{DynamicResource RcIconBell}" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="1.5" />
                </Button>
                <Button x:Name="FilesButton"
                        Style="{StaticResource UnavailableRailButtonStyle}"
                        ToolTip="文件中心（暂未开放）"
                        AutomationProperties.Name="文件中心，暂未开放"
                        Tag="{x:Static presentation:ClientUiFeatureId.FileCenter}"
                        Click="OnUnavailableClicked">
                    <Path Data="{DynamicResource RcIconFolder}" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="1.5" />
                </Button>
            </StackPanel>
            <StackPanel Grid.Row="2" Margin="0,0,0,12" HorizontalAlignment="Center">
                <Button x:Name="SettingsButton"
                        Style="{StaticResource RailButtonStyle}"
                        ToolTip="设置"
                        AutomationProperties.Name="设置"
                        Tag="{x:Static presentation:ClientNavigationSection.Settings}"
                        Click="OnNavigationClicked">
                    <Path Data="{DynamicResource RcIconSettings}" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="1.5" />
                </Button>
                <Button x:Name="MoreButton"
                        Style="{StaticResource UnavailableRailButtonStyle}"
                        ToolTip="更多（暂未开放）"
                        AutomationProperties.Name="更多，暂未开放"
                        Tag="{x:Static presentation:ClientUiFeatureId.MoreNavigation}"
                        Click="OnUnavailableClicked">
                    <Path Data="{DynamicResource RcIconMore}" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
